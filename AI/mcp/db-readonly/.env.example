# Copy to .env on each machine (.env is gitignored), then run `npm install` in this folder.

# --- MAIN (tool: query) — db.myautocall.net, SQL login with db_datareader + db_denydatawriter --------------------
# Логин заводится скриптом DataBase/create readonly login.sql. Windows-аутентификация не подходит: подключение не из домена.
DB_TRUSTED=false
DB_SERVER=db.myautocall.net
DB_NAME=autocall
DB_USER=
DB_PASSWORD=

# Локальный SQL Server с Windows-аутентификацией вместо боевого (named instance, без логина и TCP-порта):
#DB_TRUSTED=true
#DB_SERVER=(local)\SQLEXPRESS
#DB_NAME=
#DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# --- SECOND server (tool: query_remote) ------------------------------------------------------------------------------
# Необязательный блок: без REMOTE_DB_SERVER инструмент query_remote не регистрируется вовсе.

#REMOTE_DB_SERVER=
#REMOTE_DB_NAME=
#REMOTE_DB_USER=
#REMOTE_DB_PASSWORD=
# encrypt по умолчанию включён; false — только если на сервере нет валидного сертификата
#REMOTE_DB_ENCRYPT=true
#REMOTE_DB_TIMEOUT=15000
#REMOTE_DB_REQUEST_TIMEOUT=60000
