<telerik:RadDateTimePicker
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" 
    x:Class="AutoCall.WPF.UserControls.RadRangeDateTimePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:AutoCall.WPF.UserControls"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800">
    <telerik:RadDateTimePicker.Resources>
        <local:DateTemplateSelector x:Key="DateTemplateSelector">
            <local:DateTemplateSelector.DefaultTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" />
                </DataTemplate>
            </local:DateTemplateSelector.DefaultTemplate>
        </local:DateTemplateSelector>
    </telerik:RadDateTimePicker.Resources>
    <telerik:RadDateTimePicker.CalendarStyle>
        <Style TargetType="telerik:RadCalendar">
            <Setter Property="DayTemplateSelector" Value="{StaticResource DateTemplateSelector}"/>
        </Style>
    </telerik:RadDateTimePicker.CalendarStyle>
</telerik:RadDateTimePicker>
