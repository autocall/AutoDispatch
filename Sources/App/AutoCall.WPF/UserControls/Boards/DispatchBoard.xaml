                            <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                                <Setter Property="Foreground" Value="{Binding Load.PalletType, Converter={StaticResource palletTypeToBrushConverter}, ConverterParameter={x:Static dispatch:PalletTypeConverterParameter.Foreground}}"/>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <uc:SumDataColumn x:Name="r06" Width="35" Header="Spots" ColumnGroupName="Load" IsReadOnly="False" IsVisible="False"
