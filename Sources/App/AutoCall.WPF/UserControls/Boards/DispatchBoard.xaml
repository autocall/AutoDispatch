                    <telerik:GridViewDataColumn Width="140" Header="Origin Address" ColumnGroupName="Load" UniqueName="Load.OriginAddress"
                          DataMemberBinding="{Binding OriginAddress}" />
                    <telerik:GridViewDataColumn Width="140" Header="Destination" ColumnGroupName="Load" UniqueName="Load.DestinationCity"
                          DataMemberBinding="{Binding DestinationCity}"/>
                    <telerik:GridViewDataColumn Width="140" Header="Destination Address" ColumnGroupName="Load" UniqueName="Load.DestinationAddress"
