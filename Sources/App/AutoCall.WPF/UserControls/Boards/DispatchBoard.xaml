                            <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                                <Setter Property="Background" Value="{Binding Load.ConsolidationBackground}"/>
                                <Setter Property="Foreground" Value="{Binding Load.ConsolidationForeground}"/>
                                <Setter Property="ToolTipService.IsEnabled" Value="{Binding Load.ConsolidationText, Converter={StaticResource NotEmptyStringToBoolConverter}}"/>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                        <telerik:GridViewDataColumn.ToolTipTemplate>
                            <DataTemplate>
                                <Grid>
                                    <telerik:XamlDataProvider x:Name="xamlDataProvider"
                                    Xaml="{Binding Load.Consolidation, Mode=OneWay}"
                                    RichTextBox="{Binding ElementName=richTextBox}"
                                    SetupDocument="{x:Static helpers:UIElementHelper.XamlDataProvider_OnSetupDocument}"/>
                                    <telerik:RadRichTextBox x:Name="richTextBox" />
                                </Grid>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.ToolTipTemplate>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn Width="55" Header="Pro#" ColumnGroupName="Load"
                          DataMemberBinding="{Binding Load.RecordId}" />
