                            <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                                <Setter Property="Background" Value="{Binding Load.Comment1Background}"/>
                                <Setter Property="Foreground" Value="{Binding Load.Comment1Foreground}"/>
                                <Setter Property="ToolTipService.IsEnabled" Value="{Binding Load.Comment1Text, Converter={StaticResource NotEmptyStringToBoolConverter}}"/>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                        <telerik:GridViewDataColumn.ToolTipTemplate>
                            <DataTemplate>
                                <Grid>
                                    <telerik:XamlDataProvider x:Name="xamlDataProvider"
                                  Xaml="{Binding Load.Comments, Mode=OneWay}"
                                  RichTextBox="{Binding ElementName=richTextBox}"
                                  SetupDocument="{x:Static helpers:UIElementHelper.XamlDataProvider_OnSetupDocument}"/>
                                    <telerik:RadRichTextBox x:Name="richTextBox" />
                                </Grid>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.ToolTipTemplate>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn Width="150" ColumnGroupName="Load" Name="rComment2Col"
                          DataMemberBinding="{Binding Load.Comment2Text}">
