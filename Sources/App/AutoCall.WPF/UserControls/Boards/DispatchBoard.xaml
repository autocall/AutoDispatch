                            <DataTemplate>
                                <ComboBox
                                    ItemsSource="{Binding Path=Data.CustomStatuses, Source={StaticResource proxy}}"
                                    SelectedValue="{Binding Load.CustomStatusId, Mode=TwoWay}"
                                    SelectedValuePath="Key" DisplayMemberPath="Value">
                                </ComboBox>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellEditTemplate>
                    </telerik:GridViewDataColumn>
