                            <DataTemplate>
                                <telerik:RadDatePicker SelectedValue="{Binding Load.QuikPay, Mode=TwoWay}"/>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellEditTemplate>
                    </telerik:GridViewDataColumn>
