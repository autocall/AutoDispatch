                    <telerik:GridViewDataColumn Name="gridLoads_DatRate" Width="55" Header="DAT Rate" ColumnGroupName="Load"
                          DataMemberBinding="{Binding Load.DatRate, StringFormat=C2}"/>
                    <uc:SumDataColumn x:Name="r05" Width="55" Header="Rate" ColumnGroupName="Rate"
                          DataMemberBinding="{Binding Load.Rate, StringFormat=C2}"/>
