                    <telerik:GridViewDataColumn Width="40" Header="Length" ColumnGroupName="Load"
                          DataMemberBinding="{Binding Load.Length}"></telerik:GridViewDataColumn>
                    <uc:SumDataColumn Width="35" Header="Pallets" ColumnGroupName="Load"
                          DataMemberBinding="{Binding Load.Pallets}"/>
