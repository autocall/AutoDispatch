                                SelectedValue="{Binding Load.Status, Mode=TwoWay}"
                                SelectedValuePath="Key" DisplayMemberPath="Value">
                                </ComboBox>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellEditTemplate>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn Width="70" Header="Custom Status" IsReadOnly="False" ColumnGroupName="Load"
                        IsResizable="False" extensions:PropertyExtensions.RelativeDisplayIndex="6"
