                          DataMemberBinding="{Binding Pickup}" SortMemberPath="Load.PickupDate"/>
                    <telerik:GridViewDataColumn Width="125" Header="Delivery" ColumnGroupName="Load" UniqueName="Load.Delivery"
                          DataMemberBinding="{Binding Delivery}" SortMemberPath="Load.DeliveryDate"/>
