                            <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                                <Setter Property="Background" Value="{Binding Load.Comment2Background}"/>
                                <Setter Property="Foreground" Value="{Binding Load.Comment2Foreground}"/>
                                <Setter Property="ToolTipService.IsEnabled" Value="{Binding Load.Comment2Text, Converter={StaticResource NotEmptyStringToBoolConverter}}"/>
                            </Style>
