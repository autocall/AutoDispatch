                    <telerik:GridViewDataColumn x:Name="r07" Width="50" Header="Commodity" ColumnGroupName="Load" IsReadOnly="False" IsVisible="False"
                          DataMemberBinding="{Binding Load.Commodity}">
                    </telerik:GridViewDataColumn>
                    <uc:SumDataColumn x:Name="r04" Width="55" Header="Line Haul" ColumnGroupName="Load" IsReadOnly="False"
