<ucBoards:DispatchBoardBase
    x:Class="AutoCall.WPF.UserControls.Boards.DispatchBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:c="clr-namespace:AutoCall.WPF.Converters"
    xmlns:uc="clr-namespace:AutoCall.WPF.UserControls"
    xmlns:core="clr-namespace:AutoCall.WPF.Core"
    xmlns:ucBoards="clr-namespace:AutoCall.WPF.UserControls.Boards"
    xmlns:enums="clr-namespace:AutoDispatch.Dtos.Enums;assembly=AutoDispatch.Dtos"
    xmlns:dispatch="clr-namespace:AutoCall.WPF.Converters.Dispatch"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    xmlns:helpers="clr-namespace:AutoCall.WPF.Helpers"
    xmlns:userControls="clr-namespace:AutoCall.WPF.Dialogs.Dispatch.UserControls"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:AutoCall.WPF.Behaviors"
    xmlns:extensions="clr-namespace:AutoCall.WPF.Extensions"
    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:styleselector="clr-namespace:AutoCall.WPF.StyleSelector"
    mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300">
    <!--<ucBoards:DispatchBoardBase.CommandBindings>
        <CommandBinding Command="asd" Executed="WindowBinding_Executed"  />
    </ucBoards:DispatchBoardBase.CommandBindings>-->
    <ucBoards:Board.Resources>
        <!--Converters-->
        <!-- Use in codebehind -->
        <c:ToStringConverter x:Key="ToStringConverter" />
        <c:CompareConverter x:Key="CompareConverter" Inverted="True"/>
        <c:AnyToBooleanConverter x:Key="AnyToBooleanConverter"/>
        <c:AnyToVisibilityConverter x:Key="AnyToVisibilityConverter" />
        <c:InverseBooleanConverter x:Key="InvertedBooleanConverter" />
        <c:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
        <c:EnumToKeyValuesConverter x:Key="EnumToKeyValuesConverter" />
        <c:ExpirationConverter x:Key="ExpirationConverter"/>
        <c:NotEmptyStringToBoolConverter x:Key="NotEmptyStringToBoolConverter" />
        <c:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
        <c:NotNullToVisibilityConverter x:Key="NullToVisibilityConverter" Invert="True"/>
        <c:NotNullToBoolConverter x:Key="ObjectToBoolConverter" />
        <c:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <c:BooleanToStringConverter x:Key="BooleanToLateConverter" TrueString="Yes" FalseString=""/>
        <dispatch:DispatchBoard_AnyChildrenConverter x:Key="AnyChildrenConverter"/>
        <dispatch:EditLoadDialog_PalletTypeToBrushConverter x:Key="palletTypeToBrushConverter"/>
        <dispatch:BookLoadDialog_BorderTypeToVisibilityConverter x:Key="BorderTypeToVisibilityConverter"/>
        <dispatch:DispatchBrokerBoard_InsuranceStateConverter x:Key="InsuranceStateConverter" />
        <dispatch:DispatchBoard_FormattedAddressToCityConverter x:Key="FormattedAddressToCityConverter" />
        <dispatch:TemperatureToColorConverter x:Key="TemperatureToColorConverter"/>
        <dispatch:DispatchBoard_CustomStatusIdToNameConverter x:Key="CustomStatusIdToNameConverter"/>
        <c:InvertableBooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- red for subloads -->
        <dispatch:DispatchBoard_BoardToCommentNameConverter x:Key="BoardToComment1NameConverter" Type="Comment1" />
        <dispatch:DispatchBoard_BoardToCommentNameConverter x:Key="BoardToComment2NameConverter" Type="Comment2" />
        <dispatch:DispatchBoard_BoardToCommentNameConverter x:Key="BoardToConsolidationNameConverter" Type="Consolidation" />
        <!-- Proxy -->
        <core:BindingProxy x:Key="proxy" Data="{Binding}"/>
        <core:BindingProxy x:Key="sProxy" Data="{Binding SelectedItemsModel, RelativeSource={RelativeSource AncestorType={x:Type ucBoards:Board}, Mode=FindAncestor}}"/>
        <core:BindingProxy x:Key="rootProxy" Data="{Binding RelativeSource={RelativeSource AncestorType={x:Type ucBoards:Board}, Mode=FindAncestor}}"/>
        <!--Loads collection source-->
        <!-- Use in codebehind -->
        <CollectionViewSource x:Key="PatternsViewSource" Source="{Binding Wrappers}" IsLiveFilteringRequested="True" Filter="PatternsViewSource_OnFilter">
            <CollectionViewSource.LiveFilteringProperties>
                <system:String>DatCompany</system:String>
                <system:String>DatDriver</system:String>
                <system:String>Driver</system:String>
                <system:String>Truck</system:String>
                <system:String>Trailer</system:String>
                <system:String>DestinationWarehouse</system:String>
                <system:String>Warehouse</system:String>
                <system:String>Yard</system:String>
                <system:String>ActualCompany</system:String>
                <system:String>Load.ContainerType</system:String>
                <system:String>Load.BoardType</system:String>
            </CollectionViewSource.LiveFilteringProperties>
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Load.Age" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <!--Loads collection source-->
        <!-- Use in codebehind -->
        <CollectionViewSource x:Key="LoadsViewSource" Source="{Binding Wrappers}" IsLiveFilteringRequested="True" Filter="LoadsViewSource_OnFilter">
            <CollectionViewSource.LiveFilteringProperties>
                <system:String>DatCompany</system:String>
                <system:String>DatDriver</system:String>
                <system:String>Driver</system:String>
                <system:String>Truck</system:String>
                <system:String>Trailer</system:String>
                <system:String>DestinationWarehouse</system:String>
                <system:String>Warehouse</system:String>
                <system:String>Yard</system:String>
                <system:String>ActualCompany</system:String>
                <system:String>Load.ContainerType</system:String>
                <system:String>Load.BoardType</system:String>
            </CollectionViewSource.LiveFilteringProperties>
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Load.Age" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <Style TargetType="telerik:RadRichTextBox" BasedOn="{StaticResource fieldRadRichTextBox}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="IsSpellCheckingEnabled" Value="False" />
            <Setter Property="IsContextMenuEnabled" Value="False" />
            <Setter Property="IsSelectionMiniToolBarEnabled" Value="False" />
            <Setter Property="IsImageMiniToolBarEnabled" Value="False" />
        </Style>
        <!-- Styles -->
        <styleselector:GridViewCellStyleSelector x:Key="GridViewCellStyleSelector"/>
        <Style TargetType="{x:Type telerik:GridViewDataColumn}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CellStyleSelector" Value="{StaticResource GridViewCellStyleSelector}"/>
        </Style>
        <Style TargetType="{x:Type uc:SumDataColumn}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CellStyleSelector" Value="{StaticResource GridViewCellStyleSelector}"/>
        </Style>
        <Style TargetType="{x:Type telerik:GridViewHyperlinkColumn}">
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <!-- Context Menu with repeating splitterns -->
        <Style TargetType="telerik:RadMenuSeparatorItem">
            <Setter Property="Margin" Value="0,-5,0,-5"/>
        </Style>
    </ucBoards:Board.Resources>
    <Grid>
        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="scaleTransform" CenterX="0" CenterY="0"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="rowPatterns" MinHeight="25" Height="400" />
                <!-- Splitter & ToolBar -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="25"/>
            </Grid.RowDefinitions>
            <!--Board title-->
            <Border CornerRadius="5,5,0,0" Height="Auto" Name="borderTitle"
                      Background="{Binding EngineState, Converter={StaticResource EngineStateToBackgroundConverter}}" >
                <Grid>
                    <TextBlock
                          FontWeight="Bold" Foreground="White"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Text="{Binding Data.Title, Source={StaticResource rootProxy}, Converter={StaticResource TextToUpperConverter}}"/>
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Name="tbEngineQueueCount"  Margin="2"/>
                        <Image gif:ImageBehavior.RepeatBehavior="3x" Name="imEngineState" Width="16" Height="16"
                            gif:ImageBehavior.AnimatedSource="{Binding EngineState, Converter={StaticResource EngineStateToUriConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!--Loading control-->
            <uc:LoadingControl x:Name="loading" Panel.ZIndex="100" Visibility="{Binding Loading, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Row="1" Grid.RowSpan="10" />
            <!--Toolbar-->
            <Border Grid.Row="1" BorderThickness="1,0" BorderBrush="DarkGray" Background="{x:Static SystemColors.ControlBrush}" Padding="3">
                <Grid>
                    <!-- Title -->
                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="DimGray" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Text="{Binding Data.DispatchBoardType, Source={StaticResource rootProxy}, Converter={StaticResource EnumToDescriptionConverter}, Mode=OneWay}"/>
                    <!-- Filter -->
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <userControls:FilterColumnsControl x:Name="itemsFilterPatterns" />
                        <Button ToolTip="Open Filters"
                            Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                            Click="FiltersPatterns_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/filter.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"></uc:AutoGreyableImage>
                            </StackPanel>
                        </Button>
                        <telerik:RadToolBarSeparator/>
                        <Grid>
                            <telerik:RadWatermarkTextBox Name="tbPatternsSearch"
                                FontSize="12"
                                HorizontalAlignment="Right" Width="120" Height="24" Margin="5"
                                WatermarkContent="Search" />
                            <Image
                                Visibility="{Binding Text, ElementName=tbPatternsSearch, Converter={StaticResource StringToVisibilityConverter}}"
                                Width="16" Height="16" Margin="10,0" HorizontalAlignment="Right" Cursor="Hand"
                                MouseLeftButtonUp="gridPatterns_ClearFilter_MouseLeftButtonUp"
                                Source="/AutoDispatch;component/Resources/close.png" />
                        </Grid>
                        <Image Style="{StaticResource HelpFilterStyle}"/>
                    </StackPanel>

                    <!-- CARRIER TOOLBAR -->
                    <StackPanel Orientation="Horizontal" Background="{x:Static SystemColors.ControlBrush}" HorizontalAlignment="Left"
                          Visibility="{Binding
                                        Data.DispatchBoardType, 
                                        Source={StaticResource rootProxy}, 
                                        Converter={StaticResource BorderTypeToVisibilityConverter}, 
                                        ConverterParameter={x:Static enums:DispatchBoardType.Carrier}}">
                        <!--Refresh-->
                        <Button
                            Click="Refresh_Clicked"
                            Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/load.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"></uc:AutoGreyableImage>
                                <TextBlock VerticalAlignment="Center" Margin="3">Refresh</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Export excel-->
                        <Button
                            Click="ExportPatterns_Clicked"
                            Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/Excel_2003.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Export</TextBlock>
                            </StackPanel>
                        </Button>
                        <telerik:RadToolBarSeparator/>
                        <!-- My Brokers -->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Click="MyBrokers_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Margin="3">My Brokers</TextBlock>
                            </StackPanel>
                        </Button>
                        <!-- All Brokers -->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Click="AllBrokers_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Margin="3">All Brokers</TextBlock>
                            </StackPanel>
                        </Button>
                        <telerik:RadToolBarSeparator/>
                        <!-- Drivers -->
                        <Button Focusable="False" Name="bDrivers"
                            Click="Drivers_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/user_group.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Drivers</TextBlock>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToolBarButtonStyle}">
                                    <Setter Property="Background" Value="{Binding MinDriverExpiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static c:ExpirationConverterType.Background}}"/>
                                    <Setter Property="Foreground" Value="{Binding MinDriverExpiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static c:ExpirationConverterType.Foreground}}"/>
                                    <Setter Property="FontWeight" Value="{Binding MinDriverExpiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static c:ExpirationConverterType.FontWeight}}"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Equipment -->
                        <Button Focusable="False" Name="bEquipments"
                            Click="Equipments_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/delivery.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Equipment</TextBlock>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToolBarButtonStyle}">
                                    <Setter Property="Background" Value="{Binding MinEquipmentExpiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static c:ExpirationConverterType.Background}}"/>
                                    <Setter Property="Foreground" Value="{Binding MinEquipmentExpiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static c:ExpirationConverterType.Foreground}}"/>
                                    <Setter Property="FontWeight" Value="{Binding MinEquipmentExpiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static c:ExpirationConverterType.FontWeight}}"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Warehouses -->
                        <Button Focusable="False" Name="bWarehouse"
                            Click="Warehouses_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/database_active.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Warehouses</TextBlock>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToolBarButtonStyle}"/>
                            </Button.Style>
                        </Button>
                        <!-- Yards -->
                        <Button Focusable="False" Name="bYards"
                            Click="Yards_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/database_active.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Yards</TextBlock>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToolBarButtonStyle}"/>
                            </Button.Style>
                        </Button>
                        <telerik:RadToolBarSeparator Name="sCatalogs"/>
                        <!--At The Pick Up-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.CarrierDispatchAtPickUpCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/delivery.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">At The Pick Up</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Picked Up-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.CarrierDispatchPickedUpCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/delivery.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Picked Up</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--In Transit-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.CarrierDispatchInTransitCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/delivery.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">In Transit</TextBlock>
                            </StackPanel>
                        </Button>
                        <!-- Move to Destination Warehouse (In Transit) -->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.CarrierDispatchMoveToDestinationWarehouseCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/delivery.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Move to Destination Warehouse</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--At Delivery-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.CarrierDispatchAtDeliveryCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/delivery.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">At Delivery</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Delivered-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.CarrierDispatchDeliveredCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/delivery.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Delivered</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Move to Accounting (Delivered)-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.MoveToAccountingAsDeliveredCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/currency_blue_dollar.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Move to Accounting (Delivered)</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Test-->
                        <Button x:Name="btnTest" Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Click="Test_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Margin="3">Test</TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- BROKER TOOLBAR -->
                    <StackPanel Orientation="Horizontal" Background="{x:Static SystemColors.ControlBrush}" HorizontalAlignment="Left"
                          Visibility="{Binding
                                        Data.DispatchBoardType, 
                                        Source={StaticResource rootProxy}, 
                                        Converter={StaticResource BorderTypeToVisibilityConverter}, 
                                        ConverterParameter={x:Static enums:DispatchBoardType.Broker}}">
                        <!--Refresh-->
                        <Button
                            Click="Refresh_Clicked"
                            Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/load.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"></uc:AutoGreyableImage>
                                <TextBlock VerticalAlignment="Center" Margin="3">Refresh</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Export excel-->
                        <Button
                            Click="ExportPatterns_Clicked"
                            Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/Excel_2003.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Export</TextBlock>
                            </StackPanel>
                        </Button>
                        <telerik:RadToolBarSeparator/>
                        <!-- My Carriers -->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Click="MyCarriers_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Visibility="{Binding IsNewDatCompany, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  gif:ImageBehavior.AnimatedSource="/AutoDispatch;component/Resources/new.gif"
                                                  VerticalAlignment="Center" Height="Auto"
                                                  Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">My Carriers</TextBlock>
                            </StackPanel>
                        </Button>
                        <!-- All Carriers -->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Click="AllCarriers_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Margin="3">All Carriers</TextBlock>
                            </StackPanel>
                        </Button>
                        <telerik:RadToolBarSeparator/>
                        <!--Create Confirmation-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.CreateConfirmationCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/Document.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Create Confirmation</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Send Confirmation-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.SendConfirmationCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/Document.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Send Confirmation</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Create BOL-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.CreateBOLCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/Document_bill.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Create Bill of Lading</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--At The Pick Up-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.BrokerDispatchAtPickUpCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/delivery.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">At The Pick Up</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Pickup-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.BrokerDispatchPickedUpCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/delivery.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Picked Up</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Delivered-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.BrokerDispatchDeliveredCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/delivery.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Delivered</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Enable CarrierView Tracker-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.EnableCarrierViewTrackerCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/carrierview.png"
                                Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                <TextBlock VerticalAlignment="Center" Margin="3">Enable Tracker</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Disable CarrierView Tracker-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                            Command="{Binding Data.dc.DisableCarrierViewTrackerCommand, Source={StaticResource rootProxy}}"
                            CommandParameter="{Binding Data.SelectedPatterns, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/carrierview.png"
                                Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
