                          DataMemberBinding="{Binding Load.Equipment, Converter={StaticResource EquipmentTypeToCodeConverter}}" />
                    <telerik:GridViewDataColumn Width="40" Header="Temperature" ColumnGroupName="Load"
                          DataMemberBinding="{Binding Load.EquipmentTemperature}">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                                <Setter Property="helpers:UIHelper.Trigger" Value="{Binding Load.Temperature}"/>
                                <Setter Property="helpers:UIHelper.Trigger" Value="{Binding Load.Equipment}"/>
                                <Setter Property="Foreground" Value="{Binding Load, Converter={StaticResource TemperatureToColorConverter}, ConverterParameter={x:Static dispatch:TemperatureToColorConverterParameter.Foreground}}"/>
                                <Setter Property="FontWeight" Value="{Binding Load, Converter={StaticResource TemperatureToColorConverter}, ConverterParameter={x:Static dispatch:TemperatureToColorConverterParameter.FontWeight}}"/>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn Width="140" Header="Origin" ColumnGroupName="Load" UniqueName="Load.OriginCity"
                          DataMemberBinding="{Binding OriginCity}">
