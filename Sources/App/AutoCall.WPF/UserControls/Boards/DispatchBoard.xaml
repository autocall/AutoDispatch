                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Visibility="{Binding Load.PhotoFileView, Converter={StaticResource NotNullToVisibilityConverter}}">
                              <Hyperlink Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.OpenPhotoCommand}" helpers:UIHelper.CommandParameter="{Binding}">
                                <Run Text="open"/>
                              </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>
                    <!-- Confirmation -->
                    <telerik:GridViewDataColumn Width="85" Header="Confirmation" Name="gridLoads_confCol" ColumnGroupName="Documents"
                          extensions:PropertyExtensions.RelativeDisplayIndex="0" IsReadOnly="True"
                          DataMemberBinding="{Binding Load.ConfirmationFileView}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Visibility="{Binding Load.ConfirmationFileView, Converter={StaticResource NotNullToVisibilityConverter}}">
                              <Hyperlink Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.OpenConfirmationCommand}" helpers:UIHelper.CommandParameter="{Binding}">
                                <Run Text="open"/>
                              </Hyperlink>
                              <Run Text="{Binding Load.ConfirmationDateView, StringFormat=d, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>
                    <!-- BOL -->
                    <telerik:GridViewDataColumn Width="85" Header="BOL" Name="gridLoads_bolCol" ColumnGroupName="Documents"
                          extensions:PropertyExtensions.RelativeDisplayIndex="1" IsReadOnly="True"
                          DataMemberBinding="{Binding Load.BOLFileView}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Visibility="{Binding Load.BOLFileView, Converter={StaticResource NotNullToVisibilityConverter}}">
                              <Hyperlink Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.OpenBOLCommand}" helpers:UIHelper.CommandParameter="{Binding}">
                                <Run Text="open"/>
                              </Hyperlink>
                              <Run Text="{Binding Load.BOLDateView, StringFormat=d, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>
                    <!-- POD -->
                    <telerik:GridViewDataColumn Width="85" Header="POD" Name="gridLoads_podCol" ColumnGroupName="Documents"
                          extensions:PropertyExtensions.RelativeDisplayIndex="1" IsReadOnly="True"
                          DataMemberBinding="{Binding Load.PODFileView}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Visibility="{Binding Load.PODFileView, Converter={StaticResource NotNullToVisibilityConverter}}">
                              <Hyperlink Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.OpenPODCommand}" helpers:UIHelper.CommandParameter="{Binding}">
                                <Run Text="open"/>
                              </Hyperlink>
                              <Run Text="{Binding Load.PODDateView, StringFormat=d, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>
                    <!-- Paperwork -->
                    <telerik:GridViewDataColumn Width="85" Header="Paperwork" Name="gridLoad_paperworkCol"
                          extensions:PropertyExtensions.RelativeDisplayIndex="1" IsReadOnly="True"
                          SortMemberPath="Load.PaperworkDateView"
                          DataMemberBinding="{Binding Load.PaperworkFileView}" ColumnGroupName="Documents">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Visibility="{Binding Load.PaperworkFileView, Converter={StaticResource NotNullToVisibilityConverter}}">
                                  <Hyperlink Command="{Binding Path=Data.dc.OpenPaperworkCommand, Source={StaticResource rootProxy}}" helpers:UIHelper.CommandParameter="{Binding}">
                                    <Run Text="open"/>
                                  </Hyperlink>
                                  <Run Text="{Binding Load.PaperworkDateView, StringFormat=d, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>
                </telerik:RadGridView.Columns>
                <!-- Row Style -->
                <telerik:RadGridView.RowStyle>
                    <Style TargetType="{x:Type telerik:GridViewRow}" BasedOn="{StaticResource GridViewRowStyle2}">
                        <EventSetter Event="MouseDoubleClick" Handler="gridLoads_RowDoubleClick" />
                        <EventSetter Event="MouseRightButtonUp" Handler="gridRow_MouseRightButtonUp"/>
                        <EventSetter Event="MouseRightButtonDown" Handler="gridRow_MouseRightButtonDown"/>
                        <Setter Property="telerik:RadContextMenu.ContextMenu" Value="{Binding Converter={StaticResource ContextMenuSwitcherConverter}, Mode=OneTime}"/>
                        <!-- Глючит <Setter Property="IsExpandable" Value="{Binding Converter={StaticResource AnyChildrenConverter}, Mode=OneWay}" />-->
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsEnabled" Value="{Binding Load.Saving, Converter={StaticResource InvertedBooleanConverter}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Load.Status}" Value="{x:Static enums:LoadStatus.Completed}">
                                <Setter Property="TextBlock.Foreground" Value="#A0A0A0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Load.Status}" Value="{x:Static enums:LoadStatus.Unpaid}">
                                <Setter Property="TextBlock.Foreground" Value="#A0A0A0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Load.Status}" Value="{x:Static enums:LoadStatus.Canceled2}">
                                <Setter Property="TextBlock.Foreground" Value="#A0A0A0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNew}" Value="False">
                                <Setter Property="FontWeight" Value="Normal"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Load.Mark}" Value="True">
                                <Setter Property="Background" Value="{StaticResource GridViewRowOverBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </telerik:RadGridView.RowStyle>
                <!--<telerik:RadGridView.RowStyleSelector>
                                <telerik:ConditionalStyleSelector>
                                    <telerik:StyleRule Condition="expandable">
                                        <Style TargetType="telerik:GridViewRow">
                                            <Setter Property="IsExpandable" Value="True" />
                                        </Style>
                                    </telerik:StyleRule>
                                    <telerik:StyleRule Condition="Not expandable">
                                        <Style TargetType="telerik:GridViewRow">
                                            <Setter Property="IsExpandable" Value="False" />
                                        </Style>
                                    </telerik:StyleRule>
                                </telerik:ConditionalStyleSelector>
                            </telerik:RadGridView.RowStyleSelector>-->
            </telerik:RadGridView>
