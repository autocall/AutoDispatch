<ucBoards:DispatchBoardBase
        x:Class="AutoCall.WPF.UserControls.Boards.DispatchAccountBoard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:c="clr-namespace:AutoCall.WPF.Converters"
        xmlns:uc="clr-namespace:AutoCall.WPF.UserControls"
        xmlns:core="clr-namespace:AutoCall.WPF.Core"
        xmlns:ucBoards="clr-namespace:AutoCall.WPF.UserControls.Boards"
        xmlns:enums="clr-namespace:AutoDispatch.Dtos.Enums;assembly=AutoDispatch.Dtos"
        xmlns:helpers="clr-namespace:AutoCall.WPF.Helpers"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:dispatch="clr-namespace:AutoCall.WPF.Converters.Dispatch"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:userControls="clr-namespace:AutoCall.WPF.Dialogs.Dispatch.UserControls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:AutoCall.WPF.Behaviors"
        xmlns:extensions="clr-namespace:AutoCall.WPF.Extensions"
        xmlns:viewmodels="clr-namespace:AutoDispatch.Logic.ViewModels;assembly=AutoDispatch.Logic.Contracts"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:styleselector="clr-namespace:AutoCall.WPF.StyleSelector"
        mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300">
    <ucBoards:Board.Resources>
        <!-- Converters -->
        <c:AnyToBooleanConverter x:Key="AnyToBooleanConverter" />
        <c:InverseBooleanConverter x:Key="InvertedBooleanConverter" />
        <c:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter" />
        <c:NotEmptyStringToBoolConverter x:Key="NotEmptyStringToBoolConverter" />
        <c:NotNullToBoolConverter x:Key="ObjectToBoolConverter" />
        <c:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
        <c:NotNullToVisibilityConverter x:Key="NullToVisibilityConverter" Invert="True" />
        <c:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <c:ToStringConverter x:Key="ToStringConverter" />
        <c:BooleanToStringConverter x:Key="BooleanToLateConverter" TrueString="Yes" FalseString=""/>
        <telerik:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <dispatch:DispatchBoard_AnyChildrenConverter x:Key="AnyChildrenConverter"/>
        <dispatch:EditLoadDialog_PalletTypeToBrushConverter x:Key="palletTypeToBrushConverter"/>
        <dispatch:BookLoadDialog_BorderTypeToVisibilityConverter x:Key="BorderTypeToVisibilityConverter" />
        <dispatch:DispatchBoard_BoardToCommentNameConverter x:Key="BoardToComment1NameConverter" Type="Comment1" />
        <dispatch:DispatchBoard_BoardToCommentNameConverter x:Key="BoardToComment2NameConverter" Type="Comment2" />
        <dispatch:DispatchBoard_BoardToCommentNameConverter x:Key="BoardToConsolidationNameConverter" Type="Consolidation" />
        <dispatch:DispatchBoard_AddMonthToDateTimeConverter x:Key="AddMonthToDateTimeConverter" />
        <dispatch:DispatchBoard_CustomStatusIdToNameConverter x:Key="CustomStatusIdToNameConverter"/>
        <!-- Proxy -->
        <core:BindingProxy x:Key="proxy" Data="{Binding}" />
        <core:BindingProxy x:Key="sProxy" Data="{Binding SelectedItemsModel, RelativeSource={RelativeSource AncestorType={x:Type ucBoards:Board}, Mode=FindAncestor}}"/>
        <core:BindingProxy x:Key="rootProxy" Data="{Binding RelativeSource={RelativeSource AncestorType={x:Type ucBoards:Board}, Mode=FindAncestor}}" />
        <!-- Styles -->
        <styleselector:GridViewCellStyleSelector x:Key="GridViewCellStyleSelector"/>
        <Style TargetType="{x:Type telerik:GridViewDataColumn}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CellStyleSelector" Value="{StaticResource GridViewCellStyleSelector}"/>
        </Style>
        <Style TargetType="{x:Type uc:SumDataColumn}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CellStyleSelector" Value="{StaticResource GridViewCellStyleSelector}"/>
        </Style>
        <Style TargetType="{x:Type telerik:GridViewHyperlinkColumn}">
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <!-- Context Menu with repeating splitterns -->
        <Style TargetType="telerik:RadMenuSeparatorItem">
            <Setter Property="Margin" Value="0,-5,0,-5" />
        </Style>
        <!--Loads collection source-->
        <!-- Use in codebehind -->
        <CollectionViewSource x:Key="LoadsViewSource" Source="{Binding Wrappers}" IsLiveFilteringRequested="True" Filter="LoadsViewSource_OnFilter">
            <CollectionViewSource.LiveFilteringProperties>
                <system:String>DatCompany</system:String>
                <system:String>DatDriver</system:String>
                <system:String>Driver</system:String>
                <system:String>Truck</system:String>
                <system:String>Trailer</system:String>
                <system:String>Warehouse</system:String>
                <system:String>Yard</system:String>
                <system:String>HistoryDatCompany</system:String>
                <system:String>HistoryDatDriver</system:String>
                <system:String>HistoryDriver</system:String>
                <system:String>HistoryTruck</system:String>
                <system:String>HistoryTrailer</system:String>
                <system:String>HistoryWarehouse</system:String>
                <system:String>ActualCompany</system:String>
                <system:String>Load.ContainerType</system:String>
                <system:String>Load.BoardType</system:String>
            </CollectionViewSource.LiveFilteringProperties>
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Load.Age" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <Style TargetType="telerik:RadRichTextBox" BasedOn="{StaticResource fieldRadRichTextBox}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="IsSpellCheckingEnabled" Value="False" />
            <Setter Property="IsContextMenuEnabled" Value="False" />
            <Setter Property="IsSelectionMiniToolBarEnabled" Value="False" />
            <Setter Property="IsImageMiniToolBarEnabled" Value="False" />
        </Style>
        <DataTemplate x:Key="HistoryDatCompanyNameColumnTemplate">
            <TextBlock Text="{Binding HistoryDriverCarrier_Name}" Margin="0,0,5,0"/>
        </DataTemplate>
    </ucBoards:Board.Resources>
    <Grid>
        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="scaleTransform" CenterX="0" CenterY="0" />
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="25" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--Board title-->
            <Border CornerRadius="5,5,0,0" Height="Auto" Name="borderTitle"
              Background="{Binding EngineState, Converter={StaticResource EngineStateToBackgroundConverter}}">
                <Grid>
                    <TextBlock
                  FontWeight="Bold" Foreground="White"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Text="{Binding Data.Title, Source={StaticResource rootProxy}, Converter={StaticResource TextToUpperConverter}}" />
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Name="tbEngineQueueCount"  Margin="2" />
                        <Image gif:ImageBehavior.RepeatBehavior="3x" Name="imEngineState" Width="16" Height="16"
                    gif:ImageBehavior.AnimatedSource="{Binding EngineState, Converter={StaticResource EngineStateToUriConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <!--Loading control-->
            <uc:LoadingControl x:Name="loading" Panel.ZIndex="100" Visibility="{Binding Loading, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Row="1" Grid.RowSpan="10" />
            <!--Toolbar-->
            <Border Grid.Row="1" BorderThickness="1,0" BorderBrush="DarkGray" Background="{x:Static SystemColors.ControlBrush}" Padding="3">
                <Grid>
                    <!-- Title -->
                    <TextBlock
                  FontSize="12" FontWeight="Bold" Foreground="DimGray"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Text="{Binding Data.DispatchBoardType, Source={StaticResource rootProxy}, Converter={StaticResource EnumToDescriptionConverter}}" />
                    <!-- Filter -->
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <userControls:FilterColumnsControl x:Name="itemsFilterRecords" />
                        <Button ToolTip="Open Filters"
                    Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                    Click="FiltersRecords_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/filter.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"></uc:AutoGreyableImage>
                            </StackPanel>
                        </Button>
                        <telerik:RadToolBarSeparator />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <telerik:RadComboBox Name="historyFilter"
                  AllowMultipleSelection="False"
                  ClearSelectionButtonVisibility="Visible" ClearSelectionButtonContent="Clear Selection"
                  SelectedValuePath="Key" Height="24" Width="190"
                  SelectionChanged="HistoryFilter_OnSelectionChanged">
                                <telerik:RadComboBox.EmptySelectionBoxTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="History" Foreground="Gray" FontStyle="Italic" />
                                    </DataTemplate>
                                </telerik:RadComboBox.EmptySelectionBoxTemplate>
                                <telerik:RadComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock HorizontalAlignment="Left" >
                            <Run Text="{Binding Key, StringFormat={}{0:M/d/yyyy}, Mode=OneWay}"/>
                            <Run>-</Run>
                            <Run Text="{Binding Key, StringFormat={}{0:M/d/yyyy}, Converter={StaticResource AddMonthToDateTimeConverter}, ConverterParameter=3, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Value, StringFormat={}({0})}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </telerik:RadComboBox.ItemTemplate>
                            </telerik:RadComboBox>
                            <Grid>
                                <telerik:RadWatermarkTextBox Name="tbLoadsSearch"
                        FontSize="12"
                        Width="120" Height="24" Margin="5"
                        WatermarkContent="Search" />
                                <Image
                        Visibility="{Binding Text, ElementName=tbLoadsSearch, Converter={StaticResource StringToVisibilityConverter}}"
                        Width="16" Height="16" Margin="10,0" HorizontalAlignment="Right" Cursor="Hand"
                        MouseLeftButtonUp="gridLoads_ClearFilter_MouseLeftButtonUp"
                        Source="/AutoDispatch;component/Resources/close.png" />
                            </Grid>
                        </StackPanel>
                        <Image Style="{StaticResource HelpFilterStyle}" />
                    </StackPanel>
                    <!-- ToolBar -->
                    <!-- CARRIER TOOLBAR -->
                    <StackPanel Orientation="Horizontal" Background="{x:Static SystemColors.ControlBrush}" HorizontalAlignment="Left"
                  Visibility="{Binding
                                Data.DispatchBoardType,
                                Source={StaticResource rootProxy},
                                Converter={StaticResource BorderTypeToVisibilityConverter},
                                ConverterParameter={x:Static enums:DispatchBoardType.Carrier}}">
                        <!--Refresh-->
                        <Button
                    Click="Refresh_Clicked"
                    Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/load.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"></uc:AutoGreyableImage>
                                <TextBlock VerticalAlignment="Center" Margin="3">Refresh</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Export excel-->
                        <Button
                    Click="Export_Clicked"
                    Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/Excel_2003.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">Export</TextBlock>
                            </StackPanel>
                        </Button>
                        <telerik:RadToolBarSeparator />
                        <!-- My Brokers -->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Click="MyBrokers_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Margin="3">My Brokers</TextBlock>
                            </StackPanel>
                        </Button>
                        <!-- All Brokers -->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Click="AllBrokers_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Margin="3">All Brokers</TextBlock>
                            </StackPanel>
                        </Button>
                        <telerik:RadToolBarSeparator />
                        <!--Factoring Company-->
                        <Button Click="Factoring_Company_OnClick"
                        Focusable="False" Style="{StaticResource ToolBarButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/coins.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">Factoring Company</TextBlock>
                            </StackPanel>
                        </Button>
                        <telerik:RadToolBarSeparator />
                        <!--Create Invoice-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding Data.dc.CreateInvoiceCommand, Source={StaticResource rootProxy}}"
                    CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/Document.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">Create Invoice</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Send Invoice-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding Data.dc.SendInvoiceCommand, Source={StaticResource rootProxy}}"
                    CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/Document.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">Send Invoice</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Issues-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding Data.dc.IssuesCommand, Source={StaticResource rootProxy}}"
                    CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/warning_yellow.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">Issues</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Bond-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding Data.dc.BondCommand, Source={StaticResource rootProxy}}"
                    CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/Document_bill.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">Bond</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Paid-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding Data.dc.PaidCommand, Source={StaticResource rootProxy}}"
                    CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/currency_paid.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">Paid</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Unpaid-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding Data.dc.UnpaidCommand, Source={StaticResource rootProxy}}"
                    CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/currency_unpaid.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">Unpaid</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Attach Check-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding Data.dc.AttachCheckCommand, Source={StaticResource rootProxy}}"
                    CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/Document_checked.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">Attach Check</TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- BROKER TOOLBAR -->
                    <StackPanel Orientation="Horizontal" Background="{x:Static SystemColors.ControlBrush}" HorizontalAlignment="Left"
                  Visibility="{Binding
                                Data.DispatchBoardType,
                                Source={StaticResource rootProxy},
                                Converter={StaticResource BorderTypeToVisibilityConverter},
                                ConverterParameter={x:Static enums:DispatchBoardType.Broker}}">
                        <!--Refresh-->
                        <Button
                    Click="Refresh_Clicked"
                    Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/load.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"></uc:AutoGreyableImage>
                                <TextBlock VerticalAlignment="Center" Margin="3">Refresh</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Export excel-->
                        <Button
                    Click="Export_Clicked"
                    Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/Excel_2003.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">Export</TextBlock>
                            </StackPanel>
                        </Button>
                        <telerik:RadToolBarSeparator />
                        <!-- My Carriers -->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Click="MyCarriers_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Visibility="{Binding IsNewDatCompany, Converter={StaticResource BooleanToVisibilityConverter}}"
                        gif:ImageBehavior.AnimatedSource="/AutoDispatch;component/Resources/new.gif" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">My Carriers</TextBlock>
                            </StackPanel>
                        </Button>
                        <!-- All Carriers -->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Click="AllCarriers_Clicked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Margin="3">All Carriers</TextBlock>
                            </StackPanel>
                        </Button>
                        <telerik:RadToolBarSeparator />
                        <!--Paid-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding Data.dc.PaidCommand, Source={StaticResource rootProxy}}"
                    CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/currency_paid.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">Paid</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Unpaid-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding Data.dc.UnpaidCommand, Source={StaticResource rootProxy}}"
                    CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/currency_unpaid.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">Unpaid</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Attach Check-->
                        <Button Focusable="False" Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding Data.dc.AttachCheckCommand, Source={StaticResource rootProxy}}"
                    CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}">
                            <StackPanel Orientation="Horizontal">
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/Document_checked.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}" />
                                <TextBlock VerticalAlignment="Center" Margin="3">Attach Check</TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!--Records grid-->
            <telerik:RadGridView x:Name="gridLoads" Grid.Row="2"
              AutoGenerateColumns="False" IsReadOnly="False" IsTabStop="False"
              SelectionMode="Extended" SelectionUnit="FullRow"
              IsFilteringAllowed="False"
              ShowColumnFooters="True" ShowGroupFooters="False"
              ShowGroupPanel="False" AutoExpandGroups="True"
              RowIndicatorVisibility="Collapsed"
              CanUserFreezeColumns="False" CanUserReorderColumns="True" CanUserSortColumns="True"
              ColumnReordering="gridLoads_ColumnReordering"
              SelectionChanged="grid_SelectionChanged"
              PreviewMouseLeftButtonUp="grid_PreviewMouseLeftButtonUp"
              PreparedCellForEdit="grid_PreparedCellForEdit"
              CellEditEnded="grid_CellEditEnded"
              CellValidating="grid_CellValidating"
              SearchPanelVisibilityChanged="grid_SearchPanelVisibilityChanged"
              CopyingCellClipboardContent="grid_CopyingCellClipboardContent"
              IsExpandableBinding="{Binding Converter={StaticResource AnyChildrenConverter}, Mode=OneWay}"
              Background="{x:Static SystemColors.ControlBrush}"
              Style="{StaticResource showHideGroupColumnsRadGridViewStyle}"
              ItemsSource="{Binding PagedSource, ElementName=dataPager}">
                <telerik:RadGridView.ColumnGroups>
                    <telerik:GridViewColumnGroup Name="Documents" Header="Documents" />
                    <telerik:GridViewColumnGroup Name="Customer" Header="Customer" />
                    <telerik:GridViewColumnGroup Name="Carrier" Header="Carrier" />
                    <telerik:GridViewColumnGroup Name="Load" Header="Load" />
                    <telerik:GridViewColumnGroup Name="Expenses" Header="Expenses" />
                    <telerik:GridViewColumnGroup Name="Accessorial" Header="Accessorial" />
                    <telerik:GridViewColumnGroup Name="Rate" Header="Rate" />
                </telerik:RadGridView.ColumnGroups>
                <telerik:RadGridView.ChildTableDefinitions>
                    <telerik:GridViewTableDefinition />
                </telerik:RadGridView.ChildTableDefinitions>
                <i:Interaction.Behaviors>
                    <!-- NOTE: REMEMBE, THE BEHAVIOR MUST BE PUBLIC -->
                    <behaviors:RadGridViewMultiSelectBehavior SelectedItems="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}" />
                </i:Interaction.Behaviors>
                <telerik:RadGridView.HierarchyChildTemplate>
                    <DataTemplate>
                        <telerik:RadGridView
                    Margin="0,0,0,-1" BorderThickness="0"
                    AutoGenerateColumns="False" ShowColumnHeaders="False"
                    SelectionMode="Extended" SelectionUnit="FullRow"
                    RowIndicatorVisibility="Collapsed"
                    ShowGroupPanel="False" ShowColumnFooters="False" ShowColumnSortIndexes="False" ShowGroupFooters="False" ShowSearchPanel="False"
                    CanUserReorderColumns="True" CanUserFreezeColumns="False" CanUserSortColumns="True" IsReadOnly="True"
                    Background="{x:Static SystemColors.ControlBrush}"
                    Loaded="ChildGridLoads_OnLoaded"
                    CellEditEnded="grid_CellEditEnded"
                    GroupRenderMode="Flat"
                    IsSynchronizedWithCurrentItem="True">
                            <telerik:RadGridView.ChildTableDefinitions>
                                <telerik:GridViewTableDefinition />
                            </telerik:RadGridView.ChildTableDefinitions>
                            <i:Interaction.Behaviors>
                                <!-- NOTE: REMEMBE, THE BEHAVIOR MUST BE PUBLIC -->
                                <behaviors:RadGridViewMultiSelectBehavior SelectedItems="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}" />
                            </i:Interaction.Behaviors>
                            <telerik:RadGridView.Resources>
                                <!--Loads collection source-->
                                <!-- Use in codebehind, NOTE: Use Static Event -->
                                <CollectionViewSource x:Key="SubLoadsViewSource" Source="{Binding Children}"
                        IsLiveFilteringRequested="True">
                                    <CollectionViewSource.LiveFilteringProperties>
                                        <system:String>DatCompany</system:String>
                                        <system:String>DatDriver</system:String>
                                        <system:String>Driver</system:String>
                                        <system:String>Truck</system:String>
                                        <system:String>Trailer</system:String>
                                        <system:String>Warehouse</system:String>
                                        <system:String>ActualCompany</system:String>
                                        <system:String>Load.ContainerType</system:String>
                                        <system:String>Load.BoardType</system:String>
                                    </CollectionViewSource.LiveFilteringProperties>
                                </CollectionViewSource>
                            </telerik:RadGridView.Resources>
                        </telerik:RadGridView>
                    </DataTemplate>
                </telerik:RadGridView.HierarchyChildTemplate>
                <!-- Groups -->
                <telerik:RadGridView.Resources>
                    <!-- Context Menu for Carrier Accounting -->
                    <telerik:RadContextMenu x:Key="rowContextMenuCarrier" Opened="RadContextMenu_Opened" Opening="RadContextMenu_Opening">
                        <telerik:RadContextMenu.Resources>
                            <Style TargetType="{x:Type telerik:RadMenuItem}">
                                <Setter Property="helpers:TextDecorationHelper.TextDecoration" Value="None" />
                            </Style>
                        </telerik:RadContextMenu.Resources>
                        <uc:RadMenuItem CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}" Header="Create Invoice"
                    Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.CreateInvoiceCommand}" />
                        <uc:RadMenuItem CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}" Header="Send Invoice"
                    Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.SendInvoiceCommand}" />
                        <uc:RadMenuItem CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}" Header="Resend Invoice"
                    Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.ResendInvoiceCommand}" />
                        <uc:RadMenuItem CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}" Header="Edit Invoice"
                    Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.EditInvoiceCommand}" />
                        <uc:RadMenuItem CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}" Header="Attach Confirmation"
                    Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.AttachConfirmationCommand}" />
                        <uc:RadMenuItem CommandParameter="{Binding Data.SelectedLoads, Source={StaticResource sProxy}}" Header="Attach POD"
