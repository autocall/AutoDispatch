                  DataMemberBinding="{Binding Load.InvoiceNumber}">
                        <telerik:GridViewDataColumn.Resources>
                            <!-- it is resource with key! uses in codebehind in DispatchCarrierAccountBoard. -->
                            <DataTemplate x:Key="carrierLoadDataTemplate">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding Load.ParentId, Converter={StaticResource NullToVisibilityConverter}}">
                                    <!-- Invoice Number -->
                                    <TextBlock Visibility="{Binding Load.InvoiceNumber, Converter={StaticResource NotNullToVisibilityConverter}}">
                        <Hyperlink
                            IsEnabled="{Binding Load.InvoiceFile, Converter={StaticResource ObjectToBoolConverter}}"
                            Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.OpenInvoiceCommand}" helpers:UIHelper.CommandParameter="{Binding}">
                          <Run Text="{Binding Load.InvoiceNumber}" />
                        </Hyperlink>
                                    </TextBlock>
                                    <!-- Create -->
                                    <TextBlock Visibility="{Binding Load.InvoiceNumber, Converter={StaticResource NullToVisibilityConverter}}">
                        <Hyperlink Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.CreateInvoiceCommand}" helpers:UIHelper.CommandParameter="{Binding}">
                          <Run Text="create" />
                        </Hyperlink>
                                    </TextBlock>
                                    <!-- Edit -->
                                    <TextBlock Visibility="{Binding Load.InvoiceNumber, Converter={StaticResource NotNullToVisibilityConverter}}" Margin="5,0,0,0">
                        <Hyperlink Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.EditInvoiceCommand}" helpers:UIHelper.CommandParameter="{Binding}">
                          <Run Text="edit" />
                        </Hyperlink>
                                    </TextBlock>
                                    <!-- Send and Resend -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding Load.InvoiceFile, Converter={StaticResource NotNullToVisibilityConverter}}">
                                        <!-- Send -->
                                        <TextBlock Visibility="{Binding Load.EmailInvoiceSentDate, Converter={StaticResource NullToVisibilityConverter}}" Margin="5,0,0,0">
                          <Hyperlink Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.SendInvoiceCommand}" helpers:UIHelper.CommandParameter="{Binding}">
                            <Run Text="send" />
                          </Hyperlink>
                                        </TextBlock>
                                        <!-- Resend -->
                                        <Grid Visibility="{Binding Load.InvoiceDate, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Visibility="{Binding Load.EmailInvoiceSentDate, Converter={StaticResource NotNullToVisibilityConverter}}" Margin="5,0,0,0">
                            <Hyperlink Command="{Binding Source={StaticResource rootProxy}, Path=Data.dc.ResendInvoiceCommand}" helpers:UIHelper.CommandParameter="{Binding}">
                              <Run Text="resend" />
                            </Hyperlink>
                                            </TextBlock>
