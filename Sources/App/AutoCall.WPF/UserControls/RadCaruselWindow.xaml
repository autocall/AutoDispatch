<Window x:Class="AutoCall.WPF.UserControls.RadCaruselWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" 
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800"
    Title="Preview Images" Width="800" Height="450"
    WindowStartupLocation="CenterScreen"
    Loaded="Window_Loaded"
    Background="{x:Static SystemColors.ControlBrush}"
    Icon="/AutoDispatch;component/Resources/icon.ico">
    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type telerik:CarouselItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
            <converters:LongToSizeFileConverter x:Key="LongToSizeFileConverter"/>
            <DataTemplate x:Key="CarouselItemTemplate">
                <StackPanel Background="#3B3B3B">
                    <TextBlock MaxWidth="200" Margin="5,5,5,5"
                        Foreground="Gainsboro"
                        Text="{Binding Name}"
                        FontSize="16" 
                        HorizontalAlignment="Left" />
                    <!--https://stackoverflow.com/questions/6081800/wpf-rounded-corners-images -->
                    <Grid HorizontalAlignment="Stretch">
                        <Border MaxWidth="200" MaxHeight="200" Margin="5,0" CornerRadius="10">
                            <Grid HorizontalAlignment="Center">
                                <Border Name="Mask" Background="White" CornerRadius="10">
                                </Border>
                                <Image Name="Receiver" Source="{Binding DataImage}" >
                                    <Image.OpacityMask>
                                        <VisualBrush Visual="{Binding ElementName=Mask}" />
                                    </Image.OpacityMask>
                                </Image>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock 
                        Text="{Binding Size, Converter={StaticResource LongToSizeFileConverter}}" 
                        FontSize="12" Margin="5,5,5,0"
                        Foreground="LightGray" 
                        VerticalAlignment="Center" />
                    <TextBlock 
                        Text="{Binding CreatedDate}" 
                        FontSize="12" Margin="5,0,5,5"
                        Foreground="LightGray" 
                        VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telerik.Windows.Controls.Navigation;component/Themes/GenericOfficeBlack.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <telerik:RadCarousel x:Name="radCarousel" 
            MouseDoubleClick="radCarousel_MouseDoubleClick"
            HorizontalScrollBarVisibility="Hidden"
            ItemTemplate="{StaticResource CarouselItemTemplate}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ItemsSource="{Binding}"
            Background="Transparent"
            VirtualizingStackPanel.IsVirtualizing="False">
        </telerik:RadCarousel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <telerik:CarouselScrollButton Margin="5" CarouselScrollButtonType="PageLeft" Click="pageDownButton_Click" Style="{StaticResource CarouselScrollButtonStyle}"/>
            <telerik:CarouselScrollButton Margin="5" CarouselScrollButtonType="LineLeft" Click="pageLeftButton_Click" Style="{StaticResource CarouselScrollButtonStyle}"/>
            <telerik:CarouselScrollButton Margin="5" CarouselScrollButtonType="LineRight" Click="pageRightButton_Click" Style="{StaticResource CarouselScrollButtonStyle}"/>
            <telerik:CarouselScrollButton Margin="5" CarouselScrollButtonType="PageRight" Click="pageUpButton_Click" Style="{StaticResource CarouselScrollButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
