<dialogs:SingleInstanceWindow 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:AutoCall.WPF.Converters"
    xmlns:uc="clr-namespace:AutoCall.WPF.UserControls"
    xmlns:dialogs="clr-namespace:AutoCall.WPF.Dialogs"
    xmlns:toUri="clr-namespace:AutoCall.WPF.Converters.ToUri"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:core="clr-namespace:AutoCall.WPF.Core"
    xmlns:enums="clr-namespace:AutoCall.Logic.Contracts.Enums;assembly=AutoDispatch.Logic.Contracts"
    xmlns:dispatch="clr-namespace:AutoCall.WPF.Converters.Dispatch"
    x:Class="AutoCall.WPF.MainWindow"
    Title="Auto Call" Height="500" Width="1100" WindowState="Maximized" 
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    Closing="OnWindowClosing"
    KeyDown="Window_OnKeyDown">
    <dialogs:SingleInstanceWindow.Resources>
        <!--Converters-->
        <core:BindingProxy x:Key="proxy" Data="{Binding}"/>
        <!-- Using in code behind -->
        <c:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <telerik:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />
        <c:NotNullToBoolConverter x:Key="ObjectToBoolConverter"/>
        <c:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <c:NotNullToVisibilityConverter x:Key="NullToVisibilityConverter" Invert="True"/>
        <c:DictionaryToValueConverter x:Key="DictionaryToValueConverter" />
        <dispatch:MainWindow_BookedRulerConverter x:Key="BookedRulerToCarriageXConverter" Width="200" Property="carriageX" />
        <dispatch:MainWindow_BookedRulerConverter x:Key="BookedRulerToCarriageXLeftConverter" Width="200" Property="carriageXLeft" />
        <dispatch:MainWindow_BookedRulerConverter x:Key="BookedRulerToCarriageXRightConverter" Width="200" Property="carriageXRight" />
        <dispatch:MainWindow_BookedRulerConverter x:Key="BookedRulerToTotalXRightConverter" Width="200" Property="totalXRight" />
        <dispatch:MainWindow_BookedRulerConverter x:Key="BookedRulerToBackgroundConverter" Width="200" Property="Background" />
        <dispatch:MainWindow_BookedRulerConverter x:Key="BookedRulerToForegroundConverter" Width="200" Property="Foreground" />

    </dialogs:SingleInstanceWindow.Resources>
    <dialogs:SingleInstanceWindow.TaskbarItemInfo>
        <TaskbarItemInfo />
    </dialogs:SingleInstanceWindow.TaskbarItemInfo>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="130"/>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--Main toolbar-->
            <Border Grid.Row="0" BorderThickness="0" Background="{x:Static SystemColors.ControlBrush}" Padding="5,5,5,0">
                <Grid>
                    <WrapPanel Orientation="Horizontal">
                        <!--Calling Status button-->
                        <Button Name="bCallingStatus" Margin="2,0" IsEnabled="False"
                            Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                            Click="Hangup_Clicked">
                            <StackPanel>
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/phone_red.png" Style="{StaticResource ResourceKey=ToggleButtonImageStyle}" />
                                <TextBlock HorizontalAlignment="Center" Margin="3">Hang Up ALL</TextBlock>
                            </StackPanel>
                        </Button>
                        <telerik:RadToolBarSeparator/>
                        <!-- V1: AutoCall (автодозвон DAT), Quick Rate Search, Post/Search (борды DatPower) — модуль AutoCall, не перенесены -->
                        <telerik:RadToolBarSeparator Name="separator0"/>
                        <!--Map-->
                        <Button BorderThickness="0" Click="Map_Onclicked" MinWidth="70"
                            Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <StackPanel Orientation="Vertical">
                                <Image Source="/AutoDispatch;component/Resources/globe.png" Style="{StaticResource ResourceKey=ToggleButtonImageStyle}" />
                                <TextBlock HorizontalAlignment="Center" Margin="3">Map</TextBlock>
                            </StackPanel>
                        </Button>
                        <!-- Carrier -->
                        <Border Name="carrierBorder" BorderThickness="1" BorderBrush="#FFC0C0C0" Padding="0" Margin="2,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <telerik:RadComboBox Grid.ColumnSpan="3"
                                    ClearSelectionButtonVisibility="Visible" ClearSelectionButtonContent="All Carriers" EmptyText="All Carriers"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    ItemsSource="{Binding CarrierCompanies}"
                                    SelectedItem="{Binding SelectedCarrierCompany, Mode=TwoWay}" 
                                    telerik:StyleManager.Theme="{StaticResource SummerTheme}"
                                    SelectionChanged="CarrierCompany_OnClicked">
                                    <telerik:RadComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding LogoSmall}" 
                                                    Height="24" Width="24" Style="{StaticResource ResourceKey=ToggleButtonImageStyle}" />
                                                <TextBlock Text="{Binding LegalName}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </telerik:RadComboBox.ItemTemplate>
                                    <telerik:RadComboBox.SelectionBoxTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding LogoSmall}" 
                                                    Height="24" Width="24" Style="{StaticResource ResourceKey=ToggleButtonImageStyle}" />
                                                <TextBlock Text="Carrier" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"
                                                    Visibility="{Binding Source={StaticResource proxy}, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                                <TextBlock Text="All Carriers" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"
                                                    Visibility="{Binding Source={StaticResource proxy}, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </telerik:RadComboBox.SelectionBoxTemplate>
                                </telerik:RadComboBox>
                                <!-- Dispatch Carrier -->
                                <ToggleButton Name="bCarrier" Grid.Column="0" Grid.Row="1" Width="70"
                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderThickness="0"
                                    Focusable="False" Style="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                                    ToolTip="{Binding Data.SelectedCarrierCompany.LegalName, Source={StaticResource proxy}}"
                                    DataContext="{Binding BoardsSettings, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter={x:Static enums:BoardType.DispatchCarrier}}"
                                    IsChecked="{Binding Enabled, Mode=TwoWay}">
                                    Dispatch
                                </ToggleButton>
                                <!-- Carrier Accounting -->
                                <ToggleButton Name="bCarrierAccounting" Grid.Column="1" Grid.Row="1" Width="70"
                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Collapsed" BorderThickness="0"
                                    Focusable="False" Style="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                                    ToolTip="{Binding Data.SelectedCarrierCompany.LegalName, Source={StaticResource proxy}}"
                                    DataContext="{Binding BoardsSettings, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter={x:Static enums:BoardType.DispatchCarrierAccount}}"
                                    IsChecked="{Binding Enabled, Mode=TwoWay}">
                                    Accounting
                                </ToggleButton>
                                <!-- Carrier History -->
                                <ToggleButton Name="bCarrierHistory" Grid.Column="2" Grid.Row="1" Width="70"
                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Collapsed" BorderThickness="0"
                                    Focusable="False" Style="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                                    ToolTip="{Binding Data.SelectedCarrierCompany.LegalName, Source={StaticResource proxy}}"
                                    DataContext="{Binding BoardsSettings, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter={x:Static enums:BoardType.DispatchCarrierHistory}}"
                                    IsChecked="{Binding Enabled, Mode=TwoWay}">
                                    History
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <!-- Broker -->
                        <Border Name="brokerBorder" BorderThickness="1" BorderBrush="#FFC0C0C0" Padding="0" Margin="2,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <telerik:RadComboBox Grid.ColumnSpan="2"
                                    ClearSelectionButtonVisibility="Visible" ClearSelectionButtonContent="All Brokers" EmptyText="All Brokers"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    ItemsSource="{Binding BrokerCompanies}"
                                    SelectedItem="{Binding SelectedBrokerCompany, Mode=TwoWay}" 
                                    telerik:StyleManager.Theme="{StaticResource SummerTheme}"
                                    SelectionChanged="BrokerCompany_OnClicked">
                                    <telerik:RadComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding LogoSmall}" 
                                                    Height="24" Width="24" Style="{StaticResource ResourceKey=ToggleButtonImageStyle}" />
                                                <TextBlock Text="{Binding LegalName}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </telerik:RadComboBox.ItemTemplate>
                                    <telerik:RadComboBox.SelectionBoxTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding LogoSmall}" 
                                                    Height="24" Width="24" Style="{StaticResource ResourceKey=ToggleButtonImageStyle}" />
                                                <TextBlock Text="Broker" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"
                                                    Visibility="{Binding Source={StaticResource proxy}, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                                <TextBlock Text="All Brokers" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"
                                                    Visibility="{Binding Source={StaticResource proxy}, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </telerik:RadComboBox.SelectionBoxTemplate>
                                </telerik:RadComboBox>
                                <!-- Dispatch Broker -->
                                <ToggleButton Name="bBroker" Grid.Column="0" Grid.Row="1" Width="70"
                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderThickness="0"
                                    Focusable="False" Style="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                                    ToolTip="{Binding Data.SelectedBrokerCompany.LegalName, Source={StaticResource proxy}}"
                                    DataContext="{Binding BoardsSettings, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter={x:Static enums:BoardType.DispatchBroker}}"
                                    IsChecked="{Binding Enabled, Mode=TwoWay}">
                                    Dispatch
                                </ToggleButton>
                                <!-- Broker Accounting -->
                                <ToggleButton Name="bBrokerAccounting" Grid.Column="1" Grid.Row="1" Width="70"
                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Collapsed" BorderThickness="0"
                                    Focusable="False" Style="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                                    ToolTip="{Binding Data.SelectedBrokerCompany.LegalName, Source={StaticResource proxy}}"
                                    DataContext="{Binding BoardsSettings, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter={x:Static enums:BoardType.DispatchBrokerAccount}}"
                                    IsChecked="{Binding Enabled, Mode=TwoWay}">
                                    Accounting
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <telerik:RadToolBarSeparator Name="separator2" />
                        <!-- Debug -->
                        <Button x:Name="btnDebug" Click="btnDebug_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" >
                            <StackPanel>
                                <telerik:RadProgressBar Width="60" Height="32" IsIndeterminate="True" 
                                     telerik:StyleManager.Theme="{StaticResource MaterialTheme}">
                                </telerik:RadProgressBar>
                                <TextBlock HorizontalAlignment="Center">Debug</TextBlock>
                            </StackPanel>
                        </Button>
                        <!-- V1: Blacklist, Favorites, Dynamic/Classic View (модуль AutoCall) и Save Columns (дефолты компании, решено 2026-11-17) — не перенесены -->
                        <!-- Reset Columns -->
                        <Button x:Name="btnResetColumns" Click="btnResetColumns_Click" Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                            Visibility="{Binding Data.Expanded, Converter={StaticResource BooleanToVisibilityConverter}, Source={StaticResource proxy}}">
                            <StackPanel>
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/tab_panel_load.png" Style="{StaticResource ResourceKey=ToggleButtonImageStyle}"></uc:AutoGreyableImage>
                                <TextBlock>Reset Columns</TextBlock>
                            </StackPanel>
                        </Button>
                        <!--Settings -->
                        <Button x:Name="btnSettings" 
                            Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                            Click="btnSettings_Click">
                            <StackPanel>
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/settings.png" Style="{StaticResource ResourceKey=ToggleButtonImageStyle}"></uc:AutoGreyableImage>
                                <TextBlock HorizontalAlignment="Center" Margin="3">Settings</TextBlock>
                            </StackPanel>
                        </Button>
                        <!-- V1: Data Sources (учётки DAT/Truckstop, модуль AutoCall) — не перенесено -->
                        <telerik:RadToolBarSeparator />
                        <!-- Scan Scheme -->
                        <Button x:Name="btnScanScheme" Visibility="Collapsed"
                            Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                            Click="btnScanScheme_Click">
                            <StackPanel>
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/scanner-pdf.png" Style="{StaticResource ResourceKey=ToggleButtonImageStyle}"></uc:AutoGreyableImage>
                                <TextBlock HorizontalAlignment="Center" Margin="3">Scan Scheme</TextBlock>
                            </StackPanel>
                        </Button>
                        <!-- Scan Bill -->
                        <Button x:Name="btnScanBill" Visibility="Collapsed"
                            Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                            Click="btnScanBill_Click">
                            <StackPanel>
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/scanner-jpg.png" Style="{StaticResource ResourceKey=ToggleButtonImageStyle}"></uc:AutoGreyableImage>
                                <TextBlock HorizontalAlignment="Center" Margin="3">Scan Bill</TextBlock>
                            </StackPanel>
                        </Button>
                        <!-- Expand -->
                        <Button x:Name="btnExpand"
                            Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                            VerticalAlignment="Stretch"
                            Click="btnExpand_Click">
                            <StackPanel>
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/arrow_left.png" 
                                    Visibility="{Binding Expanded, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                    Width="16" Height="32"
                                    RenderOptions.BitmapScalingMode="Fant"
                                    Stretch="Uniform"/>
                                <uc:AutoGreyableImage Source="/AutoDispatch;component/Resources/arrow_right.png" 
                                    Visibility="{Binding Expanded, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" 
                                    Width="16" Height="32"
                                    RenderOptions.BitmapScalingMode="Fant"
                                    Stretch="Uniform"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <Canvas Name="canvasTotal" HorizontalAlignment="Right" VerticalAlignment="Top" Width="200" Height="30"
                        Visibility="Collapsed">
                        <!-- goal -->
                        <TextBlock Text="Goal" Padding="2,0" FontWeight="Bold"
                            Canvas.Right="0" Canvas.Top="15"
                            Foreground="Gray" />
                        <!-- labels -->
                        <TextBlock Text="15" Padding="2,0" FontWeight="Bold"
                            Canvas.Left="150" Canvas.Top="0"
                            Foreground="Black" Background="LimeGreen" />
                        <TextBlock Text="10" Padding="2,0" FontWeight="Bold"
                            Canvas.Left="100" Canvas.Top="0"
                            Foreground="White" Background="DodgerBlue" />
                        <TextBlock Text="5" Padding="2,0" FontWeight="Bold"
                            Canvas.Left="50" Canvas.Top="0"
                            Foreground="Black" Background="Yellow" />
                        <TextBlock Text="0" Padding="2,0" FontWeight="Bold"
                            Canvas.Left="0" Canvas.Top="0"
                            Foreground="White" Background="Red" />
                        <!-- ruler -->
                        <Line Panel.ZIndex="1"
                            X1="0" Y1="15"
                            X2="200" Y2="15"
                            Stroke="Gray"
                            StrokeThickness="2" />
                        <Line
                            X1="0" Y1="00"
                            X2="0" Y2="30"
                            Stroke="Gray"
                            StrokeThickness="2" />
                        <Line
                            X1="50" Y1="00"
                            X2="50" Y2="30"
                            Stroke="Gray"
                            StrokeThickness="2" />
                        <Line
                            X1="100" Y1="00"
                            X2="100" Y2="30"
                            Stroke="Gray"
                            StrokeThickness="2" />
                        <Line
                            X1="150" Y1="00"
                            X2="150" Y2="30"
                            Stroke="Gray"
                            StrokeThickness="2" />
                        <Line
                            X1="200" Y1="00"
                            X2="200" Y2="30"
                            Stroke="Gray"
                            StrokeThickness="2" />
                        <!-- total -->
                        <TextBlock Padding="2,0" FontWeight="Bold" 
                            Visibility="{Binding Total, Converter={StaticResource NotNullToVisibilityConverter}}"
                            Canvas.Right="{Binding Total, Converter={StaticResource BookedRulerToTotalXRightConverter}}" Canvas.Top="15"
                            Foreground="{Binding Total, Converter={StaticResource BookedRulerToForegroundConverter}}" 
                            Background="{Binding Total, Converter={StaticResource BookedRulerToBackgroundConverter}}" >
                            <Run>Booked</Run>
                            <Run Text="{Binding Total}"/>
                        </TextBlock>
                        <!-- carriage -->
                        <Line Panel.ZIndex="1" 
                            Visibility="{Binding Total, Converter={StaticResource NotNullToVisibilityConverter}}"
                            X1="{Binding Total, Converter={StaticResource BookedRulerToCarriageXConverter}}" Y1="00"
                            X2="{Binding Total, Converter={StaticResource BookedRulerToCarriageXConverter}}" Y2="30"
                            Stroke="Black"
                            StrokeThickness="2" />
                        <Line Panel.ZIndex="1" 
                            Visibility="{Binding Total, Converter={StaticResource NotNullToVisibilityConverter}}"
                            X1="{Binding Total, Converter={StaticResource BookedRulerToCarriageXLeftConverter}}" Y1="0"
                            X2="{Binding Total, Converter={StaticResource BookedRulerToCarriageXRightConverter}}" Y2="0"
                            Stroke="Black"
                            StrokeThickness="2" />
                        <Line Panel.ZIndex="1" 
                            Visibility="{Binding Total, Converter={StaticResource NotNullToVisibilityConverter}}"
                            X1="{Binding Total, Converter={StaticResource BookedRulerToCarriageXLeftConverter}}" Y1="30"
                            X2="{Binding Total, Converter={StaticResource BookedRulerToCarriageXRightConverter}}" Y2="30"
                            Stroke="Black"
                            StrokeThickness="2" />
                    </Canvas>
                </Grid>
            </Border>
            <!--Loading board-->
            <uc:LoadingControl Grid.Row="1"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                LoadingMessage="Loading data..."
                Panel.ZIndex="100" />
            <telerik:RadDocking x:Name="gridBoards" Grid.Row="1" CustomElementLoading="RadDocking_CustomElementLoading">
                <telerik:RadDocking.RootCompassStyle>
                    <Style TargetType="{x:Type telerik:RootCompass}">
                        <Setter Property="IsLeftIndicatorVisible" Value="false" />
                        <Setter Property="IsTopIndicatorVisible" Value="false" />
                        <Setter Property="IsRightIndicatorVisible" Value="false" />
                        <Setter Property="IsBottomIndicatorVisible" Value="false" />
                    </Style>
                </telerik:RadDocking.RootCompassStyle>
                <telerik:RadDocking.DocumentHost>
                    <telerik:RadSplitContainer>
                        <telerik:RadPaneGroup x:Name="DocumentGroup" IsContentPreserved="True">
                            <!--<telerik:RadPane Style="{DynamicResource RadPaneStyle1}"/> for debug-->
                        </telerik:RadPaneGroup>
                    </telerik:RadSplitContainer>
                </telerik:RadDocking.DocumentHost>
            </telerik:RadDocking>
            <!-- V1: панель входящего звонка (сигнал давал только BriaCallService, не перенесён) — удалена, аудит E2 -->
        </Grid>
        <!-- V1: громкость звука уведомлений (VolumeButton, VolumePopup) — уведомления DAT модуля AutoCall, не перенесено -->
    </Grid>
</dialogs:SingleInstanceWindow>
