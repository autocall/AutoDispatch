                                                        <ContentPresenter ContentTemplate="{TemplateBinding HeaderTemplate}" Content="{TemplateBinding Header}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                    </Border>
                                                </Border>
                                                <Grid x:Name="WeekHeaders" Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="7*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="6*"/>
                                                    </Grid.RowDefinitions>
                                                    <Border x:Name="VerticalOuterBorder" BorderBrush="Transparent" BorderThickness="0" Margin="0,1,-2,0" Grid.RowSpan="2" Panel.ZIndex="0">
                                                        <Border.Visibility>
                                                            <Binding Path="HideColumn" RelativeSource="{RelativeSource TemplatedParent}">
                                                                <Binding.Converter>
                                                                    <telerik:InvertedBooleanToVisibilityConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Border.Visibility>
                                                    </Border>
                                                    <Border x:Name="HorizontalOuterBorder" BorderBrush="White" BorderThickness="0,0,0,1" Grid.ColumnSpan="2" Margin="1,1,1,-1" Panel.ZIndex="3">
                                                        <Border.Visibility>
                                                            <Binding Path="HideRow" RelativeSource="{RelativeSource TemplatedParent}">
                                                                <Binding.Converter>
                                                                    <telerik:InvertedBooleanToVisibilityConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Border.Visibility>
                                                    </Border>
                                                    <Border x:Name="VerticalInnerBorder" BorderBrush="Transparent" BorderThickness="0" Margin="0,1,-2,0" Grid.RowSpan="2" Panel.ZIndex="0">
