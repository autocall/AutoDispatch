                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Border.Visibility>
                                                    </Border>
                                                    <Border x:Name="HorizontalInnerBorder" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Grid.ColumnSpan="2" Margin="1,1,1,0" Panel.ZIndex="3">
                                                        <Border.Visibility>
                                                            <Binding Path="HideRow" RelativeSource="{RelativeSource TemplatedParent}">
                                                                <Binding.Converter>
                                                                    <telerik:InvertedBooleanToVisibilityConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Border.Visibility>
                                                    </Border>
                                                    <Rectangle x:Name="VerticalBackground" Fill="#FFE7EBF6" Margin="1,1,-1,1" Grid.RowSpan="2" Panel.ZIndex="2">
                                                        <Rectangle.Visibility>
                                                            <Binding Path="HideColumn" RelativeSource="{RelativeSource TemplatedParent}">
                                                                <Binding.Converter>
                                                                    <telerik:InvertedBooleanToVisibilityConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Rectangle.Visibility>
                                                    </Rectangle>
                                                    <Rectangle x:Name="HorizontalBackground" Grid.ColumnSpan="2" Fill="White" Margin="1" Panel.ZIndex="1">
                                                        <Rectangle.Visibility>
                                                            <Binding Path="HideRow" RelativeSource="{RelativeSource TemplatedParent}">
                                                                <Binding.Converter>
                                                                    <telerik:InvertedBooleanToVisibilityConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Rectangle.Visibility>
                                                    </Rectangle>
                                                </Grid>
                                                <ItemsPresenter Margin="2,1,1,1" Grid.Row="1"/>
                                                <Border x:Name="BorderBrush" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Grid.RowSpan="2"/>
                                                <Rectangle x:Name="MinDesiredSize" Height="155" Grid.Row="1" Width="240"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
