    </Style>
    -->
    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style TargetType="userControls1:ContactsControl">
        <Setter Property="Margin" Value="5"/>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Margin" Value="5"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Value="#F4F4F4" Property="Background" />
                <Setter Value="#ADB2B5" Property="BorderBrush" />
                <Setter Value="#ADB2B5" Property="Foreground" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="True">
                <Setter Value="{StaticResource borderControlBrush}" Property="BorderBrush" />
            </Trigger>
        </Style.Triggers>
    </Style>
