    <Page Remove="Dialogs\Dispatch\_UserControls\PhoneControl.xaml;Dialogs\Dispatch\LoadSplit\LoadAddDestinationDialog.xaml;UserControls\ContactsControl.xaml" />
    <None Include="Dialogs\Dispatch\_UserControls\PhoneControl.xaml;Dialogs\Dispatch\_UserControls\PhoneControl.xaml.cs;Dialogs\Dispatch\LoadSplit\LoadAddDestinationDialog.xaml;Dialogs\Dispatch\LoadSplit\LoadAddDestinationDialog.xaml.cs;UserControls\ContactsControl.xaml;UserControls\ContactsControl.xaml.cs" />
