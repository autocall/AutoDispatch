    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AutoDispatch</AssemblyName>
    <RootNamespace>AutoCall.WPF</RootNamespace>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <StartupObject>AutoCall.WPF.App</StartupObject>
    <!-- WFO1000 — свойства WinForms без DesignerSerializationVisibility (код V1) -->
    <NoWarn>$(NoWarn);WFO1000;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Не входили в сборку V1 (нет в AutoCall.WPF.csproj): лежат как в V1, не компилируются -->
