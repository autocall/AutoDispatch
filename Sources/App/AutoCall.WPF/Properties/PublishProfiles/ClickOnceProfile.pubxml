<?xml version="1.0" encoding="utf-8"?>
<!-- ClickOnce AutoDispatch App — копия профиля AutoCall V3 (AutoCall.View). Публикация — Scripts/publish-autodispatch-app.ps1,
     раздача — /Download контейнера autodispatch.web (https://dispatch.myautocall.net/Download/). Сертификат подписи манифестов —
     тот же, что у AutoCall V3 (CN=AutoCall, до 2126): .pfx скопирован из AutoCallV3 Sources/App/AutoCall.View, в .gitignore;
     для подписи нужен в хранилище CurrentUser\My. https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.*</ApplicationVersion>
    <BootstrapperEnabled>True</BootstrapperEnabled>
    <Configuration>Release</Configuration>
    <CreateWebPageOnPublish>True</CreateWebPageOnPublish>
    <GenerateManifests>true</GenerateManifests>
    <Install>True</Install>
    <InstallFrom>Web</InstallFrom>
    <InstallUrl>https://dispatch.myautocall.net/Download/</InstallUrl>
    <IsRevisionIncremented>True</IsRevisionIncremented>
    <IsWebBootstrapper>True</IsWebBootstrapper>
    <ManifestCertificateThumbprint>F3C16FA50C0C8E48471C7D32B7CF0C2F9D4FFF9E</ManifestCertificateThumbprint>
    <ManifestKeyFile>AutoCall.Publish_3_TemporaryKey.pfx</ManifestKeyFile>
    <MapFileExtensions>True</MapFileExtensions>
    <OpenBrowserOnPublish>False</OpenBrowserOnPublish>
    <Platform>x86</Platform>
    <PublishDir>bin\Release\net10.0-windows\app.publish\</PublishDir>
    <PublishUrl>D:\Publish\AutoDispatch_Publish\</PublishUrl>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishSingleFile>False</PublishSingleFile>
    <SelfContained>False</SelfContained>
    <SignatureAlgorithm>sha1RSA</SignatureAlgorithm>
    <SignManifests>True</SignManifests>
    <SkipPublishVerification>false</SkipPublishVerification>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UpdateEnabled>True</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>True</UpdateRequired>
    <WebPageFileName>Publish.html</WebPageFileName>
    <ProductName>AutoDispatch</ProductName>
    <PublisherName>Solfinity</PublisherName>
    <SupportUrl>https://dispatch.myautocall.net</SupportUrl>
    <TargetCulture>en-US</TargetCulture>
    <CreateDesktopShortcut>True</CreateDesktopShortcut>
    <MinimumRequiredVersion>1.0.0.0</MinimumRequiredVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- App x86 (PlatformTarget, TwainDotNet и Abto SIPVoipSDK — 32-битные) — рантайм x86 -->
    <BootstrapperPackage Include="Microsoft.NetCore.DesktopRuntime.10.0.x86">
      <Install>true</Install>
      <ProductName>.NET Desktop Runtime 10.0 (x86)</ProductName>
    </BootstrapperPackage>
  </ItemGroup>
</Project>
