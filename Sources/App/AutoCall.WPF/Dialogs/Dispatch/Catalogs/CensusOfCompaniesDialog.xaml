<Window x:Class="AutoCall.WPF.Dialogs.Dispatch.CensusOfCompaniesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:core="clr-namespace:AutoCall.WPF.Core"
        xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
        xmlns:userControls="clr-namespace:AutoCall.WPF.Dialogs.Dispatch.UserControls"
        xmlns:enums="clr-namespace:AutoDispatch.Dtos.Enums;assembly=AutoDispatch.Dtos"
        mc:Ignorable="d" 
        d:DesignHeight="450" d:DesignWidth="800"
        Icon="/AutoDispatch;component/Resources/icon.ico" 
        WindowStartupLocation="CenterScreen"
        Height="650" SizeToContent="Width"
        Background="{x:Static SystemColors.ControlBrush}">
    <!-- Resources -->
    <Window.Resources>
        <!-- Converters -->
        <converters:StringToPhoneConverter x:Key="StringToPhoneConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:CompareToVisibilityConverter x:Key="CompareToVisibilityConverter"/>
        <converters:CompareConverter x:Key="CompareConverter"/>
        <!-- Proxy -->
        <core:BindingProxy x:Key="proxy" Data="{Binding}"/>
        <Style x:Key="ColumnHeaderGripperStyle" TargetType="Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContentControl" x:Key="StretchedContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <telerik:SortingIndexConverter x:Key="SortingIndexConverter"/>
        <telerik:SortingIndexToVisibilityConverter x:Key="SortingIndexToVisibilityConverter"/>
        <SolidColorBrush x:Key="GridView_HeaderForeground_Selected" Color="Black"/>
        <SolidColorBrush x:Key="GridView_HeaderInnerBorder" Color="#FF4B4B4B"/>
        <LinearGradientBrush x:Key="GridView_HeaderOuterBorder_Selected" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF616161" Offset="0"/>
            <GradientStop Color="#FF989898" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GridView_HeaderInnerBorder_Selected" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFB69A78"/>
            <GradientStop Color="#FFFFE17A" Offset="0.126"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GridView_HeaderBackground_Selected" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFFFD74E" Offset="0.996"/>
            <GradientStop Color="#FFFFDCAB" Offset="0.17"/>
            <GradientStop Color="#FFFFB062" Offset="0.57"/>
            <GradientStop Color="#FFFFD18F" Offset="0.56"/>
            <GradientStop Color="#FFFFBA74"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GridView_SortIndicatorColor" Color="Black"/>
        <ControlTemplate x:Key="GridViewHeaderCellTemplate" TargetType="telerik:GridViewHeaderCell">
            <Grid x:Name="PART_OuterGrid">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualStateGroup.Transitions>
                            <VisualTransition GeneratedDuration="00:00:00.2000000" To="Normal"/>
                            <VisualTransition GeneratedDuration="00:00:00.2000000" To="MouseOver"/>
                        </VisualStateGroup.Transitions>
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="MouseOver">
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="GridViewHeaderCell_Over" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                </DoubleAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{StaticResource GridView_HeaderForeground_Selected}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Ascending">
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{StaticResource GridView_HeaderForeground_Selected}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_SortIndicator" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GridViewHeaderCell_Selected" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Descending">
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{StaticResource GridView_HeaderForeground_Selected}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_SortIndicator" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                </DoubleAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_SortIndicator" Storyboard.TargetProperty="RenderTransform">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="-1"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GridViewHeaderCell_Selected" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="PART_HeaderCellGrid" MinHeight="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="GridViewHeaderCell" Grid.ColumnSpan="2" Margin="1 0 0 0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Border BorderBrush="{StaticResource GridView_HeaderInnerBorder}" Background="{TemplateBinding Background}" BorderThickness="1"/>
                    </Border>
                    <!--<Border x:Name="GridViewHeaderCell_Over"
                        Grid.ColumnSpan="2"
                        BorderBrush="{StaticResource GridView_HeaderOuterBorder_Over}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Opacity="0">
                        <Border BorderBrush="{StaticResource GridView_HeaderInnerBorder_Over}" Background="{StaticResource GridView_HeaderBackground_Over}" BorderThickness="1"/>
                    </Border>-->
                    <Border x:Name="GridViewHeaderCell_Selected"
                        Grid.ColumnSpan="2"
                        BorderBrush="{StaticResource GridView_HeaderOuterBorder_Selected}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Opacity="0">
                        <Border BorderBrush="{StaticResource GridView_HeaderInnerBorder_Selected}" Background="{StaticResource GridView_HeaderBackground_Selected}" BorderThickness="1"/>
                    </Border>
                    <ContentControl x:Name="ContentPresenter"
                        Grid.Column="0"
                        Foreground="{TemplateBinding Foreground}"
                        Style="{StaticResource StretchedContentControl}"
                        Margin="{TemplateBinding Padding}"
                        IsTabStop="{TemplateBinding IsTabStop}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    <Path x:Name="PART_SortIndicator"
                        Grid.ColumnSpan="2"
                        Fill="{StaticResource GridView_SortIndicatorColor}"
                        Stretch="Fill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0 3 0 0"
                        Data="M256,328 L248,336 264,336"
                        Width="5"
                        Height="3"
                        RenderTransformOrigin=".5,.5"
                        Opacity="0"
                        SnapsToDevicePixels="True">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <SkewTransform AngleX="0" AngleY="0"/>
                                <RotateTransform Angle="0"/>
                                <TranslateTransform X="0" Y="0"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                    <ContentControl
                        Content="{Binding SortingIndex, Converter={StaticResource SortingIndexConverter},RelativeSource={RelativeSource TemplatedParent}}"
                        Visibility="{Binding SortingIndex, Converter={StaticResource SortingIndexToVisibilityConverter},RelativeSource={RelativeSource TemplatedParent}}"
                        Grid.ColumnSpan="2"
                        FontSize="7"
                        IsTabStop="{TemplateBinding IsTabStop}"
                        Foreground="{StaticResource GridView_SortIndicatorColor}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="14,0,0,0"/>
                    <telerik:FilteringDropDown x:Name="PART_DistinctFilterControl" Grid.Column="1" Visibility="{TemplateBinding FilteringUIVisibility}" Margin="0 0 4 0"/>
                    <Thumb x:Name="PART_LeftHeaderGripper"
                        
                        IsTabStop="{TemplateBinding IsTabStop}"
                        Style="{StaticResource ColumnHeaderGripperStyle}"
                        Grid.ColumnSpan="2"/>
                    <Thumb x:Name="PART_RightHeaderGripper"
                        HorizontalAlignment="Right"
                        IsTabStop="{TemplateBinding IsTabStop}"
                        Style="{StaticResource ColumnHeaderGripperStyle}"
                        Grid.ColumnSpan="2"/>
                </Grid>
                <telerik:FieldFilterControl x:Name="PART_FieldFilterControl" Visibility="{TemplateBinding FieldFilterControlVisibility}" Grid.Row="1"/>
            </Grid>
        </ControlTemplate>
        <Style TargetType="telerik:GridViewHeaderCell">
            <Setter Property="Template" Value="{StaticResource GridViewHeaderCellTemplate}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <telerik:RadGridView Grid.Row="1"
            Name="gridCompanies"
            AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
            ShowGroupPanel="False" AutoExpandGroups="False" IsFilteringAllowed="False"
            RowIndicatorVisibility="Collapsed" IsTabStop="False"
            CanUserReorderColumns="False" CanUserFreezeColumns="False" IsReadOnly="True" CanUserSortColumns="False"
            ShowColumnFooters="False" ShowGroupFooters="False"
            MouseDoubleClick="gridCompanies_OnMouseDoubleClick"
            MouseRightButtonDown="gridCompanies_MouseRightButtonDown"
            ItemsSource="{Binding Companies}"
            Background="{x:Static SystemColors.ControlBrush}">
            <telerik:RadGridView.Resources>
                <telerik:RadContextMenu x:Key="rowContextMenu">
                    <telerik:RadMenuItem Header="Create or Edit Broker" Click="CreateBroker_OnClick" Visibility="{Binding Data.CompanyType, Source={StaticResource proxy}, Converter={StaticResource CompareToVisibilityConverter}, ConverterParameter={x:Static enums:DatCompanyType.Broker}}"/>
                    <telerik:RadMenuItem Header="Create or Edit Carrier" Click="CreateCarrier_OnClick" Visibility="{Binding Data.CompanyType, Source={StaticResource proxy}, Converter={StaticResource CompareToVisibilityConverter}, ConverterParameter={x:Static enums:DatCompanyType.Carrier}}"/>
                    <!--<telerik:RadMenuItem Header="Add Comment" Click="AddComment_OnClick"/>-->
                </telerik:RadContextMenu>
            </telerik:RadGridView.Resources>
            <telerik:RadGridView.Columns>
                <telerik:GridViewImageColumn DataMemberBinding="{Binding LogoSmall}" ImageWidth="20" ImageHeight="20" Header=""/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding DOT_NUMBER}" Width="75">
                    <telerik:GridViewDataColumn.Header>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="DOT#" Margin="4,5"/>
                            <telerik:RadWatermarkTextBox WatermarkContent="DOT#" Text="{Binding Data.Search.DOT_NUMBER, TargetNullValue='', Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4" />
                        </StackPanel>
                    </telerik:GridViewDataColumn.Header>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding McNumber}" Width="75">
                    <telerik:GridViewDataColumn.Header>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="MC#" Margin="4,5"/>
                            <telerik:RadWatermarkTextBox WatermarkContent="MC#" Text="{Binding Data.Search.ICC, TargetNullValue='', Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4" />
                        </StackPanel>
                    </telerik:GridViewDataColumn.Header>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding NAME}" Width="180">
                    <telerik:GridViewDataColumn.Header>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Name" Margin="4,5"/>
                            <telerik:RadWatermarkTextBox WatermarkContent="Name" Text="{Binding Data.Search.NAME, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4" />
                        </StackPanel>
                    </telerik:GridViewDataColumn.Header>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding PhysicalAddress}" Width="220">
                    <telerik:GridViewDataColumn.Header>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Physical Address" Margin="4,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <telerik:RadWatermarkTextBox WatermarkContent="Street" Grid.Column="0" Text="{Binding Data.Search.PHY_STR, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4" />
                                <telerik:RadWatermarkTextBox WatermarkContent="City" Grid.Column="1" Text="{Binding Data.Search.PHY_CITY, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4" />
                                <telerik:RadWatermarkTextBox WatermarkContent="State" Grid.Column="2" Text="{Binding Data.Search.PHY_ST, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4" />
                            </Grid>
                        </StackPanel>
                    </telerik:GridViewDataColumn.Header>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding MailingAddress}" Width="220">
                    <telerik:GridViewDataColumn.Header>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Mailing Address" Margin="4,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <telerik:RadWatermarkTextBox IsEnabled="False" Background="LightGray" WatermarkContent="Street" Grid.Column="0" Text="{Binding Data.Search.MAI_STR, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4" />
                                <telerik:RadWatermarkTextBox IsEnabled="False" Background="LightGray" WatermarkContent="City" Grid.Column="1" Text="{Binding Data.Search.MAI_CITY, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4" />
                                <telerik:RadWatermarkTextBox IsEnabled="False" Background="LightGray" WatermarkContent="State" Grid.Column="2" Text="{Binding Data.Search.MAI_ST, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4"/>
                            </Grid>
                        </StackPanel>
                    </telerik:GridViewDataColumn.Header>
                </telerik:GridViewDataColumn>
                <userControls:GridViewPhoneColumn DataMemberBinding="{Binding TEL_NUM, Converter={StaticResource StringToPhoneConverter}}" Width="100">
                    <userControls:GridViewPhoneColumn.Header>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Phone" Margin="4,5"/>
                            <telerik:RadWatermarkTextBox WatermarkContent="Phone" Text="{Binding Data.Search.TEL_NUM, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4" />
                        </StackPanel>
                    </userControls:GridViewPhoneColumn.Header>
                </userControls:GridViewPhoneColumn>
                <userControls:GridViewPhoneColumn DataMemberBinding="{Binding CELL_NUM, Converter={StaticResource StringToPhoneConverter}}" Width="100">
                    <userControls:GridViewPhoneColumn.Header>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Cell Phone" Margin="4,5"/>
                            <telerik:RadWatermarkTextBox IsEnabled="False" Background="LightGray" WatermarkContent="Cell Phone" Text="{Binding Data.Search.CELL_NUM, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4" />
                        </StackPanel>
                    </userControls:GridViewPhoneColumn.Header>
                </userControls:GridViewPhoneColumn>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding COMPANY_REP1}" Width="120">
                    <telerik:GridViewDataColumn.Header>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Officer" Margin="4,5"/>
                            <telerik:RadWatermarkTextBox IsEnabled="False" Background="LightGray" WatermarkContent="Officer" Text="{Binding Data.Search.COMPANY_REP1, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4" />
                        </StackPanel>
                    </telerik:GridViewDataColumn.Header>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding EMAILADDRESS}" Width="150">
                    <telerik:GridViewDataColumn.Header>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Email" Margin="4,5"/>
                            <telerik:RadWatermarkTextBox IsEnabled="False" Background="LightGray" WatermarkContent="Email" Text="{Binding Data.Search.EMAILADDRESS, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4" />
                        </StackPanel>
                    </telerik:GridViewDataColumn.Header>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding TOT_PWR}" Width="80" Name="totPwdColumn" IsVisible="{Binding Data.CompanyType, Converter={StaticResource CompareConverter}, ConverterParameter={x:Static enums:DatCompanyType.Carrier}, Source={StaticResource proxy}}">
                    <telerik:GridViewDataColumn.Header>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Total Powers" Margin="4,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <telerik:RadWatermarkTextBox IsEnabled="False" Background="LightGray" WatermarkContent="Min" Grid.Column="0" Text="{Binding Data.Search.TOT_PWR_MIN, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4"/>
                                <telerik:RadWatermarkTextBox IsEnabled="False" Background="LightGray" WatermarkContent="Max" Grid.Column="1" Text="{Binding Data.Search.TOT_PWR_MAX, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4"/>
                            </Grid>
                        </StackPanel>
                    </telerik:GridViewDataColumn.Header>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding TOT_DRS}" Width="80" Name="totDrsColumn" IsVisible="{Binding Data.CompanyType, Converter={StaticResource CompareConverter}, ConverterParameter={x:Static enums:DatCompanyType.Carrier}, Source={StaticResource proxy}}">
                    <telerik:GridViewDataColumn.Header>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Total Drivers" Margin="4,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <telerik:RadWatermarkTextBox IsEnabled="False" Background="LightGray" WatermarkContent="Min" Grid.Column="0" Text="{Binding Data.Search.TOT_DRS_MIN, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4"/>
                                <telerik:RadWatermarkTextBox IsEnabled="False" Background="LightGray" WatermarkContent="Max" Grid.Column="1" Text="{Binding Data.Search.TOT_DRS_MAX, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4"/>
                            </Grid>
                        </StackPanel>
                    </telerik:GridViewDataColumn.Header>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding RATING}" Width="50" Name="ratingColumn" IsVisible="{Binding Data.CompanyType, Converter={StaticResource CompareConverter}, ConverterParameter={x:Static enums:DatCompanyType.Carrier}, Source={StaticResource proxy}}">
                    <telerik:GridViewDataColumn.Header>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Rating" Margin="4,5"/>
                            <telerik:RadWatermarkTextBox IsEnabled="False" Background="LightGray" WatermarkContent="Rating" Text="{Binding Data.Search.RATING, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_TextChanged" Margin="0,4,4,4" />
                        </StackPanel>
                    </telerik:GridViewDataColumn.Header>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="Broker&#x0d;&#x0a;Registration" HeaderTextAlignment="Center" IsVisible="{Binding Data.CompanyType, Converter={StaticResource CompareConverter}, ConverterParameter={x:Static enums:DatCompanyType.Broker}, Source={StaticResource proxy}}">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Hyperlink Click="CarrierRegistration_Click" Focusable="False">
                                    <Run Text="link"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="Carrier&#x0d;&#x0a;Registration" HeaderTextAlignment="Center" IsVisible="{Binding Data.CompanyType, Converter={StaticResource CompareConverter}, ConverterParameter={x:Static enums:DatCompanyType.Carrier}, Source={StaticResource proxy}}">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Hyperlink Click="CarrierRegistration_Click" Focusable="False">
                                    <Run Text="link"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="Carrier&#x0d;&#x0a;Overview" HeaderTextAlignment="Center" IsVisible="{Binding Data.CompanyType, Converter={StaticResource CompareConverter}, ConverterParameter={x:Static enums:DatCompanyType.Carrier}, Source={StaticResource proxy}}">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Hyperlink Click="CarrierOverview_Click" Focusable="False">
                                    <Run Text="link"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="Company&#x0d;&#x0a;Snapshot" HeaderTextAlignment="Center" IsVisible="{Binding Data.CompanyType, Converter={StaticResource CompareConverter}, ConverterParameter={x:Static enums:DatCompanyType.Carrier}, Source={StaticResource proxy}}">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Hyperlink Click="CompanySnapshot_Click" Focusable="False">
                                    <Run Text="link"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
            </telerik:RadGridView.Columns>
            <telerik:RadGridView.RowStyle>
                <Style TargetType="{x:Type telerik:GridViewRow}" BasedOn="{StaticResource GridViewRowStyle2}">
                    <Setter Property="telerik:RadContextMenu.ContextMenu" Value="{StaticResource rowContextMenu}"/>
                </Style>
            </telerik:RadGridView.RowStyle>
        </telerik:RadGridView>
        <telerik:RadBusyIndicator Grid.Row="1" Name="loadingBi" IsBusy="{Binding Processing}" IsIndeterminate="True" telerik:StyleManager.Theme="{StaticResource Windows8Theme}" Width="Auto" Height="400"/>

        <Button x:Name="btnClose" Grid.Row="2" Style="{StaticResource CloseButtonStyle}" Click="btnClose_Clicked">Close</Button>
    </Grid>
</Window>
