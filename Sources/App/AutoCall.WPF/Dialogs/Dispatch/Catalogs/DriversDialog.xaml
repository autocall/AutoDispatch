<dialogs:BaseDispatchDialog 
    x:Class="AutoCall.WPF.Dialogs.Dispatch.DriversDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:userControls="clr-namespace:AutoCall.WPF.UserControls"
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:dialogs="clr-namespace:AutoCall.WPF.Dialogs"
    Title="Drivers" Height="600" Width="1160" 
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    WindowStartupLocation="CenterScreen"
    Background="{x:Static SystemColors.ControlBrush}"
    Loaded="DriversDialog_OnLoaded"
    Closed="DriversDialog_OnClosed">
    <dialogs:BaseDispatchDialog.Resources>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <converters:ExpirationConverter x:Key="ExpirationConverter"/>
        <converters:StringToPhoneConverter x:Key="StringToPhoneConverter"/>
    </dialogs:BaseDispatchDialog.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!--Loading control-->
        <userControls:LoadingControl x:Name="loadingDrivers" Panel.ZIndex="100" Visibility="Visible" Grid.Row="0" Grid.RowSpan="2" />

        <!--Toolbar-->
        <Border Grid.Row="0" BorderThickness="1,0" Margin="5,0" Background="{x:Static SystemColors.ControlBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <!--Add button-->
                    <Button
                        IsEnabled="True" Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="AddDriver_Clicked">
                        <StackPanel Orientation="Horizontal">
                            <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/add.png" Style="{StaticResource BoardButtonImageStyle}"></userControls:AutoGreyableImage>
                            <TextBlock VerticalAlignment="Center" Margin="3">Add</TextBlock>
                        </StackPanel>
                    </Button>
                    <!--Edit button-->
                    <Button
                        IsEnabled="True" Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="EditDriver_Clicked">
                        <StackPanel Orientation="Horizontal">
                            <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/edit.png" Style="{StaticResource BoardButtonImageStyle}"></userControls:AutoGreyableImage>
                            <TextBlock VerticalAlignment="Center" Margin="3">Edit</TextBlock>
                        </StackPanel>
                    </Button>
                    <!--Delete button-->
                    <Button
                        IsEnabled="True" Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="DeleteDriver_Clicked">
                        <StackPanel Orientation="Horizontal">
                            <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/delete.png" Style="{StaticResource BoardButtonImageStyle}"></userControls:AutoGreyableImage>
                            <TextBlock VerticalAlignment="Center" Margin="3">Delete</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock FontSize="12" FontWeight="Bold" Foreground="DimGray" HorizontalAlignment="Center" VerticalAlignment="Center" Text="DRIVERS"/>
                <TextBlock FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Hyperlink Click="NewDriverApplicationPackage_OnClick">
                        New Driver Application Package.pdf
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>

        <!--Drivers grid-->
        <telerik:RadGridView Grid.Row="1"
            Name="gridDrivers"
            AutoGenerateColumns="False" 
            SelectionMode="Single" SelectionUnit="FullRow"
            ShowGroupPanel="False" AutoExpandGroups="False" IsFilteringAllowed="False"
            RowIndicatorVisibility="Collapsed" IsTabStop="False"
            CanUserReorderColumns="True" CanUserFreezeColumns="False" IsReadOnly="True" CanUserSortColumns="True"
            ShowColumnFooters="False" ShowGroupFooters="False"
            Background="{x:Static SystemColors.ControlBrush}"
            ItemsSource="{Binding Drivers}">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="Name" DataMemberBinding="{Binding Name}" />
                <telerik:GridViewDataColumn Header="Phone" DataMemberBinding="{Binding Phone, Converter={StaticResource StringToPhoneConverter}}" />
                <telerik:GridViewDataColumn Header="Email" DataMemberBinding="{Binding Email}" />
                <telerik:GridViewComboBoxColumn Header="Trucks" DataMemberBinding="{Binding TruckId}" 
                    DisplayMemberPath="Number" SelectedValueMemberPath="EntityId" ItemsSource="{Binding Trucks}" />
                <telerik:GridViewDataColumn Header="THE APPLICATION OF EMPLOYMENT" Width="60" DataMemberBinding="{Binding THE_APPLICATION_OF_EMPLOYMENT_File}" >
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding THE_APPLICATION_OF_EMPLOYMENT_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_THE_APPLICATION_OF_EMPLOYMENT_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="MVR" Width="110" DataMemberBinding="{Binding MVR_File}" >
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding MVR_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_MVR_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                                <Run Text="{Binding MVR_Expiration, StringFormat=d}"/>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                    <telerik:GridViewDataColumn.CellStyle>
                        <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                            <Setter Property="Background" Value="{Binding MVR_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Background}}"/>
                            <Setter Property="Foreground" Value="{Binding MVR_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Foreground}}"/>
                            <Setter Property="FontWeight" Value="{Binding MVR_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.FontWeight}}"/>
                        </Style>
                    </telerik:GridViewDataColumn.CellStyle>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="MEDICAL CARD" Width="110" DataMemberBinding="{Binding MEDICAL_CARD_File}" >
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding MEDICAL_CARD_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_MEDICAL_CARD_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                                <Run Text="{Binding MEDICAL_CARD_Expiration, StringFormat=d}"/>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                    <telerik:GridViewDataColumn.CellStyle>
                        <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                            <Setter Property="Background" Value="{Binding MEDICAL_CARD_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Background}}"/>
                            <Setter Property="Foreground" Value="{Binding MEDICAL_CARD_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Foreground}}"/>
                            <Setter Property="FontWeight" Value="{Binding MEDICAL_CARD_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.FontWeight}}"/>
                        </Style>
                    </telerik:GridViewDataColumn.CellStyle>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="CDL" Width="110" DataMemberBinding="{Binding CDL_File}" >
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding CDL_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_CDL_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                                <Run Text="{Binding CDL_Expiration, StringFormat=d}"/>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                    <telerik:GridViewDataColumn.CellStyle>
                        <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                            <Setter Property="Background" Value="{Binding CDL_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Background}}"/>
                            <Setter Property="Foreground" Value="{Binding CDL_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Foreground}}"/>
                            <Setter Property="FontWeight" Value="{Binding CDL_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.FontWeight}}"/>
                        </Style>
                    </telerik:GridViewDataColumn.CellStyle>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="DOT INSPECTIONS" Width="60" DataMemberBinding="{Binding DOT_INSPECTIONS_File}" >
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding DOT_INSPECTIONS_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_DOT_INSPECTIONS_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="BACKGROUND" Width="60" DataMemberBinding="{Binding BACKGROUND_File}" >
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding BACKGROUND_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_BACKGROUND_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="DRUG_TEST" Width="60" DataMemberBinding="{Binding DRUG_TEST_File}" >
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding DRUG_TEST_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_DRUG_TEST_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="RANDOM_DRUG_TEST" Width="60" DataMemberBinding="{Binding RANDOM_DRUG_TEST_File}" >
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding RANDOM_DRUG_TEST_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_RANDOM_DRUG_TEST_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
            </telerik:RadGridView.Columns>
            <!-- Row Style -->
            <telerik:RadGridView.RowStyle>
                <Style TargetType="{x:Type telerik:GridViewRow}">
                    <EventSetter Event="MouseDoubleClick" Handler="gridDrivers_RowDoubleClick" />
                </Style>
            </telerik:RadGridView.RowStyle>
        </telerik:RadGridView>

        <!--Error message-->
        <TextBlock x:Name="tbError" Grid.Row="2" TextWrapping="Wrap" Margin="5" Foreground="Red" MaxHeight="80" HorizontalAlignment="Right" Visibility="Collapsed" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar" Grid.Row="2" Margin="10" IsIndeterminate="True" Height="10" Visibility="Collapsed" />

        <Button x:Name="btnOk" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource OkButtonStyle}" Visibility="Collapsed">OK</Button>
        <Button x:Name="btnClose" Grid.Row="3" Style="{StaticResource CloseButtonStyle}" Click="btnClose_Clicked">Close</Button>
    </Grid>
</dialogs:BaseDispatchDialog>



