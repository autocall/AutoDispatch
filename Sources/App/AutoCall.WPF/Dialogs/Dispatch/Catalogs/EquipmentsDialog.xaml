<dialogs:BaseDispatchDialog 
    x:Class="AutoCall.WPF.Dialogs.Dispatch.EquipmentsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:AutoCall.WPF.Helpers"
    xmlns:userControls="clr-namespace:AutoCall.WPF.UserControls"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    xmlns:dialogs="clr-namespace:AutoCall.WPF.Dialogs"
    xmlns:convertersDispatch="clr-namespace:AutoCall.WPF.Converters.Dispatch"
    Title="Equipments" Height="800"  Width="1200" 
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    WindowStartupLocation="CenterScreen"
    Background="{x:Static SystemColors.ControlBrush}"
    Loaded="EquipmentsDialog_OnLoaded"
    Closed="EquipmentsDialog_OnClosed">
    <dialogs:BaseDispatchDialog.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <converters:ExpirationConverter x:Key="ExpirationConverter"/>
        <convertersDispatch:DispatchBoard_DefectConverter x:Key="DefectConverter"/>
        <CollectionViewSource x:Key="WrappersViewSourceTruck" Source="{Binding Trucks}" IsLiveFilteringRequested="True" Filter="WrappersViewSourceTruck_OnFilter"/>
        <CollectionViewSource x:Key="WrappersViewSourceTrailer" Source="{Binding Trailers}" IsLiveFilteringRequested="True" Filter="WrappersViewSourceTrailer_OnFilter"/>
    </dialogs:BaseDispatchDialog.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="40" />
            <RowDefinition Height="4*" />
            <RowDefinition Height="Auto" MaxHeight="50"/>
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!--Loading control-->
        <userControls:LoadingControl x:Name="loadingTrucks" Panel.ZIndex="100" Visibility="Visible" Grid.Row="0" Grid.RowSpan="2" />

        <!--Toolbar-->
        <Border Grid.Row="0" BorderThickness="1,0" Margin="5,0" Background="{x:Static SystemColors.ControlBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <!--Create button-->
                    <Button
                        Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="CreateTruck_Clicked">
                        <StackPanel Orientation="Horizontal">
                            <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/add.png" Style="{StaticResource BoardButtonImageStyle}"></userControls:AutoGreyableImage>
                            <TextBlock VerticalAlignment="Center" Margin="3">Create</TextBlock>
                        </StackPanel>
                    </Button>
                    <!--Edit button-->
                    <Button
                        Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="EditTruck_Clicked">
                        <StackPanel Orientation="Horizontal">
                            <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/edit.png" Style="{StaticResource BoardButtonImageStyle}"></userControls:AutoGreyableImage>
                            <TextBlock VerticalAlignment="Center" Margin="3">Edit</TextBlock>
                        </StackPanel>
                    </Button>
                    <!--Delete button-->
                    <Button
                        Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="DeleteTruck_Clicked">
                        <StackPanel Orientation="Horizontal">
                            <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/delete.png" Style="{StaticResource BoardButtonImageStyle}"></userControls:AutoGreyableImage>
                            <TextBlock VerticalAlignment="Center" Margin="3">Delete</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.ColumnSpan="2" FontSize="12" FontWeight="Bold" Foreground="DimGray" HorizontalAlignment="Center" VerticalAlignment="Center" Text="TRUCKS"/>
                <!--Filter-->
                <telerik:RadWatermarkTextBox Name="tbSearchTruck"
                    Grid.Row="0" Grid.ColumnSpan="10" FontSize="12" 
                    HorizontalAlignment="Right" Width="120" Height="24" Margin="5"
                    WatermarkContent="Search"
                    Text="{Binding SearchTextTruck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="tbFilterTruck_OnTextChanged" />
            </Grid>
        </Border>

        <!--Trucks grid-->
        <telerik:RadGridView Grid.Row="1"
            Name="gridTrucks"
            AutoGenerateColumns="False" 
            SelectionMode="Single" SelectionUnit="FullRow"
            ShowGroupPanel="False" AutoExpandGroups="False" IsFilteringAllowed="False"
            RowIndicatorVisibility="Collapsed" IsTabStop="False"
            CanUserReorderColumns="True" CanUserFreezeColumns="False" IsReadOnly="True" CanUserSortColumns="True"
            ShowColumnFooters="False" ShowGroupFooters="False"
            MouseDoubleClick="gridTrucks_OnMouseDoubleClick"
            Background="{x:Static SystemColors.ControlBrush}"
            ItemsSource="{Binding Trucks}">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="Number" DataMemberBinding="{Binding Number}" />
                <telerik:GridViewDataColumn Header="Defect" DataMemberBinding="{Binding DefectsString}" >
                    <telerik:GridViewDataColumn.CellStyle>
                        <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                            <Setter Property="Background" Value="{Binding DefectsServiceNeeded, Converter={StaticResource DefectConverter}, ConverterParameter={x:Static convertersDispatch:FileExistsConverterParameter.Background}}"/>
                            <Setter Property="Foreground" Value="{Binding DefectsServiceNeeded, Converter={StaticResource DefectConverter}, ConverterParameter={x:Static convertersDispatch:FileExistsConverterParameter.Foreground}}"/>
                            <Setter Property="FontWeight" Value="{Binding DefectsServiceNeeded, Converter={StaticResource DefectConverter}, ConverterParameter={x:Static convertersDispatch:FileExistsConverterParameter.FontWeight}}"/>
                        </Style>
                    </telerik:GridViewDataColumn.CellStyle>
                </telerik:GridViewDataColumn>
                <telerik:GridViewComboBoxColumn Header="Trailer" DataMemberBinding="{Binding TrailerId}" 
                    DisplayMemberPath="Number" SelectedValueMemberPath="EntityId" ItemsSource="{Binding Trailers}" />
                <telerik:GridViewDataColumn Header="Registration" Width="110" DataMemberBinding="{Binding Registration_File}" >
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding Registration_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_TruckRegistration_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                                <Run Text="{Binding Registration_Expiration, StringFormat=d}"/>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                    <telerik:GridViewDataColumn.CellStyle>
                        <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                            <Setter Property="Background" Value="{Binding Registration_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Background}}"/>
                            <Setter Property="Foreground" Value="{Binding Registration_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Foreground}}"/>
                            <Setter Property="FontWeight" Value="{Binding Registration_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.FontWeight}}"/>
                        </Style>
                    </telerik:GridViewDataColumn.CellStyle>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="Annual Inspection" Width="110" DataMemberBinding="{Binding AnnualInspection_File}" >
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding AnnualInspection_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_TruckAnnualInspection_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                                <Run Text="{Binding AnnualInspection_Expiration, StringFormat=d}"/>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                    <telerik:GridViewDataColumn.CellStyle>
                        <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                            <Setter Property="Background" Value="{Binding AnnualInspection_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Background}}"/>
                            <Setter Property="Foreground" Value="{Binding AnnualInspection_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Foreground}}"/>
                            <Setter Property="FontWeight" Value="{Binding AnnualInspection_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.FontWeight}}"/>
                        </Style>
                    </telerik:GridViewDataColumn.CellStyle>
                </telerik:GridViewDataColumn>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <!--Loading control-->
        <userControls:LoadingControl x:Name="loadingTrailers" Panel.ZIndex="100" Visibility="Visible" Grid.Row="2" Grid.RowSpan="2" />

        <!--Toolbar-->
        <Border Grid.Row="2" BorderThickness="1,0" Margin="5,0" Background="{x:Static SystemColors.ControlBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <!--Create button-->
                    <Button
                        Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="CreateTrailer_Clicked">
                        <StackPanel Orientation="Horizontal">
                            <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/add.png" Style="{StaticResource BoardButtonImageStyle}"></userControls:AutoGreyableImage>
                            <TextBlock VerticalAlignment="Center" Margin="3">Create</TextBlock>
                        </StackPanel>
                    </Button>
                    <!--Edit button-->
                    <Button
                        Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="EditTrailer_Clicked">
                        <StackPanel Orientation="Horizontal">
                            <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/edit.png" Style="{StaticResource BoardButtonImageStyle}"></userControls:AutoGreyableImage>
                            <TextBlock VerticalAlignment="Center" Margin="3">Edit</TextBlock>
                        </StackPanel>
                    </Button>
                    <!--Delete button-->
                    <Button
                        Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="DeleteTrailer_Clicked">
                        <StackPanel Orientation="Horizontal">
                            <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/delete.png" Style="{StaticResource BoardButtonImageStyle}"></userControls:AutoGreyableImage>
                            <TextBlock VerticalAlignment="Center" Margin="3">Delete</TextBlock>
                        </StackPanel>
                    </Button>
                    <!--Move to history-->
                    <Button
                        Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="MoveToHistoryTrailer_Clicked">
                        <StackPanel Orientation="Horizontal">
                            <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/history.png" Style="{StaticResource BoardButtonImageStyle}"></userControls:AutoGreyableImage>
                            <TextBlock VerticalAlignment="Center" Margin="3">Move To History</TextBlock>
                        </StackPanel>
                    </Button>
                    <telerik:RadToolBarSeparator/>
                    <!--BNSF-->
                    <Button Name="bnsfButton"
                        Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="BnsfRefresh_Clicked">
                        <StackPanel Orientation="Horizontal">
                            <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/load.png" Style="{StaticResource BoardButtonImageStyle}"></userControls:AutoGreyableImage>
                            <TextBlock VerticalAlignment="Center" Margin="3">BNSF Refresh</TextBlock>
                        </StackPanel>
                    </Button>
                    <telerik:RadToolBarSeparator/>
                    <!--Export excel-->
                    <Button
                        Click="ExportTrailers_Clicked" 
                        Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/AutoDispatch;component/Resources/Excel_2003.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                            <TextBlock VerticalAlignment="Center" Margin="3">Export</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.ColumnSpan="2" FontSize="12" FontWeight="Bold" Foreground="DimGray" HorizontalAlignment="Center" VerticalAlignment="Center" Text="TRAILERS"/>
                <!--Filter-->
                <telerik:RadWatermarkTextBox Name="tbSearchTrailer"
                    Grid.Row="0" Grid.ColumnSpan="10" FontSize="12" 
                    HorizontalAlignment="Right" Width="120" Height="24" Margin="5"
                    WatermarkContent="Search"
                    Text="{Binding SearchTextTrailer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="tbFilterTrailer_OnTextChanged" />
            </Grid>
        </Border>

        <!--Trailers grid-->
        <telerik:RadGridView Grid.Row="3"
            Name="gridTrailers"
            AutoGenerateColumns="False" 
            SelectionMode="Single" SelectionUnit="FullRow"
            ShowGroupPanel="False" AutoExpandGroups="False" IsFilteringAllowed="False"
            RowIndicatorVisibility="Collapsed" IsTabStop="False"
            CanUserReorderColumns="True" CanUserFreezeColumns="False" IsReadOnly="True" CanUserSortColumns="True"
            ShowColumnFooters="False" ShowGroupFooters="False"
            MouseDoubleClick="gridTrailers_OnMouseDoubleClick"
            Background="{x:Static SystemColors.ControlBrush}"
            ItemsSource="{Binding Trailers}">
            <telerik:RadGridView.ColumnGroups>
                <telerik:GridViewColumnGroup Name="Trailer" Header="Trailer" />
                <telerik:GridViewColumnGroup Name="BNSF" Header="BNSF"/>
                <telerik:GridViewColumnGroup Name="Files" Header="Files" />
            </telerik:RadGridView.ColumnGroups>
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn ColumnGroupName="Trailer" Header="Number" DataMemberBinding="{Binding Number}" />
                <telerik:GridViewDataColumn ColumnGroupName="Trailer" Header="History" DataMemberBinding="{Binding History}" />
                <telerik:GridViewDataColumn ColumnGroupName="Trailer" Header="Type" DataMemberBinding="{Binding Type, Converter={StaticResource EnumToDescriptionConverter}}" />
                <telerik:GridViewDataColumn ColumnGroupName="Trailer" Header="Yard" DataMemberBinding="{Binding YardName}" />
                <telerik:GridViewDataColumn ColumnGroupName="Trailer" Header="Defect" DataMemberBinding="{Binding DefectsString}" >
                    <telerik:GridViewDataColumn.CellStyle>
                        <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                            <Setter Property="Background" Value="{Binding DefectsServiceNeeded, Converter={StaticResource DefectConverter}, ConverterParameter={x:Static convertersDispatch:FileExistsConverterParameter.Background}}"/>
                            <Setter Property="Foreground" Value="{Binding DefectsServiceNeeded, Converter={StaticResource DefectConverter}, ConverterParameter={x:Static convertersDispatch:FileExistsConverterParameter.Foreground}}"/>
                            <Setter Property="FontWeight" Value="{Binding DefectsServiceNeeded, Converter={StaticResource DefectConverter}, ConverterParameter={x:Static convertersDispatch:FileExistsConverterParameter.FontWeight}}"/>
                        </Style>
                    </telerik:GridViewDataColumn.CellStyle>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfOwnerColumn" Header="Owner" DataMemberBinding="{Binding BnsfOwner}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfShipperColumn" Header="Shipper" DataMemberBinding="{Binding BnsfShipper}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfUnitColumn" Header="Unit" DataMemberBinding="{Binding BnsfUnit}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfLoadEmptyStatusColumn" Header="Load Empty Status" DataMemberBinding="{Binding BnsfLoadEmptyStatus}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfCurrentLocationColumn" Header="Current Location" DataMemberBinding="{Binding BnsfCurrentLocation}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfEventCodeColumn" Header="Event Code" DataMemberBinding="{Binding BnsfEventCode}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfEventDateColumn" Header="Event Date" DataMemberBinding="{Binding BnsfEventDate}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfETA_DerampColumn" Header="ETA Deramp" DataMemberBinding="{Binding BnsfETA_Deramp}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfOriginColumn" Header="Origin" DataMemberBinding="{Binding BnsfOrigin}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfDestinationColumn" Header="Destination" DataMemberBinding="{Binding BnsfDestination}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfBeyondGoalHoursColumn" Header="Beyond Goal Hours" DataMemberBinding="{Binding BnsfBeyondGoalHours}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfTimeDerampColumn" Header="Time Deramp" DataMemberBinding="{Binding BnsfTimeDeramp}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfTimeNotifyColumn" Header="Time Notify" DataMemberBinding="{Binding BnsfTimeNotify}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfFinalTrainArrivalColumn" Header="Final Train Arrival" DataMemberBinding="{Binding BnsfFinalTrainArrival}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfGoalDateColumn" Header="Goal Date" DataMemberBinding="{Binding BnsfGoalDate}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfNexteventColumn" Header="Nexte Eent" DataMemberBinding="{Binding BnsfNextevent}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfPickUpNumberColumn" Header="Pick-Up Number" DataMemberBinding="{Binding BnsfPickUpNumber}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfStorageDayColumn" Header="Storage Day" DataMemberBinding="{Binding BnsfStorageDay}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfTrainColumn" Header="Train" DataMemberBinding="{Binding BnsfTrain}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfTruckerColumn" Header="Trucker" DataMemberBinding="{Binding BnsfTrucker}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfWaybillDateColumn" Header="Waybill Date" DataMemberBinding="{Binding BnsfWaybillDate}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfRateAuthorityColumn" Header="Rate Authority" DataMemberBinding="{Binding BnsfRateAuthority}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfAmountDueColumn" Header="Amount Due" DataMemberBinding="{Binding BnsfAmountDue}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfDueDateColumn" Header="Due Date" DataMemberBinding="{Binding BnsfDueDate}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfWaybillNumberColumn" Header="Waybill Number" DataMemberBinding="{Binding BnsfWaybillNumber}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfBillNumberColumn" Header="Bill Number" DataMemberBinding="{Binding BnsfBillNumber}" />
                <telerik:GridViewDataColumn ColumnGroupName="BNSF" Name="BnsfAdjustmentsColumn" Header="Adjustments" DataMemberBinding="{Binding BnsfAdjustments}" />
                <telerik:GridViewDataColumn ColumnGroupName="Files" Header="Scheme" DataMemberBinding="{Binding SchemeFile}">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding SchemeFile, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_TrailerScheme_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                                <Run Text="{Binding SchemeDate, StringFormat=d, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn ColumnGroupName="Files" Header="Annual Inspection" Width="110" DataMemberBinding="{Binding AnnualInspection_File}" >
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding AnnualInspection_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_TrailerAnnualInspection_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                                <Run Text="{Binding AnnualInspection_Expiration, StringFormat=d}"/>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                    <telerik:GridViewDataColumn.CellStyle>
                        <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                            <Setter Property="Background" Value="{Binding AnnualInspection_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Background}}"/>
                            <Setter Property="Foreground" Value="{Binding AnnualInspection_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Foreground}}"/>
                            <Setter Property="FontWeight" Value="{Binding AnnualInspection_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.FontWeight}}"/>
                        </Style>
                    </telerik:GridViewDataColumn.CellStyle>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn ColumnGroupName="Files" Header="Registration" Width="50" DataMemberBinding="{Binding Registration_File}" >
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding Registration_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_TrailerRegistration_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn ColumnGroupName="Files" Header="Maintenance" Width="50" DataMemberBinding="{Binding Maintenance_File}" >
                    <telerik:GridViewDataColumn.CellStyle>
                        <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                            <Setter Property="Background" Value="{Binding Maintenance_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Background}}"/>
                            <Setter Property="Foreground" Value="{Binding Maintenance_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.Foreground}}"/>
                            <Setter Property="FontWeight" Value="{Binding Maintenance_Expiration, Converter={StaticResource ExpirationConverter}, ConverterParameter={x:Static converters:ExpirationConverterType.FontWeight}}"/>
                        </Style>
                    </telerik:GridViewDataColumn.CellStyle>
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Visibility="{Binding Maintenance_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Hyperlink Click="Open_TrailerMaintenance_OnClick">
                                    <Run Text="open"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <!--Error message-->
        <TextBlock x:Name="tbError" Grid.Row="4" TextWrapping="Wrap" Margin="5" Foreground="Red" MaxHeight="80" HorizontalAlignment="Right" Visibility="Collapsed" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar" Grid.Row="4" Margin="5" IsIndeterminate="True" Height="10" Visibility="Collapsed" />

        <Button x:Name="btnOk" Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource OkButtonStyle}" Visibility="Collapsed">OK</Button>
        <Button x:Name="btnClose" Grid.Row="5" Style="{StaticResource CloseButtonStyle}" Click="btnClose_Clicked">Close</Button>
    </Grid>
</dialogs:BaseDispatchDialog>



