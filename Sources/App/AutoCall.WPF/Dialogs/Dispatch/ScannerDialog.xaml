<Window x:Class="AutoCall.WPF.Dialogs.Dispatch.ScannerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
    Width="800" Height="600"
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    WindowStartupLocation="CenterScreen"
    Background="{x:Static SystemColors.ControlBrush}"
    Title="Scan Document"
    Loaded="Window_Loaded">
    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:InvertableBooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:AnyToVisibilityConverter x:Key="AnyToVisibilityConverter"/>
    </Window.Resources>
    <Grid IsEnabled="{Binding Processing, Converter={StaticResource InverseBooleanConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- ToolBar -->
        <Border BorderBrush="DarkGray" BorderThickness="0,1,1,1" Grid.Row="0" Grid.Column="0" Padding="0,0,0,5">
            <StackPanel Orientation="Vertical">
                <TextBlock Margin="5,5,5,0">Source</TextBlock>
                <ComboBox Margin="5" ItemsSource="{Binding ScannerItemSource}" SelectedItem="{Binding SelectedScanner, Mode=TwoWay}" />
                <CheckBox Margin="5" IsChecked="{Binding ADF}">Document Feeder</CheckBox>
                <CheckBox Margin="5" IsChecked="{Binding BW}">Black &amp; White</CheckBox>
                <Button Margin="5" Name="ScanButton" Click="scanButton_Click">Scan</Button>
            </StackPanel>
        </Border>
        <!-- Mini -->
        <Border BorderBrush="DarkGray" BorderThickness="0,0,1,1" Grid.Row="1" Grid.Column="0">
            <ListView ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                Margin="5,0" Background="Transparent" BorderThickness="0" SelectionMode="Single">
                <!-- когда IsEnabled = false, то фон ListView is white. хотел сделать проздачным, но видно только один элемент -->
                <ListView.Style>
                    <Style TargetType="{x:Type ListView}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListView">
                                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" >
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Style>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="3" Name="border">
                            <Image Name="img" Source="{Binding}" Stretch="Uniform" Width="150"/>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Name="Border" SnapsToDevicePixels="true">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="true">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="Red"/>
                                            <Setter TargetName="Border" Property="BorderThickness" Value="3"/>
                                            <Setter TargetName="Border" Property="Margin" Value="0"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="false">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="Black"/>
                                            <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="Border" Property="Margin" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>
        <!-- Image -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" BorderThickness="1" BorderBrush="Gray" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Name="img" Source="{Binding SelectedImage}" Stretch="Uniform"/>
        </Border>
        <!-- error -->
        <TextBlock x:Name="tbError"
            Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap"
            Margin="5" Foreground="Red" HorizontalAlignment="Left" Text="{Binding ErrorMessage}"
            Visibility="{Binding Processing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar"
            Grid.Row="2" Grid.ColumnSpan="2" Margin="5,10" IsIndeterminate="True" MinHeight="10"
            Visibility="{Binding Processing, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <!-- Ok / Cancel -->
        <Button x:Name="btnOk" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource OkButtonStyle}"
            Visibility="{Binding Images, Converter={StaticResource AnyToVisibilityConverter}}" Click="btnOk_Clicked" Content="{Binding OkContent}"/>
        <Button x:Name="btnClose" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource CloseButtonStyle}" Click="btnClose_Clicked">Close</Button>

    </Grid>
</Window>
