<dispatch:LoadAddLocationDialog x:Class="AutoCall.WPF.Dialogs.Dispatch.LoadAddDestinationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:dialogs="clr-namespace:AutoCall.WPF.Dialogs"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:userControls="clr-namespace:AutoCall.WPF.UserControls"
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    xmlns:enums2="clr-namespace:AutoDispatch.Dtos.Enums;assembly=AutoDispatch.Dtos"
    xmlns:dispatch="clr-namespace:AutoCall.WPF.Dialogs.Dispatch"
    xmlns:behaviors="clr-namespace:AutoCall.WPF.Behaviors"
    mc:Ignorable="d"
    Title="Add delivery" Width="600" SizeToContent="Height"
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
    Loaded="LoadAddLocationDialog_OnLoaded"
    Background="{x:Static SystemColors.ControlBrush}">
    <dialogs:BaseDispatchDialog.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <telerik:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter"/>
        <converters:EditBaseLoadControl_ParseMatchConverter x:Key="ParseMatchConverter"/>
        <!-- Адресные подсказки уже отобраны Google (Safer autocomplete): клиентский StartsWith отсеивал бы
             "6558 West 73rd Street" при вводе "6558 W 73rd St" -->
        <behaviors:ShowAllFilteringBehavior x:Key="ShowAllFilteringBehavior"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <!-- Drop down item template -->
        <DataTemplate x:Key="searchQueryLoadKey" >
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,3,0" Foreground="Gray" HorizontalAlignment="Right" Text="company"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,3,0" Foreground="Gray" HorizontalAlignment="Right" Text="address"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,3,0" Foreground="Gray" HorizontalAlignment="Right" Text="city"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0" Text="{Binding Company}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0" Text="{Binding Address}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0" Text="{Binding City}"/>
            </Grid>
        </DataTemplate>
        <Style TargetType="{x:Type telerik:RadNumericUpDown}" BasedOn="{StaticResource fieldRadNumericUpDown}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="NumberDecimalDigits" Value="0"/>
            <Setter Property="ShowButtons" Value="False"/>
            <Setter Property="Minimum" Value="0"/>
        </Style>
        <Style x:Key="title" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource titleTextBlock}"/>
        <Style x:Key="field" TargetType="{x:Type TextBox}" BasedOn="{StaticResource fieldTextBox}"/>
        <Style TargetType="{x:Type userControls:RadRangeDateTimePicker}" BasedOn="{StaticResource fieldRadRangeDateTimePicker}"/>
        <Style TargetType="{x:Type telerik:RadDropDownButton}" BasedOn="{StaticResource fieldRadDropDownButton}"/>
        <Style TargetType="{x:Type telerik:RadRichTextBox}" BasedOn="{StaticResource fieldRadRichTextBox}"/>
        <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource fieldListBox}"/>
        <Style TargetType="{x:Type telerik:RadAutoCompleteBox}" BasedOn="{StaticResource fieldRadAutoCompleteBox}">
            <Setter Property="TextSearchMode" Value="StartsWith"/>
            <Setter Property="AutoCompleteMode" Value="Suggest"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
        </Style>
    </dialogs:BaseDispatchDialog.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Titles -->
        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Margin="5">
            <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center">ORIGIN</TextBlock>
            <Image Height="24" Width="24" Source="/AutoDispatch;component/Resources/lock.png" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Orientation="Horizontal" Margin="5"
            Visibility="{Binding FullUnload, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center">EXTRA DELIVERY</TextBlock>
            <Image Height="24" Width="24" Source="/AutoDispatch;component/Resources/edit.png" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Orientation="Horizontal" Margin="5"
            Visibility="{Binding FullUnload, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center">DELIVERY &amp; PICK-UP</TextBlock>
            <Image Height="24" Width="24" Source="/AutoDispatch;component/Resources/edit.png" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" Orientation="Horizontal" Margin="5">
            <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center">DESTINATION</TextBlock>
            <Image Height="24" Width="24" Source="/AutoDispatch;component/Resources/calculator.png" />
        </StackPanel>

        <!-- Pickup -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
            Style="{StaticResource title}">Time
        </TextBlock>
        <TextBox Grid.Row="1" Grid.Column="1" 
            IsEnabled="False" 
            Text="{Binding InitialLoad.Pickup, Mode=OneWay}"
            Style="{StaticResource field}" />
        <!-- Company -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
            Style="{StaticResource title}">Company
        </TextBlock>
        <TextBox Grid.Row="2" Grid.Column="1" 
            IsEnabled="False"
            Text="{Binding InitialLoad.ShipperCompany}"
            Style="{StaticResource field}" />
        <!-- Address -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
            Style="{StaticResource title}">Address
        </TextBlock>
        <TextBox Grid.Row="3" Grid.Column="1" 
            IsEnabled="False"
            Text="{Binding InitialLoad.OriginAddress}"
            Style="{StaticResource field}" />
        <!-- City -->
        <TextBlock Grid.Row="4" Grid.Column="0" 
            Style="{StaticResource title}">City
        </TextBlock>
        <TextBox Grid.Row="4" Grid.Column="1" 
            IsEnabled="False" 
            Text="{Binding InitialLoad.OriginCity}"
            Style="{StaticResource field}" />
        <!-- Length -->
        <TextBlock Grid.Row="5" Grid.Column="0" 
            Style="{StaticResource title}">
            <Run Text="Length"/><Run Text=" "/>
            <Run Foreground="Gray" Text="(ft)"/>
        </TextBlock>
        <telerik:RadNumericUpDown Grid.Row="5" Grid.Column="1"
            Value="{Binding InitialLoad.Length, TargetNullValue=''}"
            IsEnabled="False" />
        <!-- Weight -->
        <TextBlock Grid.Row="6" Grid.Column="0" 
            Style="{StaticResource title}">
            <Run Text="Weight"/><Run Text=" "/>
            <Run Foreground="Gray" Text="(kLbs)"/>
        </TextBlock>
        <telerik:RadNumericUpDown Grid.Row="6" Grid.Column="1" 
            Value="{Binding InitialLoad.Weight, TargetNullValue=''}"
            IsEnabled="False" />
        <!-- Paletts -->
        <TextBlock Grid.Row="7" Grid.Column="0" 
            Style="{StaticResource title}"
            Text="Pallets" />
        <telerik:RadNumericUpDown Grid.Row="7" Grid.Column="1" 
            Value="{Binding InitialLoad.Pallets, TargetNullValue=''}"
            IsEnabled="False" />
        <!-- LineHaul -->
        <TextBlock Grid.Row="8" Grid.Column="0" 
            Style="{StaticResource title}"
            Text="Line Haul" />
        <telerik:RadNumericUpDown Grid.Row="8" Grid.Column="1" 
            Value="{Binding InitialLoad.LineHaul, TargetNullValue=''}"
            IsEnabled="False" NumberDecimalDigits="2"/>

        <!-- Delivery -->
        <userControls:RadRangeDateTimePicker Grid.Row="1" Grid.Column="2"
            SelectedDate="{Binding Load2.DeliveryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SelectedTime="{Binding Load2.DeliveryFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SelectedTime2="{Binding Load2.DeliveryTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <!-- Company -->
        <telerik:RadAutoCompleteBox Grid.Column="2" Grid.Row="2" 
            SearchText="{Binding Load2.ReceiverCompany, Mode=TwoWay}"
            DropDownItemTemplate="{StaticResource searchQueryLoadKey}"
            SearchTextChanged="cacheRadAutoCompleteBox_SearchTextChanged"
            SelectionChanged="cacheRadAutoCompleteBox_SelectionChanged"
            GotFocus="RadAutoCompleteBox_GotFocus"
            LostFocus="RadAutoCompleteBox_LostFocus"
            DisplayMemberPath="Company"
            Tag="{x:Static enums2:CacheLoadIndexType.Destination}"/>
        <!-- Address -->
        <telerik:RadAutoCompleteBox Grid.Row="3" Grid.Column="2"
            DropDownWidth="Auto"
            DisplayMemberPath="description"
            SearchText="{Binding Load2.DestinationAddress, Mode=TwoWay}"
            SearchTextChanged="RadAutoCompleteBox_SearchAddressTextChanged"
            SelectionChanged="RadAutoCompleteBox_SearchAddressSelectionChanged"
            GotFocus="RadAutoCompleteBox_GotFocus"
            LostFocus="RadAutoCompleteBox_LostFocus"
            Tag="{x:Static enums2:CacheLoadIndexType.Destination}"
            FilteringBehavior="{StaticResource ShowAllFilteringBehavior}">
            <telerik:RadAutoCompleteBox.DropDownItemTemplate>
                <DataTemplate>
                    <userControls:BindableTextBlock InlineList="{Binding Converter={StaticResource ParseMatchConverter}}" Margin="5,0"/>
                </DataTemplate>
            </telerik:RadAutoCompleteBox.DropDownItemTemplate>
        </telerik:RadAutoCompleteBox>
        <Image Name="busy"
            Grid.Row="3" Grid.Column="2"
            Visibility="Collapsed" Margin="10,0"
            Width="16" Height="16" HorizontalAlignment="Right"
            gif:ImageBehavior.AnimatedSource="/AutoDispatch;component/Resources/circle_buzy.gif"/>
        <!-- City -->
        <Grid Grid.Row="4" Grid.Column="2">
            <!--DropDownItemTemplate="{StaticResource searchQueryLoadKey}"
                SearchTextChanged="cacheRadAutoCompleteBox_SearchTextChanged"
                SelectionChanged="cacheRadAutoCompleteBox_SelectionChanged"
                GotFocus="RadAutoCompleteBox_GotFocus"
                LostFocus="RadAutoCompleteBox_LostFocus"-->
            <telerik:RadAutoCompleteBox IsEnabled="False"
                SearchText="{Binding Load2.DestinationCity, Mode=TwoWay}"
                DisplayMemberPath="City"
                Tag="{x:Static enums2:CacheLoadIndexType.Destination}">
                <telerik:RadAutoCompleteBox.Style>
                    <Style TargetType="{x:Type telerik:RadAutoCompleteBox}" BasedOn="{StaticResource {x:Type telerik:RadAutoCompleteBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Load2.DestinationLocation, Converter={StaticResource NotNullToBoolConverter}}" Value="False">
                                <Setter Property="BorderBrush" Value="Red"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </telerik:RadAutoCompleteBox.Style>
            </telerik:RadAutoCompleteBox>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Image Source="/AutoDispatch;component/Resources/check.png"
                    Visibility="{Binding Load2.DestinationLocation, Converter={StaticResource NotNullToVisibilityConverter}}" Margin="5,0"
                    Width="16" Height="16" />
                <telerik:RadButton Width="24"
                    Focusable="True"
                    Style="{StaticResource attachedRadButton}"
                    Click="btnDestinationLocation_OnClick">
                    <Image Source="/AutoDispatch;component/Resources/pin_map_large.png"/>
                </telerik:RadButton>
            </StackPanel>
        </Grid>
        <!-- Length -->
        <Grid Grid.Row="5" Grid.Column="2" IsEnabled="{Binding FullUnload, Converter={StaticResource InverseBooleanConverter}}">
            <telerik:RadNumericUpDown
                ValueChanged="Load2Length_ValueChanged"
                Value="{Binding Load2.Length, TargetNullValue=''}" 
                Maximum="{Binding InitialLoad.Length, TargetNullValue='0'}"
                IsEnabled="{Binding InitialLoad.Length, Converter={StaticResource NotNullToBoolConverter}}"/>
        </Grid>
        <!-- Weight -->
        <Grid Grid.Row="6" Grid.Column="2" IsEnabled="{Binding FullUnload, Converter={StaticResource InverseBooleanConverter}}">
            <telerik:RadNumericUpDown
                ValueChanged="Load2Weight_ValueChanged"
                Value="{Binding Load2.Weight, TargetNullValue=''}" 
                Maximum="{Binding InitialLoad.Weight, TargetNullValue='0'}"
                IsEnabled="{Binding InitialLoad.Weight, Converter={StaticResource NotNullToBoolConverter}}"/>
        </Grid>
        <!-- Paletts -->
        <Grid Grid.Row="7" Grid.Column="2" IsEnabled="{Binding FullUnload, Converter={StaticResource InverseBooleanConverter}}">
            <telerik:RadNumericUpDown
                ValueChanged="Load2Pallets_ValueChanged"
                Value="{Binding Load2.Pallets, TargetNullValue=''}" 
                Maximum="{Binding InitialLoad.Pallets, TargetNullValue='0'}"
                IsEnabled="{Binding InitialLoad.Pallets, Converter={StaticResource NotNullToBoolConverter}}"/>
        </Grid>
        <!-- LineHaul -->
        <Grid Grid.Row="8" Grid.Column="2">
            <telerik:RadNumericUpDown
                ValueChanged="Load2LineHaul_ValueChanged" NumberDecimalDigits="2"
                Value="{Binding Load2.LineHaul, TargetNullValue=''}" 
                Maximum="{Binding InitialLoad.LineHaul, TargetNullValue='0'}"
                IsEnabled="{Binding InitialLoad.LineHaul, Converter={StaticResource NotNullToBoolConverter}}"/>
        </Grid>

        <!-- Delivery -->
        <TextBox Grid.Row="1" Grid.Column="3" 
            IsEnabled="False"
            Text="{Binding Load1.Delivery, Mode=OneWay}"
            Style="{StaticResource field}"  />
        <!-- Company -->
        <TextBox Grid.Row="2" Grid.Column="3" 
            IsEnabled="False"
            Text="{Binding InitialLoad.ReceiverCompany}"
            Style="{StaticResource field}" />
        <!-- Address -->
        <TextBox Grid.Row="3" Grid.Column="3" 
            IsEnabled="False" 
            Text="{Binding Load1.DestinationAddress}"
            Style="{StaticResource field}" />
        <!-- City -->
        <TextBox Grid.Row="4" Grid.Column="3" 
            IsEnabled="False" 
            Text="{Binding Load1.DestinationCity}"
            Style="{StaticResource field}" />
        <!-- Length -->
        <telerik:RadNumericUpDown Grid.Row="5" Grid.Column="3" 
            Value="{Binding Load1.Length, TargetNullValue=''}" 
            IsEnabled="False"/>
        <!-- Weight -->
        <telerik:RadNumericUpDown Grid.Row="6" Grid.Column="3" 
            Value="{Binding Load1.Weight, TargetNullValue=''}" 
            IsEnabled="False"/>
        <!-- Paletts -->
        <telerik:RadNumericUpDown Grid.Row="7" Grid.Column="3" 
            Value="{Binding Load1.Pallets, TargetNullValue=''}" 
            IsEnabled="False"/>
        <!-- LineHaul -->
        <telerik:RadNumericUpDown Grid.Row="8" Grid.Column="3" 
            Value="{Binding Load1.LineHaul, TargetNullValue=''}" 
            IsEnabled="False" NumberDecimalDigits="2"/>

        <CheckBox Grid.Row="9" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,5,5,5" VerticalAlignment="Bottom"
            Click="cbFullUnload_OnClick"
            IsChecked="{Binding FullUnload, Mode=TwoWay}">Full unload</CheckBox>

        <!--Error message-->
        <TextBlock x:Name="tbError" Grid.Row="10" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="5" Foreground="Red" MaxHeight="80" HorizontalAlignment="Right" Visibility="Hidden" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar" Grid.ColumnSpan="4" Grid.Row="10" Margin="5" IsIndeterminate="True" Height="10" Visibility="Hidden" />

        <Button x:Name="btnOk" Grid.Row="11" Grid.ColumnSpan="4" Style="{StaticResource OkButtonStyle}"  Click="btnOk_Clicked">OK</Button>
        <Button x:Name="btnClose" Grid.Row="11" Grid.ColumnSpan="4" Style="{StaticResource CloseButtonStyle}">Close</Button>
    </Grid>
</dispatch:LoadAddLocationDialog>