<UserControl
    x:Class="AutoCall.WPF.Dialogs.Dispatch.UserControls.ContactsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:markup="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dispatch="clr-namespace:AutoCall.WPF.Converters.Dispatch"
    xmlns:userControls="clr-namespace:AutoCall.WPF.UserControls"
    xmlns:contacts="clr-namespace:AutoDispatch.Logic.Contracts.ViewModels.Items.Contacts;assembly=AutoDispatch.Logic.Contracts"
    xmlns:core="clr-namespace:AutoCall.WPF.Core"
    xmlns:userControls1="clr-namespace:AutoCall.WPF.Dialogs.Dispatch.UserControls"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    Loaded="ContactsControl_OnLoaded"
    Unloaded="ContactsControl_OnUnloaded"

    Name="userControl">
    <UserControl.Resources>
        <core:BindingProxy x:Key="proxy" Data="{Binding}"/>
        <dispatch:ContactsControl_CountToVisibilityConverter x:Key="CountToVisibilityConverter" Count="1"/>
        <userControls1:ContactTemplateSelector x:Key="ContactTemplateSelector"/>
        <Style TargetType="{x:Type telerik:RadWatermarkTextBox}" BasedOn="{StaticResource fieldRadWatermarkTextBox}"/>
        <Style x:Key="phoneTextBox" TargetType="{x:Type userControls:RadPhoneTextInput}" BasedOn="{StaticResource fieldRadMaskedTextInput}">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="IsLastPositionEditable" Value="False"/>
            <Setter Property="IsClearButtonVisible" Value="False"/>
        </Style>
        <Style x:Key="extTextBox" TargetType="{x:Type telerik:RadWatermarkTextBox}" BasedOn="{StaticResource fieldRadWatermarkTextBox}">
            <Setter Property="Margin" Value="-1,5,-1,5"/>
        </Style>
        <!-- Buttons -->
        <Style TargetType="{x:Type telerik:RadButton}" BasedOn="{StaticResource {x:Type telerik:RadButton}}">
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Cursor" Value="{markup:Static Cursors.Hand}"/>
        </Style>
        <Style TargetType="{x:Type userControls:RadPhoneButton}" BasedOn="{StaticResource {x:Type telerik:RadButton}}">
            <Setter Property="Margin" Value="0,5,5,5"/>
        </Style>
        <Style x:Key="addButton" TargetType="{x:Type telerik:RadButton}" BasedOn="{StaticResource {x:Type telerik:RadButton}}">
            <Setter Property="ToolTip" Value="Add contact"/>
            <Setter Property="Content">
                <Setter.Value>
                    <Image Source="/AutoDispatch;component/Resources/black_plus.png"/>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Click" Handler="Add_OnClicked"/>
        </Style>
        <Style x:Key="editButton" TargetType="{x:Type telerik:RadButton}" BasedOn="{StaticResource {x:Type telerik:RadButton}}">
            <Setter Property="ToolTip" Value="Edit Contacts"/>
            <Setter Property="Content">
                <Setter.Value>
                    <Image Source="/AutoDispatch;component/Resources/black_edit.png"/>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Click" Handler="Edit_OnClicked"/>
        </Style>
        <Style x:Key="nextButton" TargetType="{x:Type telerik:RadButton}" BasedOn="{StaticResource {x:Type telerik:RadButton}}">
            <Setter Property="ToolTip" Value="Next contact"/>
            <Setter Property="Visibility" Value="{Binding Data.Contacts, Source={StaticResource proxy}, Converter={StaticResource CountToVisibilityConverter}}"/>
            <Setter Property="Content">
                <Setter.Value>
                    <Image Source="/AutoDispatch;component/Resources/black_arrow.png"/>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Click" Handler="Next_OnClicked"/>
        </Style>
    </UserControl.Resources>
        
    <ContentControl
        Name="root"
        Content="{Binding CurrentContact}"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
        ContentTemplateSelector="{StaticResource ContactTemplateSelector}">
        <ContentControl.Resources>
            <!-- Empty -->
            <DataTemplate x:Key="NullTemplateKey" DataType="{markup:Type contacts:ContactPhoneViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="37"/>
                        <!--<RowDefinition Height="*"/>-->
                    </Grid.RowDefinitions>
                    <!-- пустой Grid.ColumnDefinitions V1 — в XAML .NET ошибка MC3063 -->
                    <!--<Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>-->
                    <telerik:RadButton HorizontalAlignment="Left" Style="{StaticResource addButton}" 
                        Margin="0,5,5,5"  Width="26" Height="26"/>
                </Grid>
            </DataTemplate>
            <!-- Phone -->
            <DataTemplate x:Key="ContactPhoneTemplateKey" DataType="{markup:Type contacts:ContactPhoneViewModel}">
                <Grid ShowGridLines="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="31"/>
                        <ColumnDefinition Width="31"/>
                        <ColumnDefinition Width="31"/>
                    </Grid.ColumnDefinitions>
                    <userControls:RadPhoneTextInput 
                        Grid.Row="0" x:Name="tbPhone"
                        Style="{StaticResource phoneTextBox}"
                        Value="{Binding Path=Phone, UpdateSourceTrigger=PropertyChanged}"
                        Loaded="tbContact_OnLoaded"/>
                    <telerik:RadWatermarkTextBox 
                        Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" 
                        Style="{StaticResource extTextBox}"
                        WatermarkContent="ext."
                        Text="{Binding Ext}"/>
                    <userControls:RadPhoneButton 
                        Grid.Row="0" Grid.Column="3"/>
                    <telerik:RadWatermarkTextBox 
                        Grid.Row="1" Margin="0,0,5,5"
                        WatermarkContent="name"
                        Text="{Binding Contact}"/>
                    <telerik:RadButton 
                        Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource editButton}"/>
                    <telerik:RadButton 
                        Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource addButton}"/>
                    <telerik:RadButton 
                        Grid.Row="1" Grid.Column="3"
                        Style="{StaticResource nextButton}"/>
                </Grid>
            </DataTemplate>
            <!-- Fax -->
            <DataTemplate x:Key="ContactFaxTemplateKey" DataType="{markup:Type contacts:ContactFaxViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="31"/>
                        <ColumnDefinition Width="31"/>
                        <ColumnDefinition Width="31"/>
                    </Grid.ColumnDefinitions>
                    <userControls:RadPhoneTextInput 
                        Grid.Row="0"
                        Style="{StaticResource phoneTextBox}"
                        Value="{Binding Path=Phone, UpdateSourceTrigger=PropertyChanged}"
                        Loaded="tbContact_OnLoaded"/>
                    <telerik:RadWatermarkTextBox 
                        Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                        Margin="-1,5,5,5"
                        Style="{StaticResource extTextBox}"
                        WatermarkContent="ext."
                        Text="{Binding Ext}"/>
                    <TextBlock
                        Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                        Text="Fax" Foreground="DarkGray" FontStyle="Italic"/>
                    <telerik:RadButton 
                        Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource editButton}"/>
                    <telerik:RadButton 
                        Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource addButton}"/>
                    <telerik:RadButton 
                        Grid.Row="1" Grid.Column="3"
                        Style="{StaticResource nextButton}"/>
                </Grid>
            </DataTemplate>
            <!-- Email -->
            <DataTemplate x:Key="ContactEmailTemplateKey" DataType="{markup:Type contacts:ContactEmailViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="31"/>
                        <ColumnDefinition Width="31"/>
                        <ColumnDefinition Width="31"/>
                    </Grid.ColumnDefinitions>
                    <telerik:RadWatermarkTextBox 
                        Grid.Row="0" Grid.ColumnSpan="4" Margin="0,5,5,5"
                        WatermarkContent="email" 
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        Loaded="tbContact_OnLoaded"/>
                    <TextBlock
                        Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                        Text="Email" Foreground="DarkGray" FontStyle="Italic"/>
                    <telerik:RadButton 
                        Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource editButton}"/>
                    <telerik:RadButton 
                        Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource addButton}"/>
                    <telerik:RadButton 
                        Grid.Row="1" Grid.Column="3"
                        Style="{StaticResource nextButton}"/>
                </Grid>
            </DataTemplate>
        </ContentControl.Resources>
    </ContentControl>
</UserControl>