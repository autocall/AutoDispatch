<dialogs:BaseDispatchDialog xmlns:dialogs="clr-namespace:AutoCall.WPF.Dialogs"
    x:Class="AutoCall.WPF.Dialogs.Dispatch.SendInvoiceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:userControls="clr-namespace:AutoCall.WPF.UserControls"
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    mc:Ignorable="d" 
    Width="500"
    SizeToContent="Height"
    WindowStyle="ToolWindow"
    WindowStartupLocation="CenterScreen"
    Background="{x:Static SystemColors.ControlBrush}"
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    Title="Send Invoice">
    <Window.Resources>
        <converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter"/>
        <converters:NotNullToVisibilityConverter x:Key="NullToVisibilityConverter" Invert="True"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <!-- Buttons -->
        <Style TargetType="{x:Type telerik:RadButton}" BasedOn="{StaticResource {x:Type telerik:RadButton}}">
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Cursor" Value="{x:Static Cursors.Hand}"/>
        </Style>
        <Style TargetType="{x:Type userControls:RadPhoneButton}" BasedOn="{StaticResource {x:Type telerik:RadButton}}">
            <Setter Property="Margin" Value="0,5,5,5"/>
        </Style>
        <Style x:Key="addButton" TargetType="{x:Type telerik:RadButton}" BasedOn="{StaticResource {x:Type telerik:RadButton}}">
            <Setter Property="ToolTip" Value="Add Email"/>
            <Setter Property="Content">
                <Setter.Value>
                    <Image Source="/AutoDispatch;component/Resources/black_plus.png"/>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Click" Handler="Add_OnClicked"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <ItemsControl Name="lbEmails" Grid.Row="0" ItemsSource="{Binding Emails}" BorderThickness="0"
            Margin="10,0" HorizontalContentAlignment="Stretch" >
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,5" Loaded="lbEmailsItem_OnLoaded"
                            Text="{Binding Item, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding Item2}" />
                        <CheckBox Grid.Column="1" Margin="5,5,0,5" IsChecked="{Binding Item2}" Focusable="False" VerticalAlignment="Center">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Grid.Row="1" Margin="10,0"
              Visibility="{Binding Converter={StaticResource NotNullToVisibilityConverter}}" DataContext="{Binding FactoringCompanyEmail}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DockPanel LastChildFill="True">
                <TextBlock Text="Factoring Company" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox Grid.Column="0" Margin="0,5" Loaded="lbEmailsItem_OnLoaded" IsEnabled="{Binding Item2}"
                    Text="{Binding Item, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <CheckBox Grid.Column="1" Margin="5,5,0,5" IsChecked="{Binding Item2}" Focusable="False" VerticalAlignment="Center">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                </CheckBox.LayoutTransform>
            </CheckBox>
        </Grid>
        <telerik:RadButton Grid.Row="2" Padding="10,5" Margin="5"
            HorizontalAlignment="Right" Focusable="False"
            Content="Add Extra Email" Click="Add_OnClicked"/>
        <CheckBox Grid.Row="2" Margin="5,10" Content="Save contacts" 
            HorizontalAlignment="Left" VerticalAlignment="Center"
            IsChecked="{Binding SaveContacts}"/>
        <Grid Grid.Row="3" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding SendInvoice}" IsEnabled="{Binding Load.InvoiceFile, Converter={StaticResource NotNullToBoolConverter}}">
                <Grid>
                    <TextBlock Text="Invoice" Visibility="{Binding Load.InvoiceFile, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <TextBlock Visibility="{Binding Load.InvoiceFile, Converter={StaticResource NotNullToVisibilityConverter}}" ToolTip="{Binding Load.InvoiceFile}">
                        <Hyperlink Click="Invoice_OnClick">Invoice</Hyperlink>
                    </TextBlock>
                </Grid>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding SendPOD}" IsEnabled="{Binding Load.PODFile, Converter={StaticResource NotNullToBoolConverter}}">
                <Grid>
                    <TextBlock Text="POD" Visibility="{Binding Load.PODFile, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <TextBlock Visibility="{Binding Load.PODFile, Converter={StaticResource NotNullToVisibilityConverter}}" ToolTip="{Binding Load.PODFile}">
                        <Hyperlink Click="POD_OnClick">POD</Hyperlink>
                    </TextBlock>
                </Grid>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding SendLumper}" IsEnabled="{Binding Load.LumperFile, Converter={StaticResource NotNullToBoolConverter}}">
                <Grid>
                    <TextBlock Text="Lumper" Visibility="{Binding Load.LumperFile, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <TextBlock Visibility="{Binding Load.LumperFile, Converter={StaticResource NotNullToVisibilityConverter}}" ToolTip="{Binding Load.LumperFile}">
                        <Hyperlink Click="Lumper_OnClick">Lumper</Hyperlink>
                    </TextBlock>
                </Grid>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="3" IsChecked="{Binding SendConfirmation}" IsEnabled="{Binding Load.ConfirmationFileView, Converter={StaticResource NotNullToBoolConverter}}">
                <Grid>
                    <TextBlock Text="Confirmation" Visibility="{Binding Load.ConfirmationFile, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <TextBlock Visibility="{Binding Load.ConfirmationFile, Converter={StaticResource NotNullToVisibilityConverter}}" ToolTip="{Binding Load.ConfirmationFile}">
                        <Hyperlink Click="Confirmation_OnClick">Confirmation</Hyperlink>
                    </TextBlock>
                </Grid>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="4" IsChecked="{Binding Merged}">
                <TextBlock>
                    <Hyperlink Click="Merged_OnClick">Merged</Hyperlink>
                </TextBlock>
            </CheckBox>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="Email Text" Margin="0,10,0,0"/>
            <TextBox Grid.Row="2" Grid.ColumnSpan="5" Text="{Binding Text}" Style="{StaticResource fieldTextBox}" HorizontalAlignment="Stretch" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0, 5"/>

        </Grid>
        <!--Error message-->
        <TextBlock x:Name="tbError" Grid.Row="4" TextWrapping="Wrap" Margin="5" Foreground="Red" MaxHeight="80" HorizontalAlignment="Right" Visibility="Collapsed" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar" Grid.Row="4" Margin="5" IsIndeterminate="True" Height="10" Visibility="Collapsed" />
        
        <Button Grid.Row="5" x:Name="btnOk" Style="{StaticResource OkButtonStyle}" Click="btnOk_Clicked">Send</Button>
        <Button Grid.Row="5" x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="btnClose_Clicked">Close</Button>
    </Grid>
</dialogs:BaseDispatchDialog>
