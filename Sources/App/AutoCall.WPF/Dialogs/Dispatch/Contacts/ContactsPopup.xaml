<Popup x:Class="AutoCall.WPF.Dialogs.Dispatch.UserControls.ContactsPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:AutoCall.WPF.UserControls"
    xmlns:contacts="clr-namespace:AutoDispatch.Logic.Contracts.ViewModels.Items.Contacts;assembly=AutoDispatch.Logic.Contracts"
    mc:Ignorable="d" 
    d:DesignHeight="300" d:DesignWidth="300" AllowsTransparency="True">
    <Border Background="#F0F0E1" Padding="2" BorderThickness="1" BorderBrush="Black" CornerRadius="5" 
        MouseEnter="Border_MouseOnEnter"
        MouseLeave="Border_MouseOnLeave">
        <ItemsControl ItemsSource="{Binding Contacts, Mode=OneWay}">
            <ItemsControl.Resources>
                <DataTemplate DataType="{x:Type contacts:ContactPhoneViewModel}">
                    <TextBlock Margin="5">
                        <Run>phone: </Run>
                        <Hyperlink Click="Phone_OnClick">
                            <Run Text="{Binding Mode=OneWay}"/>
                        </Hyperlink>
                        <Run Text="{Binding Contact, Mode=OneWay}"/>
                    </TextBlock>
                </DataTemplate>
                <DataTemplate DataType="{x:Type contacts:ContactFaxViewModel}">
                    <TextBlock Margin="5">
                        <Run>fax: </Run>
                        <Run Text="{Binding Mode=OneWay}"/>
                    </TextBlock>
                </DataTemplate>
                <DataTemplate DataType="{x:Type contacts:ContactEmailViewModel}">
                    <TextBlock Margin="5">
                        <Run>email: </Run>
                        <Run Text="{Binding Email, Mode=OneWay }"/>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.Resources>
        </ItemsControl>
    </Border>
</Popup>

