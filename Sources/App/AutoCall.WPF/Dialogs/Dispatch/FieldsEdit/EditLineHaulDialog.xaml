<dialogs:BaseDispatchDialog 
    x:Class="AutoCall.WPF.Dialogs.Dispatch.EditLineHaulDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:dialogs="clr-namespace:AutoCall.WPF.Dialogs"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:helpers="clr-namespace:AutoCall.WPF.Helpers"
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    mc:Ignorable="d" 
    d:DesignWidth="300"
    Title="Edit Line Haul" Width="300" SizeToContent="Height"
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
    Background="{x:Static SystemColors.ControlBrush}">
    <dialogs:BaseDispatchDialog.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </dialogs:BaseDispatchDialog.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="*"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LineHaul -->
        <TextBlock Grid.Column="0" Grid.Row="0" 
            Style="{StaticResource titleTextBlock}"
            Text="Line Haul"/>
        <StackPanel Grid.Column="1" Grid.Row="0"
            Orientation="Horizontal">
            <telerik:RadNumericUpDown
                NumberDecimalDigits="2"
                ShowButtons="False"
                Value="{Binding LineHaul, Mode=TwoWay, TargetNullValue=''}" 
                Width="80" Margin="0,5,0,5"/>
            <telerik:RadButton 
                Content="{Binding Currency, Converter={StaticResource EnumToDescriptionConverter}}"
                Style="{StaticResource attachedRadButton}"
                Padding="8,0"
                Click="Currency_OnClicked" />
        </StackPanel>

        <!--Error message-->
        <TextBlock x:Name="tbError" Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="5" Foreground="Red" MaxHeight="80" HorizontalAlignment="Right" Visibility="Hidden" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar" Grid.ColumnSpan="2" Grid.Row="2" Margin="5" IsIndeterminate="True" Height="10" Visibility="Hidden" />

        <Button x:Name="btnOk" Grid.Row="3" Grid.ColumnSpan="2"  Style="{StaticResource OkButtonStyle}"  Click="btnOk_Clicked">OK</Button>
        <Button x:Name="btnClose" Grid.Row="3" Grid.ColumnSpan="2"  Style="{StaticResource CloseButtonStyle}">Close</Button>
    </Grid>
</dialogs:BaseDispatchDialog>

