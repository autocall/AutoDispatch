<dialogs:BaseDispatchDialog x:Class="AutoCall.WPF.Dialogs.Dispatch.EditDefectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="clr-namespace:AutoCall.WPF.Dialogs"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    SizeToContent="Height" Width="400"
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
    Background="{x:Static SystemColors.ControlBrush}">
    <dialogs:BaseDispatchDialog.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </dialogs:BaseDispatchDialog.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <!-- Defect -->
        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource titleTextBlock}" Text="Defect" />
        <telerik:RadComboBox Grid.Row="0" Grid.Column="1" Name="cbDefects"
            Style="{StaticResource fieldRadComboBox}"
            Margin="5" Width="150" HorizontalAlignment="Left">
            <telerik:RadComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                </DataTemplate>
            </telerik:RadComboBox.ItemTemplate>
        </telerik:RadComboBox>
        <!-- Description -->
        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource titleTextBlock}" Text="Description" />
        <TextBox Grid.Row="2" Grid.Column="1" 
            Style="{StaticResource fieldTextBox}"
            Margin="5" Text="{Binding Description, Mode=TwoWay}" />
        <!-- Service Needed -->
        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource titleTextBlock}" Text="Service Needed" />
        <CheckBox Grid.Row="3" Grid.Column="1" 
            Margin="5" IsChecked="{Binding ServiceNeeded, Mode=TwoWay}" />
        <!-- Files -->
        <StackPanel Orientation="Vertical" Grid.Row="4" Grid.ColumnSpan="6">
            <Button Content="Add File" Width="100" Padding="5" Margin="5" HorizontalAlignment="Left" Click="AddFile_OnClick"/>
            <ItemsControl ItemsSource="{Binding Files}" BorderThickness="0"
                Margin="10,5,5,5" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Click="OpenFile_OnClick" Focusable="False">
                                    <Run Text="{Binding Mode=OneWay}"/>
                                </Hyperlink>
                            </TextBlock>
                            <Image Source="/AutoDispatch;component/Resources/Close.png" MouseLeftButtonUp="DeleteFile_OnClick"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Width="16" Height="16" Margin="2,0,5,0" Cursor="Hand"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!--Error message-->
        <TextBlock x:Name="tbError" Grid.Row="5" Grid.ColumnSpan="10" TextWrapping="Wrap" Margin="5" Foreground="Red" HorizontalAlignment="Right" Visibility="Collapsed" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar" Grid.Row="5" Grid.ColumnSpan="10" Margin="5" IsIndeterminate="True" Visibility="Hidden" />

        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.ColumnSpan="10">
            <Button x:Name="btnOk" HorizontalAlignment="Left" Click="btnOk_Clicked" Width="100" Margin="4">OK</Button>
            <Button x:Name="btnDelete" HorizontalAlignment="Left" Click="btnDelete_Clicked" Foreground="Red" Width="100" Margin="4">Delete</Button>
        </StackPanel>
        <Button x:Name="btnClose" Grid.Row="6" Grid.ColumnSpan="10" HorizontalAlignment="Right" Click="btnClose_Clicked" IsCancel="True" Width="100" Margin="4">Close</Button>
    </Grid>
</dialogs:BaseDispatchDialog>
