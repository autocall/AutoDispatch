<dialogs:BaseDispatchDialog x:Class="AutoCall.WPF.Dialogs.Dispatch.EditTruckDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="clr-namespace:AutoCall.WPF.Dialogs"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:enums2="clr-namespace:AutoDispatch.Logic.Contracts.Enums;assembly=AutoDispatch.Logic.Contracts"
    xmlns:uc1="clr-namespace:AutoCall.WPF.UserControls"
    xmlns:uc2="clr-namespace:AutoCall.WPF.Dialogs.Dispatch.UserControls"
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    SizeToContent="WidthAndHeight"
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
    Loaded="EditTruckDialog_Loaded"
    Background="{x:Static SystemColors.ControlBrush}">
    <dialogs:BaseDispatchDialog.Resources>
        <converters:InvertableBooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NotNullToVisibilityConverter x:Key="NullToVisibilityConverter" Invert="True"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <converters:CompareToVisibilityConverter x:Key="CompareToVisibilityConverter"/>
        <converters:AnyToVisibilityConverter x:Key="AnyToVisibilityConverter"/>
        <converters:IntToDescriptionConverter x:Key="IntToDescriptionConverter"/>
    </dialogs:BaseDispatchDialog.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="135"/>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition Width="130"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource titleTextBlock}" Text="Number" />
        <TextBox Grid.Row="0" Grid.Column="1" Height="25"
            Style="{StaticResource fieldTextBox}"
            Text="{Binding Number}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource titleTextBlock}" Text="Trailer" />
        <telerik:RadComboBox x:Name="cbTrailers" 
            Grid.Row="1" Grid.Column="1"
            Style="{StaticResource fieldRadComboBox}" HorizontalAlignment="Stretch"
            SelectedValue="{Binding TrailerId}" 
            SelectedValuePath="EntityId" DisplayMemberPath="Number" 
            ClearSelectionButtonVisibility="Visible" ClearSelectionButtonContent="clear">
        </telerik:RadComboBox>

        <!-- registration -->
        <TextBlock Grid.Column="2" Grid.Row="0" Style="{StaticResource titleTextBlock}" Text="Registration" />
        <StackPanel Grid.Column="3" Grid.Row="0" Orientation="Horizontal">
            <TextBlock Style="{StaticResource titleTextBlock}"
                Visibility="{Binding Registration_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                <Hyperlink Click="OpenRegistration_OnClick">
                    <Run>Open</Run>
                </Hyperlink>
            </TextBlock>
            <telerik:RadButton Click="BrowseRegistration_OnClick" ToolTip="Attach Photo" Margin="0,5,5,0" VerticalAlignment="Center">
                <uc1:AutoGreyableImage Source="/AutoDispatch;component/Resources/folder_open16.png" Height="16"/>
            </telerik:RadButton>
        </StackPanel>
        <TextBlock Grid.Column="4" Grid.Row="0" Style="{StaticResource titleTextBlock}" Text="Expiration" Margin="5,0"/>
        <telerik:RadDatePicker Grid.Column="5" Grid.Row="0"
                HorizontalAlignment="Left" VerticalContentAlignment="Center" Width="120" Margin="0,5,5,5" Padding="5"
                SelectedDate="{Binding Registration_Expiration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- annual inspection -->
        <TextBlock Grid.Column="2" Grid.Row="1" Style="{StaticResource titleTextBlock}" Text="Annual Inspection" />
        <StackPanel Grid.Column="3" Grid.Row="1" Orientation="Horizontal">
            <TextBlock Style="{StaticResource titleTextBlock}"
                Visibility="{Binding AnnualInspection_File, Converter={StaticResource NotNullToVisibilityConverter}}">
                <Hyperlink Click="OpenAnnualInspection_OnClick">
                    <Run>Open</Run>
                </Hyperlink>
            </TextBlock>
            <telerik:RadButton Click="BrowseAnnualInspection_OnClick" ToolTip="Attach Photo" Margin="0,5,5,0" VerticalAlignment="Center">
                <uc1:AutoGreyableImage Source="/AutoDispatch;component/Resources/folder_open16.png" Height="16"/>
            </telerik:RadButton>
        </StackPanel>
        <TextBlock Grid.Column="4" Grid.Row="1" Style="{StaticResource titleTextBlock}" Text="Expiration" Margin="5,0"/>
        <telerik:RadDatePicker Grid.Column="5" Grid.Row="1"
            HorizontalAlignment="Left" VerticalContentAlignment="Center" Width="120" Margin="0,5,5,5" Padding="5"
            SelectedDate="{Binding AnnualInspection_Expiration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Defects -->
        <StackPanel Orientation="Vertical" Grid.Row="3" Grid.ColumnSpan="2">
            <Button Content="Add Defect" Width="100" Padding="5" Margin="5" HorizontalAlignment="Left" Click="AddDefect_OnClick"/>
            <ScrollViewer MaxHeight="150">
                <StackPanel Orientation="Vertical">
                    <ItemsControl Name="lcDefects" ItemsSource="{Binding Defects}" BorderThickness="0"
                        Margin="5,0,5,10" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Margin="5,5,0,5">
                                    <Hyperlink Click="EditDefect_OnClick" Focusable="False">
                                        <Run Text="{Binding DefectId, Converter={StaticResource IntToDescriptionConverter}, ConverterParameter={x:Type enums2:DefectTruckEnum}}"/>
                                    </Hyperlink>
                                    </TextBlock>
                                    <Grid Visibility="{Binding ServiceNeeded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock VerticalAlignment="Center" Margin="5" 
                                            Visibility="{Binding Repair, Converter={StaticResource NotNullToVisibilityConverter}}">
                                            <Hyperlink Click="Repair_OnClick" Focusable="False">
                                                <Run Text="Repaired"/>
                                            </Hyperlink>
                                            <Run Text="{Binding Repair.Date, StringFormat=d}"/>
                                        </TextBlock>
                                        <Button Content="Repair" Width="70" Padding="3" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Click="Repair_OnClick" Visibility="{Binding Repair, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock HorizontalAlignment="Center">
                        <Hyperlink Click="LoadAll_OnClick" Focusable="False">
                            <Run Text="Load All"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <!--Manage Files control-->
        <uc2:FilesControl x:Name="filesControl" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="4"
             MinHeight="100" MaxHeight="200" VerticalAlignment="Top" Margin="5" DataContext="{Binding Files, Mode=OneWay}"/>

        <!--Error message-->
        <TextBlock x:Name="tbError" Grid.Row="5" Grid.ColumnSpan="10" TextWrapping="Wrap" Margin="5" Foreground="Red" HorizontalAlignment="Right" Visibility="Collapsed" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar" Grid.Row="5" Grid.ColumnSpan="10" Margin="5" IsIndeterminate="True" Visibility="Hidden" />

        <Button x:Name="btnOk" Grid.Row="6" Grid.ColumnSpan="10" HorizontalAlignment="Left" Click="btnOk_Clicked" Width="100" Margin="4">OK</Button>
        <Button x:Name="btnClose" Grid.Row="6" Grid.ColumnSpan="10" HorizontalAlignment="Right" Click="btnClose_Clicked" IsCancel="True" Width="100" Margin="4">Close</Button>
    </Grid>
</dialogs:BaseDispatchDialog>
