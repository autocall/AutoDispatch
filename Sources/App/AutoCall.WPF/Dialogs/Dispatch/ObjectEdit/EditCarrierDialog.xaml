<dialogs:BaseDispatchDialog x:Class="AutoCall.WPF.Dialogs.Dispatch.EditCarrierDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="clr-namespace:AutoCall.WPF.Dialogs"
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    xmlns:userControls="clr-namespace:AutoCall.WPF.Dialogs.Dispatch.UserControls"
    xmlns:toUri="clr-namespace:AutoCall.WPF.Converters.ToUri"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:behaviors="clr-namespace:AutoCall.WPF.Behaviors"
    xmlns:helpers="clr-namespace:AutoCall.WPF.Helpers"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    SizeToContent="Height" Width="800" 
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
    SourceInitialized="EditDatCompanyDialog_OnSourceInitialized"
    Closing="BaseDispatchDialog_Closing"
    Background="{x:Static SystemColors.ControlBrush}">
    <dialogs:BaseDispatchDialog.Resources>
        <converters:DictionaryToValueConverter x:Key="DictionaryToValueConverter"/>
        <converters:EnumToDescriptionsConverter x:Key="EnumToDescriptionsConverter"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <converters:NotNullToVisibilityConverter x:Key="NullToVisibilityConverter" Invert="True"/>
        <toUri:InsuranceStateTypeToUriConverter x:Key="InsuranceStateTypeToUriConverter"/>
        <telerik:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <telerik:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
        <converters:Compare2ToVisibilityConverter x:Key="Compare2ToVisibilityConverter"/>
        <converters:Compare2ToVisibilityConverter x:Key="InvertedCompare2ToVisibilityConverter" Inverted="True"/>
        <s:Byte x:Key="ByteOne">1</s:Byte>
        <Style x:Key="valueTextBlock" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
        </Style>
        <Style x:Key="valueTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="behaviors:TextBoxBehavior.TripleClickSelectAll" Value="True" />
        </Style>
        <Style x:Key="editableTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </dialogs:BaseDispatchDialog.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Actual Company -->
        <telerik:RadComboBox Name="cbActualCompany"
            Width="50" Height="32" Margin="2,2,0,0"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            SelectedValuePath="EntityId"
            SelectedValue="{Binding ActualCompanyId}">
            <telerik:RadComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding LogoSmall}" RenderOptions.BitmapScalingMode="Fant" Width="24" Height="24"/>
                        <TextBlock Text="{Binding LegalName}" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                </DataTemplate>
            </telerik:RadComboBox.ItemTemplate>
            <telerik:RadComboBox.SelectionBoxTemplate>
                <DataTemplate>
                    <Image Source="{Binding LogoSmall}" RenderOptions.BitmapScalingMode="Fant" Width="24" Height="24"/>
                </DataTemplate>
            </telerik:RadComboBox.SelectionBoxTemplate>
        </telerik:RadComboBox>

        <TextBlock Grid.Column="0" Grid.Row="0" Style="{StaticResource titleTextBlock}" Text="MC#"/>
        <StackPanel Name="spSearchMc" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal">
            <TextBox Name="tbMc" Width="100"
                Style="{StaticResource editableTextBox}" 
                KeyDown="tbMcOrDot_KeyDown"/>
            <Button Margin="5" Width="70" Click="SearchClicked">Search</Button>
        </StackPanel>

        <TextBlock Grid.Column="0" Grid.Row="1" Style="{StaticResource titleTextBlock}" Text="DOT#"/>
        <StackPanel Name="spSearchDot" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal">
            <TextBox Name="tbDot" Width="100"
                Style="{StaticResource editableTextBox}" 
                KeyDown="tbMcOrDot_KeyDown"/>
            <TextBlock Margin="5">
                <Hyperlink Click="CarrierView_OnClick">brokersnapshot.com</Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- DoNotUse -->
        <TextBlock Grid.Column="2" Grid.Row="0" Style="{StaticResource titleTextBlock}" Text="Do Not Use" Foreground="Red"/>
        <CheckBox Grid.Column="3" Grid.Row="0" Style="{StaticResource CrossCheckBoxStyle}" VerticalAlignment="Center" Name="dnuCheckBox"
            IsChecked="{Binding DoNotUse, Mode=TwoWay}"></CheckBox>

        <!-- Rating -->
        <TextBlock Grid.Column="2" Grid.Row="1" Style="{StaticResource titleTextBlock}" Text="Rating"/>
        <telerik:RadRating VerticalAlignment="Center"
            Grid.Column="3" Grid.Row="1"
            MouseDown="RadRating_MouseDown"
            MouseUp="RadRating_MouseUp"  
            Value="{Binding Rating, Mode=TwoWay}" Precision="Item"/>

        <!--Comments-->
        <telerik:XamlDataProvider x:Name="xamlDataProvider" 
            Xaml="{Binding Comments, Mode=TwoWay}" 
            RichTextBox="{Binding ElementName=richTextBox}" 
            SetupDocument="{x:Static helpers:UIElementHelper.XamlDataProvider_OnSetupDocument}"/>
        <telerik:RadRichTextBox x:Name="richTextBox" 
            Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="2" Grid.RowSpan="2"
            Width="Auto" MinHeight="40"
            Style="{StaticResource fieldRadRichTextBox}"
            VerticalContentAlignment="Top"
            IsSelectionMiniToolBarEnabled="True"
            IsSpellCheckingEnabled="False"
            DocumentInheritsDefaultStyleSettings="True"
            FontFamily="Calibri" 
            FontSize="14" />


        <TextBlock Grid.Column="0" Grid.Row="2" Style="{StaticResource titleTextBlock}" Text="Entity Type"/>
        <TextBox Name="tbEntityType"
            Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="3"
            Style="{StaticResource valueTextBox}" 
            Text="{Binding EntityType, Converter={StaticResource EnumToDescriptionsConverter}, Mode=OneWay}"/>

        <TextBlock Grid.Column="0" Grid.Row="3" Style="{StaticResource titleTextBlock}" Text="Operating Status"/>
        <TextBox Name="tbOperatingStatus" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource valueTextBox}" 
            Text="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=Operating Status:}"/>

        <TextBlock Grid.Column="0" Grid.Row="4" Style="{StaticResource titleTextBlock}" Text="Legal Name"/>
        <TextBox Name="tbLegalName" Width="270"
            Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="3" 
            Style="{StaticResource editableTextBox}" 
            Text="{Binding Name, Mode=TwoWay}"/>

        <TextBlock Grid.Column="0" Grid.Row="5" Style="{StaticResource titleTextBlock}" Text="DBA Name"/>
        <TextBox Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="3" Style="{StaticResource valueTextBox}" 
            Text="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=DBA Name:}"/>

        <TextBlock Grid.Column="0" Grid.Row="6" Style="{StaticResource titleTextBlock}" Text="Physical Address"/>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="6" Grid.ColumnSpan="3">
            <Image Source="/AutoDispatch;component/Resources/ups.png" RenderOptions.BitmapScalingMode="Fant" Width="32" Height="32" Visibility="{Binding Phy_UpsStore, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Image Source="/AutoDispatch;component/Resources/usps.png" RenderOptions.BitmapScalingMode="Fant" Width="32" Height="32" Visibility="{Binding Phy_MailBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Style="{StaticResource valueTextBox}" 
                Text="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=Physical Address:}"/>
        </StackPanel>

        <TextBlock Grid.Column="0" Grid.Row="7" Style="{StaticResource titleTextBlock}" Text="Mailing Address"/>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="7" Grid.ColumnSpan="3">
            <Image Source="/AutoDispatch;component/Resources/ups.png" RenderOptions.BitmapScalingMode="Fant" Width="32" Height="32" Visibility="{Binding Mai_UpsStore, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Image Source="/AutoDispatch;component/Resources/usps.png" RenderOptions.BitmapScalingMode="Fant" Width="32" Height="32" Visibility="{Binding Mai_MailBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Style="{StaticResource valueTextBox}" 
                Text="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=Mailing Address:}"/>
        </StackPanel>

        <TextBlock Grid.Column="0" Grid.Row="8" Style="{StaticResource titleTextBlock}" Text="Phone"/>
        <userControls:PhoneLinkTextBlock Grid.Column="1" Grid.Row="8" Grid.ColumnSpan="3" Style="{StaticResource valueTextBlock}" 
            DataContext="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=Phone:}"/>

        <TextBlock Grid.Column="0" Grid.Row="9" Style="{StaticResource titleTextBlock}" Text="Contact Name"/>
        <TextBox Grid.Column="1" Grid.Row="9" Grid.ColumnSpan="3" Style="{StaticResource valueTextBox}" 
            Text="{Binding ContactNames, Mode=OneWay}"/>

        <TextBlock Grid.Column="0" Grid.Row="10" Style="{StaticResource titleTextBlock}" Text="USDOT Number"/>
        <TextBox Grid.Column="1" Grid.Row="10" Grid.ColumnSpan="3" Style="{StaticResource valueTextBox}" 
            Text="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=USDOT Number:}"/>

        <TextBlock Grid.Column="0" Grid.Row="11" Style="{StaticResource titleTextBlock}" Text="MC/MX/FF Number(s)"/>
        <TextBox Grid.Column="1" Grid.Row="11" Grid.ColumnSpan="3" Style="{StaticResource valueTextBox}" 
            Text="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=MC/MX/FF Number(s):}"/>

        <TextBlock Grid.Column="0" Grid.Row="12" Style="{StaticResource titleTextBlock}" Text="Power Units"/>
        <TextBox Grid.Column="1" Grid.Row="12" Grid.ColumnSpan="3" Style="{StaticResource valueTextBox}" 
            Text="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=Power Units:}"/>

        <TextBlock Grid.Column="0" Grid.Row="13" Style="{StaticResource titleTextBlock}" Text="MCS-150 Form Date"/>
        <TextBox Grid.Column="1" Grid.Row="13" Grid.ColumnSpan="3" Style="{StaticResource valueTextBox}" 
            Text="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=MCS-150 Form Date:}"/>

        <TextBlock Grid.Column="2" Grid.Row="7" Style="{StaticResource titleTextBlock}" Text="Out of Service Date"/>
        <TextBox Grid.Column="3" Grid.Row="7" Style="{StaticResource valueTextBox}" 
            Text="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=Out of Service Date:}"/>

        <TextBlock Grid.Column="2" Grid.Row="8" Style="{StaticResource titleTextBlock}" Text="State Carrier ID Number"/>
        <TextBox Grid.Column="3" Grid.Row="8" Style="{StaticResource valueTextBox}" 
            Text="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=State Carrier ID Number:}"/>

        <TextBlock Grid.Column="2" Grid.Row="9" Style="{StaticResource titleTextBlock}" Text="DUNS Number"/>
        <TextBox Grid.Column="3" Grid.Row="9" Style="{StaticResource valueTextBox}" 
            Text="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=DUNS Number:}"/>

        <TextBlock Grid.Column="2" Grid.Row="10" Style="{StaticResource titleTextBlock}" Text="Drivers"/>
        <TextBox Grid.Column="3" Grid.Row="10" Style="{StaticResource valueTextBox}" 
            Text="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=Drivers:}"/>

        <TextBlock Grid.Column="2" Grid.Row="11" Style="{StaticResource titleTextBlock}" Text="MCS-150 Mileage (Year)"/>
        <TextBox Grid.Column="3" Grid.Row="11" Style="{StaticResource valueTextBox}" 
            Text="{Binding Fields, Converter={StaticResource DictionaryToValueConverter}, ConverterParameter=MCS-150 Mileage (Year):}"/>

        <TextBlock Grid.Column="2" Grid.Row="12" Style="{StaticResource titleTextBlock}" Text="Hyperlink the File"/>
        <StackPanel Grid.Column="3" Grid.Row="12" VerticalAlignment="Center">
            <TextBlock Margin="4,2"
                Visibility="{Binding HyperlinkFile, Converter={StaticResource NotNullToVisibilityConverter}}">
                <Hyperlink Click="OpenHyperlinkFile_OnClick">
                    <Run Text="{Binding HyperlinkFileShort, Mode=OneWay}"/>
                </Hyperlink>
                <Run>|</Run>
                <Hyperlink Click="RemoveHyperlinkFile_OnClick">Remove</Hyperlink>
            </TextBlock>
            <TextBlock Margin="4,2"
                Visibility="{Binding HyperlinkFile, Converter={StaticResource NullToVisibilityConverter}}">
                <Hyperlink Click="UploadHyperlinkFile_OnClick">Upload</Hyperlink>
            </TextBlock>
        </StackPanel>

        <TextBlock Grid.Column="2" Grid.Row="13" Style="{StaticResource titleTextBlock}" Text="Setup Packet"/>
        <StackPanel Orientation="Horizontal" Grid.Column="3" Grid.Row="13" VerticalAlignment="Center"
            Visibility="{Binding SetupPacketCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Margin="4,2"
                Visibility="{Binding SetupPacketAccept, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                <Hyperlink Click="SetupPacketLink_OnClick">View</Hyperlink>
                <Run>|</Run>
                <Hyperlink Foreground="Green" Click="SetupPacketAccept_OnClick">Accept</Hyperlink>
                <Run>|</Run>
                <Hyperlink Foreground="Red" Click="SetupPacketReject_OnClick">Reject</Hyperlink>
            </TextBlock>
            <TextBlock Margin="4,2"
                Visibility="{Binding SetupPacketAccept, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Hyperlink Click="SetupPacketLink_OnClick">View</Hyperlink>
                <Run>|</Run>
                <Hyperlink Click="SetupPacketEdit_OnClick">Edit</Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,2,4,2" 
                Visibility="{Binding SetupPacket.Version, Converter={StaticResource Compare2ToVisibilityConverter}, ConverterParameter={StaticResource ByteOne}}">
                <Run>|</Run>
                <Hyperlink Click="SetupPacketSendV2_OnClick">Send V2</Hyperlink>
            </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="3" Grid.Row="13" Orientation="Horizontal"
            Visibility="{Binding SetupPacketCompleted, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <Button
                Width="120" Height="32" Margin="5,5,5,5"
                Click="SetupPacketSend_OnClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Visibility="{Binding SetupPacketSent, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                        VerticalAlignment="Center">Email Setup Packet</TextBlock>
                    <TextBlock Visibility="{Binding SetupPacketSent, Converter={StaticResource BooleanToVisibilityConverter}}"
                        VerticalAlignment="Center">Resend Email</TextBlock>
                </StackPanel>
            </Button>
            <TextBlock Margin="4,2" VerticalAlignment="Center"
                Visibility="{Binding SetupPacket, Converter={StaticResource NotNullToVisibilityConverter}}">
                <Hyperlink Click="SetupPacketLink_OnClick">View</Hyperlink>
                <Run>|</Run>
                <Hyperlink Click="SetupPacketEdit_OnClick">Edit</Hyperlink>
            </TextBlock>
        </StackPanel>

        <TextBlock Grid.Column="2" Grid.Row="14" Style="{StaticResource titleTextBlock}" Text="Factoring Company"
            Visibility="{Binding SetupPacket, Converter={StaticResource NotNullToVisibilityConverter}}"/>
        <TextBlock Grid.Column="3" Grid.Row="14" VerticalAlignment="Center" Margin="4,2"
            Visibility="{Binding SetupPacket, Converter={StaticResource NotNullToVisibilityConverter}}">
            <Run Text="{Binding SetupPacket.MailingCompanyLegalName}"></Run>
        </TextBlock>

        <TextBlock Grid.Column="0" Grid.Row="16" Style="{StaticResource titleTextBlock}" Text="Contacts" Margin="5,12,5,5" VerticalAlignment="Top"/>
        <userControls:ContactsControl x:Name="tbEContacts" Grid.Column="1" Grid.Row="16" Width="220" Margin="0,5,5,5" HorizontalAlignment="Left"
            DataContext="{Binding Contacts, Mode=TwoWay}"/>

        <TextBlock Grid.Column="0" Grid.Row="17" Style="{StaticResource titleTextBlock}" Text="Insurance Exiration"/>
        <StackPanel Grid.Column="1" Grid.Row="17" Orientation="Horizontal">
            <telerik:RadDatePicker Name="dpExpiration" HorizontalAlignment="Left" VerticalContentAlignment="Center" Width="120" Margin="5"
                SelectedDate="{Binding InsuranceExpiration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Browse" Margin="5" Width="80" 
                IsEnabled="{Binding InsuranceExpirationChanged, Mode=OneWay}"
                Click="InsuranceBrower_OnClicked"/>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="18" HorizontalAlignment="Center" Orientation="Vertical">
            <Image x:Name="imgShield" Margin="5" Height="64" Width="64" HorizontalAlignment="Center"
                Source="{Binding InsuranceState, Converter={StaticResource InsuranceStateTypeToUriConverter}}"/>
            <TextBlock Margin="5" HorizontalAlignment="Center"
                Visibility="{Binding InsuranceFilePath, Converter={StaticResource NotNullToVisibilityConverter}}">
                <Hyperlink Click="Insurance_OnClick">
                    <Run Text="{Binding InsuranceExpiration, StringFormat=Insurance until {0:d}}"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <!--Manage Files control-->
        <userControls:FilesControl x:Name="filesControl" Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="4" Grid.Row="16" 
             MaxHeight="300" Margin="5" DataContext="{Binding Files, Mode=OneWay}"/>

        <!--Error message-->
        <TextBlock x:Name="tbError" Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="5" Foreground="Red" MaxHeight="80" HorizontalAlignment="Right" Visibility="Collapsed" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar" Grid.Row="20" Grid.ColumnSpan="4" Margin="5" IsIndeterminate="True" Height="10" Visibility="Collapsed" />

        <Button x:Name="btnOk" Grid.Row="23" Grid.ColumnSpan="4" Style="{StaticResource OkButtonStyle}" Click="btnOk_Clicked">OK</Button>
        <Button x:Name="btnClose" Grid.Row="23" Grid.ColumnSpan="4" Style="{StaticResource CloseButtonStyle}" Click="btnClose_Clicked">Close</Button>
    </Grid>
</dialogs:BaseDispatchDialog>
