<dialogs:BaseDispatchDialog x:Class="AutoCall.WPF.Dialogs.Dispatch.EditYardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:AutoCall.WPF.Dialogs"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
        SizeToContent="WidthAndHeight" MinWidth="250" MinHeight="200"
        Icon="/AutoDispatch;component/Resources/icon.ico" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{x:Static SystemColors.ControlBrush}">
    <dialogs:BaseDispatchDialog.Resources>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
    </dialogs:BaseDispatchDialog.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource titleTextBlock}" Text="Name:" />
        <TextBox Grid.Row="0" Grid.Column="1" 
            Style="{StaticResource fieldTextBox}"
            Text="{Binding Name}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource titleTextBlock}" Text="Location:" />
        <Button Grid.Row="1" Grid.Column="1" Click="btnLocation_Clicked" Width="100" Content="Location" HorizontalAlignment="Left" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="5">
            <TextBlock Text="{Binding Address}"/>
            <TextBlock Text="{Binding City}"/>
        </StackPanel>

        <!--Error message-->
        <TextBlock x:Name="tbError" Grid.Row="4" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="5" Foreground="Red" HorizontalAlignment="Right" Visibility="Collapsed" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar" Grid.Row="4" Grid.ColumnSpan="2" Margin="5" IsIndeterminate="True" Visibility="Collapsed" />

        <Button x:Name="btnOk" Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Left" Click="btnOk_Clicked" Width="100" Margin="4">OK</Button>
        <Button x:Name="btnClose" Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Right" Click="btnClose_Clicked" IsCancel="True" Width="100" Margin="4">Close</Button>
    </Grid>
</dialogs:BaseDispatchDialog>
