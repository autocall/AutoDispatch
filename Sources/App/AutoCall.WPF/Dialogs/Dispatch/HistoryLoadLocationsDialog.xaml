<dialogs:BaseDispatchDialog x:Class="AutoCall.WPF.Dialogs.Dispatch.HistoryLoadLocationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AutoCall.WPF.Converters"
        xmlns:userControls="clr-namespace:AutoCall.WPF.UserControls"
        xmlns:dialogs="clr-namespace:AutoCall.WPF.Dialogs"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:dispatch="clr-namespace:AutoCall.WPF.Converters.Dispatch"
        Title="View Location History" Height="600"  Width="700" 
        Icon="/AutoDispatch;component/Resources/icon.ico" 
        WindowStartupLocation="CenterScreen"
        Loaded="HistoryLoadLocationsDialog_OnLoaded"
        Closed="HistoryLoadLocationsDialog_OnClosed"
        Background="{x:Static SystemColors.ControlBrush}">
    <dialogs:BaseDispatchDialog.Resources>
        <c:EnumToDescriptionConverter x:Key="enumToDescriptionConverter"/>
        <c:ToStringConverter x:Key="ToStringConverter"/>
        <dispatch:RtfToTextConverter x:Key="RtfToTextConverter"/>
    </dialogs:BaseDispatchDialog.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!--Loading control-->
        <userControls:LoadingControl x:Name="loading" Panel.ZIndex="100" Visibility="Visible" Grid.RowSpan="10" />

        <!--Toolbar-->
        <Border Grid.Row="0" BorderThickness="1,0" Margin="5,0" Background="{x:Static SystemColors.ControlBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <!--Create button-->
                </StackPanel>
            </Grid>
        </Border>

        <!--Dat Companies grid-->
        <telerik:RadGridView Grid.Row="1"
            Name="gridHistories"
            AutoGenerateColumns="False" 
            SelectionMode="Single" SelectionUnit="FullRow"
            ShowGroupPanel="False" AutoExpandGroups="False" IsFilteringAllowed="False"
            RowIndicatorVisibility="Collapsed" IsTabStop="False"
            CanUserReorderColumns="True" CanUserFreezeColumns="False" IsReadOnly="True" CanUserSortColumns="True"
            ShowColumnFooters="True" ShowGroupFooters="False"
            MouseDoubleClick="gridHistories_OnMouseDoubleClick"
            ItemsSource="{Binding Histories}"
            Background="{x:Static SystemColors.ControlBrush}">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="Date" DataMemberBinding="{Binding HistoryLocation.CreatedDate}" />
                <telerik:GridViewDataColumn Header="Location" DataMemberBinding="{Binding HistoryLocation.Location.FormattedAddress}" />
                <telerik:GridViewDataColumn Header="Comments" DataMemberBinding="{Binding History.Comments, Converter={StaticResource RtfToTextConverter}}" />
                <!--<telerik:GridViewDataColumn Header="Test Comment" DataMemberBinding="{Binding History.Index}" />-->
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
        <!--Error message-->
        <TextBlock x:Name="tbError" Grid.Row="2" TextWrapping="Wrap" Margin="5" Foreground="Red" MaxHeight="80" HorizontalAlignment="Right" Visibility="Collapsed" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar" Grid.Row="2" Margin="5" IsIndeterminate="True" Height="10" Visibility="Collapsed" />

        <Button x:Name="btnOk" Grid.Row="3" Style="{StaticResource OkButtonStyle}" Visibility="Collapsed">OK</Button>
        <Button x:Name="btnClose" Grid.Row="3" Style="{StaticResource CloseButtonStyle}" Click="btnClose_Clicked">Close</Button>
    </Grid>
</dialogs:BaseDispatchDialog>







