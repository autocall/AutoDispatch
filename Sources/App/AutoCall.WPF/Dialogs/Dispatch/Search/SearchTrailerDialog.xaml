<Window 
    x:Class="AutoCall.WPF.Dialogs.Dispatch.SearchTrailerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:userControls="clr-namespace:AutoCall.WPF.UserControls"
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    mc:Ignorable="d" 
    d:DesignHeight="400" d:DesignWidth="500"
    Width="500" Height="400"
    Title="Search Trailer" MinHeight="400"
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    WindowStartupLocation="CenterScreen"
    Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <!-- Converters -->
        <converters:ToStringConverter x:Key="ToStringConverter"/>
        <converters:NotNullToBoolConverter x:Key="ObjectToBoolConverter"/>
        <!--Loads collection source-->
        <!-- Use in codebehind -->
        <CollectionViewSource x:Key="WrappersViewSource" Source="{Binding Trailers}" IsLiveFilteringRequested="True" Filter="WrappersViewSource_OnFilter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <!--Loading control-->
        <userControls:LoadingControl x:Name="loading" Panel.ZIndex="100" Visibility="Visible" LoadingMessage="Loading..." Grid.RowSpan="10" />
        <!--Toolbar-->
        <Border Grid.Row="0" BorderThickness="1,0" Margin="5,0" Background="{x:Static SystemColors.ControlBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <!--Create button-->
                    <Button
                        Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="CreateTrailer_Clicked">
                        <StackPanel Orientation="Horizontal">
                            <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/add.png" Style="{StaticResource BoardButtonImageStyle}"></userControls:AutoGreyableImage>
                            <TextBlock VerticalAlignment="Center" Margin="3">Create</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!--Filter-->
                <telerik:RadWatermarkTextBox Name="tbLoadSearch"
                    Grid.Row="0" Grid.ColumnSpan="10" FontSize="12" 
                    HorizontalAlignment="Right" Width="120" Height="24" Margin="5"
                    WatermarkContent="Search"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="tbFilter_OnTextChanged" />
            </Grid>
        </Border>
        <!-- Trailers -->
        <telerik:RadGridView Name="gridTrailers" Grid.Row="1" 
            AutoGenerateColumns="False" 
            SelectionMode="Single" SelectionUnit="FullRow"
            RowIndicatorVisibility="Collapsed" ShowGroupPanel="False"
            CanUserReorderColumns="False" IsReadOnly="True" CanUserSortColumns="False"
            SelectedItem="{Binding SelectedWrapper, Mode=TwoWay}"
            MouseDoubleClick="grid_OnMouseDoubleClick">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="Trailer" DataMemberBinding="{Binding Number, FallbackValue='-'}" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <Button x:Name="btnOk" Grid.Row="2" Grid.ColumnSpan="4" Style="{StaticResource OkButtonStyle}" 
            IsEnabled="{Binding SelectedWrapper, Converter={StaticResource ObjectToBoolConverter}}"
            Click="btnOk_Clicked">OK</Button>
        <Button x:Name="btnClose" Grid.Row="2" Grid.ColumnSpan="4" Style="{StaticResource CloseButtonStyle}" Click="btnClose_Clicked">Close</Button>
    </Grid>
</Window>
