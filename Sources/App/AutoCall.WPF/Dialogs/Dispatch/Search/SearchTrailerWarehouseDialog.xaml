<Window 
    x:Class="AutoCall.WPF.Dialogs.Dispatch.SearchTrailerWarehouseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:userControls="clr-namespace:AutoCall.WPF.UserControls"
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    mc:Ignorable="d" 
    d:DesignHeight="400" d:DesignWidth="800"
    Width="800" Height="400"
    Title="Search Trailer" MinHeight="400"
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    WindowStartupLocation="CenterScreen"
    Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <!-- Converters -->
        <converters:ToStringConverter x:Key="ToStringConverter"/>
        <converters:NotNullToBoolConverter x:Key="ObjectToBoolConverter"/>
        <converters:InvertableBooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <!--Loads collection source-->
        <!-- Use in codebehind -->
        <CollectionViewSource x:Key="TrailerWrappersViewSource" Source="{Binding Trailers}" IsLiveFilteringRequested="True"
            Filter="TrailerWrappersViewSource_OnFilter"/>
        <CollectionViewSource x:Key="WarehouseWrappersViewSource" Source="{Binding Warehouses}" IsLiveFilteringRequested="True"
            Filter="WarehouseWrappersViewSource_OnFilter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="secondGridColumn" Width="*"/>
        </Grid.ColumnDefinitions>
        <!--Loading control-->
        <userControls:LoadingControl x:Name="loading" Panel.ZIndex="100" Grid.RowSpan="10" Grid.ColumnSpan="2"
            Visibility="Visible" LoadingMessage="Loading..." />
        <!--Toolbar-->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="5" FontSize="16" Name="titleTextBox"
            FontWeight="Bold" Text="Search Trailer" HorizontalAlignment="Center" />
        <ToggleButton Grid.Row="0" Grid.ColumnSpan="2" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" 
            Click="HasWarehouse_Clicked"
            ToolTip="Set Destination Warehouse"
            IsChecked="{Binding HasWarehouse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel Orientation="Horizontal">
                <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/database_active.png" Style="{StaticResource BoardButtonImageStyle}"/>
                <TextBlock VerticalAlignment="Center" Margin="3">Warehouse</TextBlock>
            </StackPanel>
        </ToggleButton>
        <!--Create Trailer button-->
        <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Margin="5"
            Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
            Click="CreateTrailer_Clicked">
            <StackPanel Orientation="Horizontal">
                <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/add.png" Style="{StaticResource BoardButtonImageStyle}"/>
                <TextBlock VerticalAlignment="Center" Margin="3">Create</TextBlock>
            </StackPanel>
        </Button>
        <!--Create Warehouse button-->
        <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="5"
            Visibility="{Binding HasWarehouse, Converter={StaticResource BoolToVisibilityConverter}}"
            Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
            Click="CreateWarehouse_Clicked">
            <StackPanel Orientation="Horizontal">
                <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/add.png" Style="{StaticResource BoardButtonImageStyle}"/>
                <TextBlock VerticalAlignment="Center" Margin="3">Create</TextBlock>
            </StackPanel>
        </Button>
        <!--Trailer Filter-->
        <telerik:RadWatermarkTextBox Name="tbTrailerSearch"
            Grid.Row="1" Grid.Column="0" FontSize="12" 
            HorizontalAlignment="Right" Width="120" Height="24" Margin="5"
            WatermarkContent="Search"
            Text="{Binding SearchTrailerText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="tbTrailerFilter_OnTextChanged" />
        <!--Warehouse Filter-->
        <telerik:RadWatermarkTextBox Name="tbWarehouseSearch" 
            Visibility="{Binding HasWarehouse, Converter={StaticResource BoolToVisibilityConverter}}"
            Grid.Row="1" Grid.Column="1" FontSize="12" 
            HorizontalAlignment="Right" Width="120" Height="24" Margin="5"
            WatermarkContent="Search"
            Text="{Binding SearchWarehouseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="tbWarehouseFilter_OnTextChanged" />
        <!-- Trailers -->
        <telerik:RadGridView Name="gridTrailers" Grid.Row="2" Grid.Column="0"
            AutoGenerateColumns="False" 
            SelectionMode="Single" SelectionUnit="FullRow"
            RowIndicatorVisibility="Collapsed" ShowGroupPanel="False"
            CanUserReorderColumns="False" IsReadOnly="True" CanUserSortColumns="False"
            SelectedItem="{Binding SelectedTrailerWrapper, Mode=TwoWay}"
            MouseDoubleClick="gridTrailers_OnMouseDoubleClick">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="Trailer" DataMemberBinding="{Binding Number, FallbackValue='-'}" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
        <!-- Warehouses -->
        <telerik:RadGridView Name="gridWarehouses" Grid.Row="2" Grid.Column="1" 
            Visibility="{Binding HasWarehouse, Converter={StaticResource BoolToVisibilityConverter}}"
            AutoGenerateColumns="False" Margin="5,0,0,0"
            SelectionMode="Single" SelectionUnit="FullRow"
            RowIndicatorVisibility="Collapsed" ShowGroupPanel="False"
            CanUserReorderColumns="False" IsReadOnly="True" CanUserSortColumns="False"
            SelectedItem="{Binding SelectedWarehouseWrapper, Mode=TwoWay}"
            MouseDoubleClick="gridWarehouses_OnMouseDoubleClick">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="Warehouse" DataMemberBinding="{Binding Name}" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <Button x:Name="btnOk" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource OkButtonStyle}" 
            IsEnabled="{Binding SelectedTrailerWrapper, Converter={StaticResource ObjectToBoolConverter}}"
            Click="btnOk_Clicked">OK</Button>
        <Button x:Name="btnClose" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource CloseButtonStyle}" 
            Click="btnClose_Clicked">Close</Button>
    </Grid>
</Window>
