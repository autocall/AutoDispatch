<ItemsControl x:Class="AutoCall.WPF.Dialogs.Dispatch.UserControls.FilterColumnsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:c="clr-namespace:AutoCall.WPF.Converters"
    mc:Ignorable="d"  d:DesignHeight="450" d:DesignWidth="800"
    DataContextChanged="ItemsControl_DataContextChanged"
    Background="{x:Static SystemColors.ControlBrush}">
        <ItemsControl.Resources>
            <c:BooleanToBrushConverter x:Key="BooleanToBrush1Converter" TrueBrush="#B4D4F4" FalseBrush="Transparent"/>
            <c:BooleanToBrushConverter x:Key="BooleanToBrush2Converter" TrueBrush="Gray" FalseBrush="LightGray"/>
        </ItemsControl.Resources>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border 
                    Background="{Binding Selected, Converter={StaticResource BooleanToBrush1Converter}}"
                    BorderBrush="{Binding Selected, Converter={StaticResource BooleanToBrush2Converter}}"
                    BorderThickness="1" CornerRadius="5" Padding="5, 0" Margin="3,5" Cursor="Hand"
                    MouseLeftButtonUp="bFilter_MouseLeftButtonUp">
                    <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding Name}" />
                    </TextBlock>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
</ItemsControl>
