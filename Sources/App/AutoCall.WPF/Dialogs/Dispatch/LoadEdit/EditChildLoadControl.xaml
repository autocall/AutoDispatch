<userControls1:EditBaseLoadControl 
    x:Class="AutoCall.WPF.Dialogs.Dispatch.UserControls.EditChildLoadControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    xmlns:dispatch="clr-namespace:AutoCall.WPF.Converters.Dispatch"
    xmlns:enums2="clr-namespace:AutoDispatch.Dtos.Enums;assembly=AutoDispatch.Dtos"
    xmlns:enums3="clr-namespace:AutoCall.Common.Enums;assembly=AutoDispatch.Dtos"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    xmlns:helpers="clr-namespace:AutoCall.WPF.Helpers"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:userControls="clr-namespace:AutoCall.WPF.UserControls"
    xmlns:userControls1="clr-namespace:AutoCall.WPF.Dialogs.Dispatch.UserControls"
    xmlns:core="clr-namespace:AutoCall.WPF.Core"
    xmlns:behaviors="clr-namespace:AutoCall.WPF.Behaviors"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="600"
    Loaded="EditBaseLoadControl_Loaded">
    <userControls1:EditBaseLoadControl.Resources>
        <!-- Proxy -->
        <core:BindingProxy x:Key="proxy" Data="{Binding}"/>
        <telerik:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:EditBaseLoadControl_ParseMatchConverter x:Key="ParseMatchConverter"/>
        <!-- Адресные подсказки уже отобраны Google (Safer autocomplete): клиентский StartsWith отсеивал бы
             "6558 West 73rd Street" при вводе "6558 W 73rd St" -->
        <behaviors:ShowAllFilteringBehavior x:Key="ShowAllFilteringBehavior"/>
        <converters:InvertableBooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionOrToStringConverter" AllowToString="True"/>
        <telerik:InvertedBooleanConverter x:Key="InvertedConverter"/>
        <converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter"/>
        <converters:NotNullToBoolConverter x:Key="NullToBoolConverter" Invert="True"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <converters:NotNullToVisibilityConverter x:Key="NullToVisibilityConverter" Invert="True"/>
        <converters:CompareToVisibilityConverter x:Key="CompareToVisibilityConverter"/>
        <dispatch:BookLoadDialog_BorderTypeToVisibilityConverter x:Key="BorderTypeToVisibilityConverter"/>
        <!-- STYLES -->
        <Style x:Key="title" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource titleTextBlock}"/>
        <Style TargetType="{x:Type userControls:RadRangeDateTimePicker}" BasedOn="{StaticResource fieldRadRangeDateTimePicker}"/>
        <Style TargetType="{x:Type telerik:RadDropDownButton}" BasedOn="{StaticResource fieldRadDropDownButton}"/>
        <Style TargetType="{x:Type telerik:RadNumericUpDown}" BasedOn="{StaticResource fieldRadNumericUpDown}"/>
        <Style TargetType="{x:Type telerik:RadRichTextBox}" BasedOn="{StaticResource fieldRadRichTextBox}"/>
        <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource fieldListBox}"/>
        <Style TargetType="{x:Type telerik:RadAutoCompleteBox}" BasedOn="{StaticResource fieldRadAutoCompleteBox}">
            <Setter Property="TextSearchMode" Value="StartsWith"/>
            <Setter Property="AutoCompleteMode" Value="Suggest"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
        </Style>
        <!-- Drop down item template -->
        <DataTemplate x:Key="searchQueryLoadKey" >
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,3,0" Foreground="Gray" HorizontalAlignment="Right" Text="company"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,3,0" Foreground="Gray" HorizontalAlignment="Right" Text="address"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,3,0" Foreground="Gray" HorizontalAlignment="Right" Text="city"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0" Text="{Binding Company}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0" Text="{Binding Address}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0" Text="{Binding City}"/>
            </Grid>
        </DataTemplate>
    </userControls1:EditBaseLoadControl.Resources>
    <Grid Grid.Row="0" Grid.Column="0" Background="{x:Static SystemColors.ControlBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--Toolbar -->
        <Grid Grid.Row="0" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal">
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal"
                Visibility="{Binding Load.Assigned, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}">
                <!-- Split Load -->
                <Button Margin="3" Click="btnSplit_OnClicked"
                    Focusable="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                    Visibility="{Binding Root.Load.ContainerType, Converter={StaticResource CompareToVisibilityConverter}, ConverterParameter={x:Static enums3:ContainerType.Quantity}}">
                    <StackPanel Orientation="Horizontal">
                        <userControls:AutoGreyableImage Margin="3,0,0,0" Source="/AutoDispatch;component/Resources/pallet.png" Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                        <TextBlock VerticalAlignment="Center" Margin="3,0,0,0">Split</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <!-- Container -->
        <Grid Grid.Row="1" ShowGridLines="False"
            DataContext="{Binding Load}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- 0 -->
                <RowDefinition Height="0"/>
                <!-- 1 -->
                <RowDefinition Height="Auto"/>
                <!-- 2 -->
                <RowDefinition Height="Auto"/>
                <!-- 3 -->
                <RowDefinition Height="Auto"/>
                <!-- 4 -->
                <RowDefinition Height="Auto"/>
                <!-- 5 -->
                <RowDefinition Height="37"/>
                <!-- 6 -->
                <RowDefinition Height="Auto"/>
                <!-- 7 -->
                <RowDefinition Height="Auto"/>
                <!-- 8 -->
                <RowDefinition Height="10"/>
                <!-- 9 -->
                <RowDefinition Height="Auto"/>
                <!-- 10 -->
                <RowDefinition Height="Auto"/>
                <!-- 11 -->
                <RowDefinition Height="Auto"/>
                <!-- 12 -->
                <RowDefinition Height="Auto"/>
                <!-- 13 -->
                <RowDefinition Height="Auto"/>
                <!-- 14 -->
                <RowDefinition Height="Auto"/>
                <!-- 15 -->
                <RowDefinition Height="Auto"/>
                <!-- 16 -->
                <RowDefinition Height="Auto"/>
                <!-- 17 -->
                <RowDefinition Height="Auto"/>
                <!-- 18 -->
                <RowDefinition Height="Auto"/>
                <!-- 19 -->
                <RowDefinition Height="Auto"/>
                <!-- 20 -->
                <RowDefinition Height="Auto"/>
                <!-- 21 -->
                <RowDefinition Height="Auto"/>
                <!-- 22 -->
                <RowDefinition Height="Auto"/>
                <!-- 23 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Pickup / Delivery -->
            <TextBlock Grid.Column="0" Grid.Row="1" Style="{StaticResource title}" Text="Pickup" />
            <TextBlock Grid.Column="2" Grid.Row="1" Style="{StaticResource title}" Text="Delivery" />
            <userControls:RadRangeDateTimePicker Grid.Column="1" Grid.Row="1"
                SelectedDate="{Binding PickupDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectedTime="{Binding PickupFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectedTime2="{Binding PickupTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <userControls:RadRangeDateTimePicker Grid.Column="3" Grid.Row="1"
                SelectedDate="{Binding DeliveryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectedTime="{Binding DeliveryFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectedTime2="{Binding DeliveryTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Shipper / Receiver -->
            <TextBlock Grid.Column="0" Grid.Row="2" Style="{StaticResource title}" Text="Shipper" />
            <TextBlock Grid.Column="2" Grid.Row="2" Style="{StaticResource title}" Text="Receiver" />
            <DockPanel Grid.Column="1" Grid.Row="2" LastChildFill="True">
                <telerik:RadButton x:Name="btnSendSmsPickup" Margin="-6,5,5,5"
                    DockPanel.Dock="Right" Width="24"
                    Focusable="True"
                    Style="{StaticResource attachedRadButton}"
                    Visibility="{Binding Data.SendSmsVisibility, Source={StaticResource proxy}}"
                    Click="btnSendSmsPickup_OnClick">
                    <Image Source="/AutoDispatch;component/Resources/email_send.png"/>
                </telerik:RadButton>
                <telerik:RadAutoCompleteBox DockPanel.Dock="Left"
                    SearchText="{Binding ShipperCompany, Mode=TwoWay}"
                    SearchTextChanged="cacheRadAutoCompleteBox_SearchTextChanged"
                    SelectionChanged="cacheRadAutoCompleteBox_SelectionChanged"
                    GotFocus="RadAutoCompleteBox_GotFocus"
                    LostFocus="RadAutoCompleteBox_LostFocus"
                    DisplayMemberPath="Company"
                    TextBoxStyle="{StaticResource UpperCaseTextBoxStyle}"
                    Tag="{x:Static enums2:CacheLoadIndexType.Origin}">
                </telerik:RadAutoCompleteBox>
            </DockPanel>
            <DockPanel Grid.Column="3" Grid.Row="2"  LastChildFill="True">
                <telerik:RadButton x:Name="btnSendSmsDelivery" Margin="-6,5,5,5"
                    DockPanel.Dock="Right" Width="24"
                    Focusable="True"
                    Style="{StaticResource attachedRadButton}"
                    Visibility="{Binding Data.SendSmsVisibility, Source={StaticResource proxy}}"
                    Click="btnSendSmsDelivery_OnClick">
                    <Image Source="/AutoDispatch;component/Resources/email_send.png"/>
                </telerik:RadButton>
                <telerik:RadAutoCompleteBox DockPanel.Dock="Left"
                    SearchText="{Binding ReceiverCompany, Mode=TwoWay}"
                    DropDownItemTemplate="{StaticResource searchQueryLoadKey}"
                    SearchTextChanged="cacheRadAutoCompleteBox_SearchTextChanged"
                    SelectionChanged="cacheRadAutoCompleteBox_SelectionChanged"
                    GotFocus="RadAutoCompleteBox_GotFocus"
                    LostFocus="RadAutoCompleteBox_LostFocus"
                    DisplayMemberPath="Company"
                    TextBoxStyle="{StaticResource UpperCaseTextBoxStyle}"
                    Tag="{x:Static enums2:CacheLoadIndexType.Destination}"/>
            </DockPanel>
            <!-- Address -->
            <TextBlock Grid.Column="0" Grid.Row="3" Style="{StaticResource title}" Text="Address" />
            <TextBlock Grid.Column="2" Grid.Row="3" Style="{StaticResource title}" Text="Address" />
            <telerik:RadAutoCompleteBox Grid.Column="1" Grid.Row="3"
                DropDownWidth="Auto"
                DisplayMemberPath="description"
                SearchText="{Binding OriginAddress, Mode=TwoWay}"
                SearchTextChanged="RadAutoCompleteBox_SearchAddressTextChanged"
                SelectionChanged="RadAutoCompleteBox_SearchAddressSelectionChanged"
                GotFocus="RadAutoCompleteBox_GotFocus"
                LostFocus="RadAutoCompleteBox_LostFocus"
                Tag="{x:Static enums2:CacheLoadIndexType.Origin}"
                FilteringBehavior="{StaticResource ShowAllFilteringBehavior}">
                <telerik:RadAutoCompleteBox.DropDownItemTemplate>
                    <DataTemplate>
                        <userControls:BindableTextBlock InlineList="{Binding Converter={StaticResource ParseMatchConverter}}" Margin="5,0"/>
                    </DataTemplate>
                </telerik:RadAutoCompleteBox.DropDownItemTemplate>
            </telerik:RadAutoCompleteBox>
            <Image Name="originBusy"
                Grid.Column="1" Grid.Row="3"
                Visibility="Collapsed" Margin="10,0"
                Width="16" Height="16" HorizontalAlignment="Right"
                gif:ImageBehavior.AnimatedSource="/AutoDispatch;component/Resources/circle_buzy.gif"/>
            <telerik:RadAutoCompleteBox Grid.Column="3" Grid.Row="3"
                DropDownWidth="Auto"
                DisplayMemberPath="description"
                SearchText="{Binding DestinationAddress, Mode=TwoWay}"
                SearchTextChanged="RadAutoCompleteBox_SearchAddressTextChanged"
                SelectionChanged="RadAutoCompleteBox_SearchAddressSelectionChanged"
                GotFocus="RadAutoCompleteBox_GotFocus"
                LostFocus="RadAutoCompleteBox_LostFocus"
                Tag="{x:Static enums2:CacheLoadIndexType.Destination}"
                FilteringBehavior="{StaticResource ShowAllFilteringBehavior}">
                <telerik:RadAutoCompleteBox.DropDownItemTemplate>
                    <DataTemplate>
                        <userControls:BindableTextBlock InlineList="{Binding Converter={StaticResource ParseMatchConverter}}" Margin="5,0"/>
                    </DataTemplate>
                </telerik:RadAutoCompleteBox.DropDownItemTemplate>
            </telerik:RadAutoCompleteBox>
            <Image Name="descriptionBusy"
                Grid.Column="3" Grid.Row="3"
                Visibility="Collapsed" Margin="10,0"
                Width="16" Height="16" HorizontalAlignment="Right"
                gif:ImageBehavior.AnimatedSource="/AutoDispatch;component/Resources/circle_buzy.gif"/>

            <!-- Origin / Destination -->
            <TextBlock Grid.Column="0" Grid.Row="4" Style="{StaticResource title}" Text="Origin" />
            <TextBlock Grid.Column="2" Grid.Row="4" Style="{StaticResource title}" Text="Destination" />
            <Grid Grid.Column="1" Grid.Row="4">
                <telerik:RadAutoCompleteBox
                    Name="originAutoComplete"
                    SearchText="{Binding OriginCity, Mode=TwoWay}"
                    DropDownItemTemplate="{StaticResource searchQueryLoadKey}"
                    SearchTextChanged="cacheRadAutoCompleteBox_SearchTextChanged"
                    SelectionChanged="cacheRadAutoCompleteBox_SelectionChanged"
                    GotFocus="RadAutoCompleteBox_GotFocus"
                    LostFocus="RadAutoCompleteBox_LostFocus"
                    DisplayMemberPath="City"
                    Tag="{x:Static enums2:CacheLoadIndexType.Origin}">
                    <telerik:RadAutoCompleteBox.Style>
                        <Style TargetType="{x:Type telerik:RadAutoCompleteBox}" BasedOn="{StaticResource {x:Type telerik:RadAutoCompleteBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OriginLocation, Converter={StaticResource NotNullToBoolConverter}}" Value="False">
                                    <Setter Property="BorderBrush" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </telerik:RadAutoCompleteBox.Style>
                </telerik:RadAutoCompleteBox>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Image Source="/AutoDispatch;component/Resources/check.png"
                        Visibility="{Binding OriginLocation, Converter={StaticResource NotNullToVisibilityConverter}}" Margin="5,0"
                        Width="16" Height="16" />
                    <telerik:RadButton Width="24"
                        Focusable="True"
                        Style="{StaticResource attachedRadButton}"
                        Click="btnOriginLocation_OnClick">
                        <Image Source="/AutoDispatch;component/Resources/pin_map_large.png"/>
                    </telerik:RadButton>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="3" Grid.Row="4">
                <telerik:RadAutoCompleteBox
                    Name="destinationAutoComplete"
                    SearchText="{Binding DestinationCity, Mode=TwoWay}"
                    DropDownItemTemplate="{StaticResource searchQueryLoadKey}"
                    SearchTextChanged="cacheRadAutoCompleteBox_SearchTextChanged"
                    SelectionChanged="cacheRadAutoCompleteBox_SelectionChanged"
                    GotFocus="RadAutoCompleteBox_GotFocus"
                    LostFocus="RadAutoCompleteBox_LostFocus"
                    DisplayMemberPath="City"
                    Tag="{x:Static enums2:CacheLoadIndexType.Destination}">
                    <telerik:RadAutoCompleteBox.Style>
                        <Style TargetType="{x:Type telerik:RadAutoCompleteBox}" BasedOn="{StaticResource {x:Type telerik:RadAutoCompleteBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DestinationLocation, Converter={StaticResource NotNullToBoolConverter}}" Value="False">
                                    <Setter Property="BorderBrush" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </telerik:RadAutoCompleteBox.Style>
                </telerik:RadAutoCompleteBox>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Image Source="/AutoDispatch;component/Resources/check.png"
                        Visibility="{Binding DestinationLocation, Converter={StaticResource NotNullToVisibilityConverter}}" Margin="5,0"
                        Width="16" Height="16" />
                    <telerik:RadButton HorizontalAlignment="Right" Width="24"
                        Focusable="True"
                        Style="{StaticResource attachedRadButton}"
                        Click="btnDestinationLocation_OnClick">
                        <Image Source="/AutoDispatch;component/Resources/pin_map_large.png"/>
                    </telerik:RadButton>
                </StackPanel>
            </Grid>

            <!-- Contacts -->
            <TextBlock Grid.Column="0" Grid.Row="5" Style="{StaticResource title}" Text="Contacts" />
            <TextBlock Grid.Column="2" Grid.Row="5" Style="{StaticResource title}" Text="Contacts" />
            <Grid Grid.Column="1" Grid.Row="5" Grid.RowSpan="2">
                <userControls1:ContactsControl DataContext="{Binding ShipperContacts, Mode=TwoWay}"/>
            </Grid>
            <Grid Grid.Column="3" Grid.Row="5" Grid.RowSpan="2">
                <userControls1:ContactsControl DataContext="{Binding ReceiverContacts, Mode=TwoWay}"/>
            </Grid>

            <!-- Pickup/Delivery Number -->
            <TextBlock Grid.Column="0" Grid.Row="7" Style="{StaticResource title}" Text="PU #" />
            <TextBlock Grid.Column="2" Grid.Row="7" Style="{StaticResource title}" Text="Del #" />
            <TextBox Grid.Column="1" Grid.Row="7" Style="{StaticResource fieldTextBox}" Text="{Binding PickupNumber, Mode=TwoWay}"/>
            <TextBox Grid.Column="3" Grid.Row="7" Style="{StaticResource fieldTextBox}" Text="{Binding DeliveryNumber, Mode=TwoWay}"/>

            <!-- Booked Date-->
            <TextBlock Grid.Column="0" Grid.Row="9" 
                Style="{StaticResource titleTextBlock}" 
                Text="Date"/>
            <TextBlock Grid.Column="1" Grid.Row="9" 
                Style="{StaticResource fieldTextBlock}"
                Text="{Binding BookedDate, StringFormat=M/d/yyyy h:mm tt}"/>
            <!-- Distance -->
            <TextBlock Grid.Column="2" Grid.Row="9" 
                Style="{StaticResource titleTextBlock}" 
                Text="Distance"/>
            <TextBlock Grid.Column="3" Grid.Row="9" 
                Style="{StaticResource fieldTextBlock}"
                Text="{Binding Distance, StringFormat={}{0} mi, TargetNullValue=-}"
                Visibility="{Binding DistanceLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}" />
            <Image
                Grid.Column="3" Grid.Row="9" 
                Visibility="{Binding DistanceLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                Width="16" Height="16" Margin="10,0" HorizontalAlignment="Left"
                gif:ImageBehavior.AnimatedSource="/AutoDispatch;component/Resources/circle_buzy.gif" />

            <!-- LineHaul -->
            <TextBlock x:Name="a01" Grid.Column="2" Grid.Row="10" 
                Style="{StaticResource titleTextBlock}"
                Text="Line Haul"/>
            <StackPanel x:Name="a02" Grid.Column="3" Grid.Row="10"
                Orientation="Horizontal">
                <telerik:RadNumericUpDown
                    NumberDecimalDigits="2"
                    ShowButtons="False"
                    Value="{Binding LineHaul, Mode=TwoWay, TargetNullValue=''}" 
                    Width="80" Margin="0,5,0,5"/>
                <telerik:RadButton 
                    Content="{Binding Currency, Converter={StaticResource EnumToDescriptionConverter}}"
                    Style="{StaticResource attachedRadButton}"
                    Padding="8,0"
                    Click="Currency_OnClicked" />
            </StackPanel>

            <!-- Rate -->
            <TextBlock Grid.Column="2" Grid.Row="11"
                Style="{StaticResource titleTextBlock}"
                Text="DAT Rate"/>
            <TextBlock Grid.Column="3" Grid.Row="11" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,2,0">
                <Run Text="{Binding Currency, Converter={StaticResource EnumToDescriptionConverter}, Mode=OneWay}"/>
                <Run Text="{Binding DatRate, StringFormat=C0, Mode=OneWay}"/>
            </TextBlock>

            <!-- Length -->
            <TextBlock Grid.Row="16" Grid.Column="0"
                Style="{StaticResource titleTextBlock}"><Run Text="Length"/><Run Text=" "/><Run Foreground="Gray" Text="(ft)"/></TextBlock>
            <telerik:RadComboBox 
                Grid.Row="16" Grid.Column="1" 
                Width="100"
                IsEditable="True" IsTextSearchEnabled="False"
                Style="{StaticResource fieldRadComboBox}"
                Text="{Binding Length, Mode=TwoWay, TargetNullValue=''}">
                <telerik:RadComboBoxItem Content="53"/>
                <telerik:RadComboBoxItem Content="48"/>
                <telerik:RadComboBoxItem Content="45"/>
                <telerik:RadComboBoxItem Content="20"/>
            </telerik:RadComboBox>
            <!-- Weight -->
            <TextBlock Grid.Row="17" Grid.Column="0" 
                Style="{StaticResource titleTextBlock}"><Run Text="Weight"/><Run Text=" "/><Run Foreground="Gray" Text="(kLbs)"/></TextBlock>
            <StackPanel Orientation="Horizontal" Grid.Row="17" Grid.Column="1">
                <telerik:RadComboBox 
                    Width="100"
                    IsEditable="True" IsTextSearchEnabled="False"
                    Style="{StaticResource fieldRadComboBox}"
                    Text="{Binding Weight, Mode=TwoWay, TargetNullValue=''}" >
                    <telerik:RadComboBoxItem Content="50"/>
                    <telerik:RadComboBoxItem Content="45"/>
                    <telerik:RadComboBoxItem Content="40"/>
                    <telerik:RadComboBoxItem Content="35"/>
                    <telerik:RadComboBoxItem Content="30"/>
                    <telerik:RadComboBoxItem Content="25"/>
                    <telerik:RadComboBoxItem Content="20"/>
                    <telerik:RadComboBoxItem Content="15"/>
                    <telerik:RadComboBoxItem Content="10"/>
                    <telerik:RadComboBoxItem Content="5"/>
                    <telerik:RadComboBoxItem Content="2"/>
                </telerik:RadComboBox>
                <telerik:RadButton 
                    Style="{StaticResource fieldRadButton}"
                    Click="WeightType_OnClicked" Width="100" Height="28"                    
                    Content="{Binding WeightType, Converter={StaticResource EnumToDescriptionConverter}}"/>
            </StackPanel>

            <!-- Pallets -->
            <TextBlock Grid.Row="18" Grid.Column="0" 
                Style="{StaticResource titleTextBlock}"
                Text="Pallets" />
            <telerik:RadNumericUpDown Grid.Row="18" Grid.Column="1" 
                HorizontalContentAlignment="Left"
                Width="100" NumberDecimalDigits="0" ShowButtons="False" 
                Style="{StaticResource fieldRadNumericUpDown}"
                Value="{Binding Pallets, TargetNullValue=''}" />

            <!-- Trailer Scheme -->
            <TextBlock
                Grid.Row="19" Grid.Column="0"
                Style="{StaticResource titleTextBlock}"
                Text="Trailer Scheme" />
            <Grid Grid.Row="19" Grid.Column="1" Background="{x:Static SystemColors.ControlBrush}">
                <TextBlock Style="{StaticResource titleTextBlock}" Margin="0"
                    Visibility="{Binding TrailerSchemeFile, Converter={StaticResource NotNullToVisibilityConverter} }">
                    <Hyperlink Click="TrailerScheme_OnClick" ToolTip="{Binding TrailerSchemeFile}">
                        <Run>Open</Run>
                    </Hyperlink>
                </TextBlock>
            </Grid>

            <!--Comments1-->
            <TextBlock Grid.Row="21" Grid.Column="0" 
                Style="{StaticResource titleTextBlock}"
                Text="Comments&#x0a;for Dispatcher"
                TextAlignment="Right"
                Visibility="{Binding BoardType, Converter={StaticResource BorderTypeToVisibilityConverter}, ConverterParameter={x:Static enums2:DispatchBoardType.Carrier}}"/>
            <TextBlock Grid.Row="21" Grid.Column="0" 
                Style="{StaticResource titleTextBlock}"
                Text="External&#x0a;Comments"
                TextAlignment="Right"
                Visibility="{Binding BoardType, Converter={StaticResource BorderTypeToVisibilityConverter}, ConverterParameter={x:Static enums2:DispatchBoardType.Broker}}"/>
            <telerik:XamlDataProvider x:Name="xamlDataProvider" 
                Xaml="{Binding Comments, Mode=TwoWay}" 
                RichTextBox="{Binding ElementName=richTextBox}" 
                SetupDocument="{x:Static helpers:UIElementHelper.XamlDataProvider_OnSetupDocument}"/>
            <telerik:RadRichTextBox x:Name="richTextBox" 
                Grid.Row="21" Grid.RowSpan="2" Grid.Column="1"
                Width="Auto" MinHeight="40" MaxHeight="100" Margin="0,5,6,5"
                Style="{StaticResource fieldRadRichTextBox}"
                VerticalContentAlignment="Top"
                IsSelectionMiniToolBarEnabled="True"
                IsSpellCheckingEnabled="False"
                DocumentInheritsDefaultStyleSettings="True"
                FontFamily="Calibri" 
                FontSize="14" />
            <!--Comments2-->
            <TextBlock Grid.Row="21" Grid.Column="2" 
                Style="{StaticResource titleTextBlock}"
                Text="Comments&#x0a;for Broker"
                TextAlignment="Right"
                Visibility="{Binding BoardType, Converter={StaticResource BorderTypeToVisibilityConverter}, ConverterParameter={x:Static enums2:DispatchBoardType.Carrier}}"/>
            <TextBlock Grid.Row="21" Grid.Column="2" 
                Style="{StaticResource titleTextBlock}"
                Text="Internal&#x0a;Comments"
                TextAlignment="Right"
                Visibility="{Binding BoardType, Converter={StaticResource BorderTypeToVisibilityConverter}, ConverterParameter={x:Static enums2:DispatchBoardType.Broker}}"/>
            <telerik:XamlDataProvider x:Name="xamlDataProvider2" 
                Xaml="{Binding Comments2, Mode=TwoWay}" 
                RichTextBox="{Binding ElementName=richTextBox2}" 
                SetupDocument="{x:Static helpers:UIElementHelper.XamlDataProvider_OnSetupDocument}"/>
            <telerik:RadRichTextBox x:Name="richTextBox2" 
                Grid.Row="21" Grid.RowSpan="2" Grid.Column="3"
                Width="Auto" MinHeight="40" MaxHeight="100" Margin="0,5,6,5"
                Style="{StaticResource fieldRadRichTextBox}"
                VerticalContentAlignment="Top"
                IsSelectionMiniToolBarEnabled="True"
                IsSpellCheckingEnabled="False"
                DocumentInheritsDefaultStyleSettings="True"
                FontFamily="Calibri" 
                FontSize="14" />

            <!--Foreground-->
            <TextBlock
                Grid.Row="23" Grid.Column="0" 
                Style="{StaticResource titleTextBlock}"
                Text="Foreground"/>
            <telerik:RadDropDownButton Grid.Row="23" Grid.Column="1" 
                Width="100" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <telerik:RadDropDownButton.DropDownContent>
                    <telerik:RadColorSelector SelectedColor="{Binding Foreground, Mode=TwoWay}"
                        SelectedColorChanged="RadColorSelector_SelectedColorChanged" />
                </telerik:RadDropDownButton.DropDownContent>
                <Border Background="{Binding Foreground, Converter={StaticResource ColorToBrushConverter}, Mode=OneWay}"/>
            </telerik:RadDropDownButton>
            <!--Background-->
            <TextBlock
                Grid.Row="23" Grid.Column="2"
                Style="{StaticResource titleTextBlock}"
                Text="Background" />
            <telerik:RadDropDownButton Grid.Row="23" Grid.Column="3" 
                Width="100" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <telerik:RadDropDownButton.DropDownContent>
                    <telerik:RadColorSelector SelectedColor="{Binding Background, Mode=TwoWay}"
                        SelectedColorChanged="RadColorSelector_SelectedColorChanged" />
                </telerik:RadDropDownButton.DropDownContent>
                <Border Background="{Binding Background, Converter={StaticResource ColorToBrushConverter}, Mode=OneWay}"/>
            </telerik:RadDropDownButton>
        </Grid>
    </Grid>
</userControls1:EditBaseLoadControl>

