<UserControl x:Class="AutoCall.WPF.Dialogs.Dispatch.UserControls.FilesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.CommandBindings>
        <CommandBinding Command="Delete" Executed="CommandDeleteFileExecuted" CanExecute="CommandBindingCanExecute" />
        <CommandBinding Command="Copy" Executed="CommandCopyFileExecuted" CanExecute="CommandBindingCanExecute" />
        <CommandBinding Command="Open" Executed="CommandOpenFileExecuted" />
    </UserControl.CommandBindings>
    <UserControl.Resources>
        <converters:LongToSizeFileConverter x:Key="LongToSizeFileConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" Value="0" Inverted="False"/>
    </UserControl.Resources>
    <Grid>
        <!--Loading control-->
        <telerik:RadProgressBar
            x:Name="loadingFiles"
            Height="8"
            Margin="20, 0"
            VerticalAlignment="Center"
            IsIndeterminate="True" Panel.ZIndex="1" 
            Visibility="Collapsed"/>
        <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            Name="filesListBox" Margin="0"
            ItemsSource="{Binding}"
            VerticalContentAlignment="Top" 
            AllowDrop="True" Drop="FileDrop"
            MouseDoubleClick="filesListBox_MouseDoubleClick"
            MouseDown="filesListBox_MouseDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <EventSetter Event="MouseDoubleClick" Handler="FileDoubleClick" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="Open"/>
            </ListBox.InputBindings>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open" Command="Open" />
                    <Separator />
                    <MenuItem Header="Copy" Command="Copy" />
                    <MenuItem Header="Delete" Command="Delete" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2" ToolTip="{Binding Name}">
                        <Image
                            Margin="5,0,5,0"
                            Source="{Binding IconImage}" 
                            DockPanel.Dock="Left" 
                            Width="16" Height="16"
                            RenderOptions.BitmapScalingMode="Fant" 
                            HorizontalAlignment="Center" />
                        <TextBlock 
                            DockPanel.Dock="Top" 
                            Text="{Binding Name}"
                            FontSize="12" 
                            VerticalAlignment="Bottom" />
                        <!--<TextBlock 
                            DockPanel.Dock="Bottom" 
                            Text="{Binding Size, Converter={StaticResource LongToSizeFileConverter}}" 
                            FontSize="10"
                            Foreground="Gray" 
                            VerticalAlignment="Center" />
                        <TextBlock 
                            DockPanel.Dock="Bottom" 
                            Text="{Binding CreatedDate}" 
                            FontSize="10"
                            Foreground="Gray" 
                            VerticalAlignment="Center" />-->
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Medium" Foreground="LightGray"
            Visibility="{Binding Count, Converter={StaticResource IntToVisibilityConverter}}"
            MouseDown="filesListBox_MouseDoubleClick">
            Double Click to Upload
        </TextBlock>
    </Grid>
</UserControl>
