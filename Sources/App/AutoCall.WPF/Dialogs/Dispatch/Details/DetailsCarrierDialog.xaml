<dispatch1:DetailsBaseDialog 
    x:Class="AutoCall.WPF.Dialogs.Dispatch.DetailsCarrierDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    xmlns:core="clr-namespace:AutoCall.WPF.Core"
    xmlns:userControls="clr-namespace:AutoCall.WPF.Dialogs.Dispatch.UserControls"
    xmlns:dispatch="clr-namespace:AutoCall.WPF.Converters.Dispatch"
    xmlns:userControls1="clr-namespace:AutoCall.WPF.UserControls"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:helpers="clr-namespace:AutoCall.WPF.Helpers"
    xmlns:dispatch1="clr-namespace:AutoCall.WPF.Dialogs.Dispatch"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:AutoCall.WPF.Behaviors"
    mc:Ignorable="d" 
    Title="Carrier Details" Width="500" MaxHeight="800" MinHeight="400" SizeToContent="Height"
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    WindowStartupLocation="CenterScreen"
    Closed="DatCompanyDetailsDialog_OnClosed"
    MouseDown="Window_OnMouseDown"
    Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <Style x:Key="valueTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Margin" Value="5,2,5,3"/>
        </Style>
        <Style x:Key="titleTextBlock2" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource titleTextBlock}">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="5,2,5,3"/>
        </Style>

        <converters:AnyToVisibilityConverter x:Key="AnyToVisibilityConverter"/>
        <converters:CompareToVisibilityConverter x:Key="CompareToVisibilityConverter"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <converters:NotNullToVisibilityConverter x:Key="NullToVisibilityConverter" Invert="True"/>
        <converters:StringToFlowDocumentConverter x:Key="StringToFlowDocumentConverter"/>
        <converters:ToStringConverter x:Key="ToStringConverter"/>
        <dispatch:ContactsControl_CountToVisibilityConverter x:Key="CountToVisibilityConverter" Count="1"/>
        <telerik:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <core:BindingProxy x:Key="proxy" Data="{Binding}"/>
        <core:BindingProxy x:Key="rootProxy" Data="{Binding RelativeSource={RelativeSource AncestorType={x:Type dispatch1:DetailsBaseDialog}, Mode=FindAncestor}}"/>
        <Style TargetType="TextBlock" x:Key="TextBlockValueStyle1" BasedOn="{StaticResource TextBlockValueStyle}">
            <Setter Property="Margin" Value="5,2,5,3"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource fieldTextBox}"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="5">
            <Grid>
                <!--Loading control-->
                <userControls1:LoadingControl x:Name="loading" Panel.ZIndex="100" Visibility="Collapsed" />
                <StackPanel>
                    <!-- DAT company -->
                    <Grid Margin="0" MouseDown="driver_OnMouseDown">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderThickness="1" BorderBrush="Black" Background="White" >
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0" Style="{StaticResource titleTextBlock2}" Text="Name"/>
                                <StackPanel Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TextBlockValueStyle}">
                                        <Hyperlink Click="CompanyName_OnClick">
                                            <Run Text="{Binding DatCompany.Name}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Foreground="Red" VerticalAlignment="Center" FontWeight="Bold" 
                                        Visibility="{Binding DatCompany.DoNotUse, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        (Do Not Use)
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Column="0" Grid.Row="1" Style="{StaticResource titleTextBlock2}" Text="DOT#"/>
                                <TextBox Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource valueTextBox}" 
                                    Text="{Binding DatCompany.DotNumber}"/>

                                <TextBlock Grid.Column="0" Grid.Row="2" Style="{StaticResource titleTextBlock2}" Text="MC#"/>
                                <TextBox Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource valueTextBox}" 
                                    Text="{Binding DatCompany.McNumber}"/>

                                <TextBlock Grid.Column="0" Grid.Row="3" Style="{StaticResource titleTextBlock2}" Text="Contacts" />
                                <TextBlock Grid.Column="1" Grid.Row="3" Style="{StaticResource TextBlockValueStyle}">
                                <Hyperlink Click="Phone_OnClicked" >
                                    <Run Text="{Binding DatCompany.Contacts, Converter={StaticResource ToStringConverter}}"/>
                                </Hyperlink>
                                </TextBlock>
                                <StackPanel Grid.Column="1" Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <!-- Next Contact-->
                                    <telerik:RadButton  Height="30" Margin="0,0,5,0" Padding="5" Click="NextContacts_OnClicked"
                                        Visibility="{Binding DatCompany.Contacts.Contacts, Converter={StaticResource CountToVisibilityConverter}}">
                                        <Image Source="/AutoDispatch;component/Resources/black_arrow.png"/>
                                    </telerik:RadButton>
                                    <!-- Edit Contact-->
                                    <telerik:RadButton  Height="30" Margin="0" Padding="5" Click="EditContacts_OnClicked">
                                        <Image Source="/AutoDispatch;component/Resources/black_edit.png"/>
                                    </telerik:RadButton>
                                </StackPanel>
                                <telerik:XamlDataProvider Name="xamlDataProvider"
                                    DataContext="{Binding DatCompany, Mode=OneTime}"
                                    Xaml="{Binding Comments, Mode=OneWay}" 
                                    RichTextBox="{Binding ElementName=richTextBox}" 
                                    SetupDocument="{x:Static helpers:UIElementHelper.XamlDataProvider_OnSetupDocument}"/>
                                <telerik:RadRichTextBox Name="richTextBox" Grid.Row="4" Grid.ColumnSpan="3" 
                                    Width="Auto" Margin="5" BorderThickness="0"
                                    DataContext="{Binding DatCompany, Mode=OneTime}"
                                    Visibility="{Binding Comments, Converter={StaticResource NotNullToVisibilityConverter}}"
                                    IsReadOnly="True"
                                    Style="{StaticResource fieldRadRichTextBox}"
                                    VerticalContentAlignment="Top"
                                    HorizontalAlignment="Left"
                                    IsSpellCheckingEnabled="False"
                                    IsContextMenuEnabled="False"
                                    IsSelectionMiniToolBarEnabled="False"
                                    IsImageMiniToolBarEnabled="False">
                                </telerik:RadRichTextBox>
                            </Grid>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit Comments" DataContext="{Binding DatCompany, Mode=OneTime}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <EventSetter Event="Click" Handler="editComments_OnClicked"/>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                        </Border>
                    </Grid>
                    <!-- Loads of DAT company -->
                    <Grid Margin="0" MouseDown="driver_OnMouseDown">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <telerik:RadTreeView Grid.Row="1" x:Name="companyLoadsListView"
                            SelectionMode="Single"
                            BorderThickness="0" BorderBrush="Black" 
                            ItemsSource="{Binding DatCompany.Loads, Mode=OneWay}" 
                            SelectedItem="{Binding SelectedLoad, Mode=OneWayToSource}"
                            HorizontalContentAlignment="Stretch" 
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <i:Interaction.Behaviors>
                                <!-- NOTE: REMEMBE, THE BEHAVIOR MUST BE PUBLIC -->
                                <behaviors:RadTreeViewMultiSelectBehavior SelectedItems="{Binding SelectedLoads}" />
                            </i:Interaction.Behaviors>
                            <telerik:RadTreeView.ItemContainerStyle>
                                <Style TargetType="telerik:RadTreeViewItem" BasedOn="{StaticResource LoadsRadTreeViewItemStyle}">
                                    <Setter Property="IsExpanded" Value="True"/>
                                    <EventSetter Event="MouseDoubleClick" Handler="loadItemsControl_MouseDoubleClick"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Edit Comments1" DataContext="{Binding Load}">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem">
                                                            <EventSetter Event="Click" Handler="editComments_OnClicked"/>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </telerik:RadTreeView.ItemContainerStyle>
                            <telerik:RadTreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid>
                                        <userControls:LoadDetails/>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,20,0,0">
                                            <!-- New Confirmation -->
                                            <Button Width="130" Style="{StaticResource ButtonInDetailsStyle}"
                                                Command="{Binding Data.dc.CreateConfirmationCommand, Source={StaticResource rootProxy}}"
                                                CommandParameter="{Binding}">Confirmation</Button>
                                            <!-- Edit Confirmation -->
                                            <Button Width="130" Style="{StaticResource ButtonInDetailsStyle}"
                                                Command="{Binding Data.dc.EditConfirmationCommand, Source={StaticResource rootProxy}}"
                                                CommandParameter="{Binding}">Edit Confirmation</Button>
                                            <!-- Send -->
                                            <Button Width="130" Style="{StaticResource ButtonInDetailsStyle}"
                                                Command="{Binding Data.dc.SendConfirmationCommand, Source={StaticResource rootProxy}}"
                                                CommandParameter="{Binding}">Send Confirmation</Button>
                                            <!-- Resend -->
                                            <Button Width="130" Style="{StaticResource ButtonInDetailsStyle}"
                                                Command="{Binding Data.dc.ResendConfirmationCommand, Source={StaticResource rootProxy}}"
                                                CommandParameter="{Binding}">Resend Confirmation</Button>
                                            <!--Enable CarrierView Tracker-->
                                            <Button Width="130" Style="{StaticResource ButtonInDetailsStyle}"
                                                Command="{Binding Data.dc.EnableCarrierViewTrackerCommand, Source={StaticResource rootProxy}}" 
                                                CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <userControls1:AutoGreyableImage Source="/AutoDispatch;component/Resources/carrierview.png"
                                                        Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                                    <TextBlock VerticalAlignment="Center" Margin="3">Enable Tracker</TextBlock>
                                                </StackPanel>
                                            </Button>
                                            <!--Disable CarrierView Tracker-->
                                            <Button Width="130" Style="{StaticResource ButtonInDetailsStyle}"
                                                Command="{Binding Data.dc.DisableCarrierViewTrackerCommand, Source={StaticResource rootProxy}}" 
                                                CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <userControls1:AutoGreyableImage Source="/AutoDispatch;component/Resources/carrierview.png"
                                                        Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                                    <TextBlock VerticalAlignment="Center" Margin="3">Disable Tracker</TextBlock>
                                                </StackPanel>
                                            </Button>
                                            <!--Sync CarrierView Tracker-->
                                            <Button Width="130" Style="{StaticResource ButtonInDetailsStyle}"
                                                Command="{Binding Data.dc.SyncCarrierViewTrackerCommand, Source={StaticResource rootProxy}}" 
                                                CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <userControls1:AutoGreyableImage Source="/AutoDispatch;component/Resources/carrierview.png"
                                                        Style="{StaticResource ResourceKey=BoardButtonImageStyle}"/>
                                                    <TextBlock VerticalAlignment="Center" Margin="3">Sync Tracker</TextBlock>
                                                </StackPanel>
                                            </Button>
                                            <!-- Bill of Lading -->
                                            <Button Width="100" Style="{StaticResource ButtonInDetailsStyle}"
                                                Command="{Binding Data.dc.CreateBOLCommand, Source={StaticResource rootProxy}}"
                                                CommandParameter="{Binding}">Bill of Lading</Button>
                                            <!-- Pickup -->
                                            <Button Width="100" Style="{StaticResource ButtonInDetailsStyle}"
                                                Command="{Binding Data.dc.BrokerDispatchPickedUpCommand, Source={StaticResource rootProxy}}"
                                                CommandParameter="{Binding}">Picked Up</Button>
                                            <!-- Delivered -->
                                            <Button Width="100" Style="{StaticResource ButtonInDetailsStyle}"
                                                Command="{Binding Data.dc.BrokerDispatchDeliveredCommand, Source={StaticResource rootProxy}}"
                                                CommandParameter="{Binding}">Delivered</Button>
                                        </StackPanel>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </telerik:RadTreeView.ItemTemplate>
                        </telerik:RadTreeView>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--Error message-->
        <TextBlock x:Name="tbError" Grid.Row="1" TextWrapping="Wrap" Margin="5" Foreground="Red" MaxHeight="80" HorizontalAlignment="Right" Visibility="Collapsed" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar" Grid.Row="1" Margin="5" IsIndeterminate="True" Height="10" Visibility="Collapsed" />

        <!--<Button x:Name="btnOk" Grid.Row="2" Style="{StaticResource OkButtonStyle}" Visibility="Collapsed">OK</Button>-->
        <Button x:Name="btnClose" Grid.Row="2" Style="{StaticResource CloseButtonStyle}" Click="btnClose_Clicked">Close</Button>
    </Grid>
</dispatch1:DetailsBaseDialog>