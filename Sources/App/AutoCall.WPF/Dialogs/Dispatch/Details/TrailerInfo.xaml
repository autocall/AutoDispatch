<UserControl x:Class="AutoCall.WPF.Dialogs.Dispatch.UserControls.TrailerInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:userControls="clr-namespace:AutoCall.WPF.UserControls"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource titleTextBlock}" Text="Trailer"/>
        <TextBlock Grid.Column="1" Style="{StaticResource TextBlockValueStyle}" FontWeight="Bold">
            <Run Text="{Binding Number, Mode=OneTime}"/>
            <Run Text="{Binding Type, Mode=OneTime, StringFormat={}({0}), Converter={StaticResource EnumToDescriptionConverter}}"/>
        </TextBlock>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Style="{StaticResource titleTextBlock}" Text="Attach Scheme"/>
            <telerik:RadButton Click="BrowseScheme_OnClick" ToolTip="Attach Scheme" Margin="5,0" VerticalAlignment="Center">
                <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/folder_open16.png" Height="16"/>
            </telerik:RadButton>
            <telerik:RadButton Click="ScanScheme_OnClick" ToolTip="Scan Scheme" VerticalAlignment="Center">
                <userControls:AutoGreyableImage Source="/AutoDispatch;component/Resources/Scan-icon.png" Height="16"/>
            </telerik:RadButton>
        </StackPanel>
    </Grid>
</UserControl>
