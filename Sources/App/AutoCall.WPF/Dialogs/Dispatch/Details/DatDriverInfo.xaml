<UserControl x:Class="AutoCall.WPF.Dialogs.Dispatch.UserControls.DatDriverInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:userControls="clr-namespace:AutoCall.WPF.Dialogs.Dispatch.UserControls" 
             xmlns:converters="clr-namespace:AutoCall.WPF.Converters" xmlns:usercontrols="clr-namespace:AutoCall.WPF.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <Style x:Key="valueTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Margin" Value="5,2,5,3"/>
        </Style>
        <Style x:Key="titleTextBlock2" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource titleTextBlock}">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="5,2,5,3"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="TextBlockValueStyle1" BasedOn="{StaticResource TextBlockValueStyle}">
            <Setter Property="Margin" Value="5,2,5,3"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource fieldTextBox}"/>
        <converters:CompareToVisibilityConverter x:Key="CompareToVisibilityConverter"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <converters:StringToFlowDocumentConverter x:Key="StringToFlowDocumentConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockValueStyle1}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="2"/>
            </Style>
        </Grid.Resources>
        <!--Loading control-->
        <usercontrols:LoadingControl x:Name="loading" Grid.ColumnSpan="10" Grid.RowSpan="10" Panel.ZIndex="100" Visibility="Collapsed" />
        
        <TextBlock Grid.Column="0" Grid.Row="0" Text="Driver" Style="{StaticResource titleTextBlock2}"/>
        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Name, Mode=OneWay}" Style="{StaticResource TextBlockValueStyle1}"/>
        <TextBlock Grid.Column="0" Grid.Row="1" Text="Phone" Style="{StaticResource titleTextBlock2}"/>
        <userControls:PhoneLinkTextBlock Grid.Column="1" Grid.Row="1" DataContext="{Binding ContactPhoneToString, Mode=OneWay}" Style="{StaticResource TextBlockValueStyle1}"/>
        <TextBlock Grid.Column="2" Grid.Row="0" Text="Truck" Style="{StaticResource titleTextBlock2}"/>
        <TextBlock Grid.Column="3" Grid.Row="0" Text="{Binding TruckNumber, Mode=OneWay}" Style="{StaticResource TextBlockValueStyle1}"/>
        <TextBlock Grid.Column="2" Grid.Row="1" Text="Trailer" Style="{StaticResource titleTextBlock2}"/>
        <TextBlock Grid.Column="3" Grid.Row="1" Text="{Binding TrailerNumber, Mode=OneWay}" Style="{StaticResource TextBlockValueStyle1}"/>
        <StackPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal">
            <TextBlock Text="Location" Style="{StaticResource titleTextBlock2}"/>
            <TextBlock Text="{Binding CurrentLocation.FormattedAddress}" Style="{StaticResource TextBlockValueStyle1}"/>
        </StackPanel>
        <!-- Comments -->
        <FlowDocumentScrollViewer Grid.Row="3" Grid.ColumnSpan="4"
            Margin="5"
            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
            Visibility="{Binding Comments, Converter={StaticResource NotNullToVisibilityConverter}}"
            Document="{Binding Comments, Converter={StaticResource StringToFlowDocumentConverter}, Mode=OneWay}"/>
        <!-- CarrierView Pickup Comment -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="2"
            Visibility="{Binding CarrierViewId, Converter={StaticResource NotNullToVisibilityConverter}}">
            <!--<Image Source="/AutoDispatch;component/Resources/carrierview.png" Height="16" Width="16"/>-->
            <TextBlock TextWrapping="WrapWithOverflow">
                <Run Text="CV Pickup Comment" Foreground="Gray" FontWeight="Normal"/>
                <Run Text="{Binding CarrierViewPickupComment, Mode=OneWay}"/>
                <Hyperlink FontWeight="Normal" Click="EditCarrierViewPickupComment_Click">Edit</Hyperlink>
            </TextBlock>
        </StackPanel>
        <!-- CarrierView Delivery Comment -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="2"
            Visibility="{Binding CarrierViewId, Converter={StaticResource NotNullToVisibilityConverter}}">
            <!--<Image Source="/AutoDispatch;component/Resources/carrierview.png" Height="16" Width="16"/>-->
            <TextBlock TextWrapping="WrapWithOverflow">
                <Run Text="CV Delivery Comment" Foreground="Gray" FontWeight="Normal"/>
                <Run Text="{Binding CarrierViewDeliveryComment, Mode=OneWay}"/>
                <Hyperlink FontWeight="Normal" Click="EditCarrierViewDeliveryComment_Click">Edit</Hyperlink>
            </TextBlock>
        </StackPanel>
        <!--Error message-->
        <TextBlock x:Name="tbError" Grid.Row="6" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="5" Foreground="Red" MaxHeight="80" HorizontalAlignment="Right" Visibility="Collapsed" />
    </Grid>
</UserControl>
