<dialogs:BaseDispatchDialog 
    x:Class="AutoCall.WPF.Dialogs.Dispatch.TrailerLayoutEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="clr-namespace:AutoCall.WPF.Dialogs"
    xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
    xmlns:userControls="clr-namespace:AutoCall.WPF.Dialogs.Dispatch.UserControls"
    xmlns:core="clr-namespace:AutoCall.WPF.Core"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    Title="Edit layout" Width="600" Height="750"
    Icon="/AutoDispatch;component/Resources/icon.ico" 
    WindowStartupLocation="CenterScreen"
    Loaded="EditBookLoadDialog_OnLoaded"
    Background="{x:Static SystemColors.ControlBrush}">
    <dialogs:BaseDispatchDialog.Resources>
        <converters:ColorToSolidColorBrushValueConverter x:Key="ColorToSolidColorBrushValueConverter"/>
        <core:BindingProxy x:Key="proxy1" Data="{Binding}"/>
        <system:Boolean x:Key="True">True</system:Boolean>
    </dialogs:BaseDispatchDialog.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <userControls:TrailerInfo Grid.Row="0" Grid.Column="1" Margin="5" HorizontalAlignment="Center" DataContext="{Binding Trailer}"/>
        <!-- free pallets -->
        <ItemsControl Grid.Row="1" Grid.Column="0" Margin="10,5,5,5" ItemsSource="{Binding TempPallets}" VerticalAlignment="Stretch" 
            Drop="freeList_Drop" Background="DarkGray" AllowDrop="True" >
            <ItemsControl.Template>
                <ControlTemplate>
                    <ScrollViewer x:Name="ScrollViewer" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <!-- TODO CHECK AddItem_MouseLeftButtonDown -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel SnapsToDevicePixels="True"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="{Binding Data.Trailer.Width, Source={StaticResource proxy1}, Mode=OneWay}" 
                        Height="{Binding Data.Trailer.Height, Source={StaticResource proxy1}, Mode=OneWay}" 
                        Cursor="Hand" BorderBrush="Black" BorderThickness="1" Margin="2"
                        Background="{Binding Load.Background, Converter={StaticResource ColorToSolidColorBrushValueConverter}}" 
                        MouseLeftButtonDown="MoveItem_MouseLeftButtonDown">
                        <TextBlock Text="{Binding Load.IndexString}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <!--<Rectangle StrokeThickness="1" Width="40" Height="40" Margin="2"
                        Fill="{Binding Load.Background, Converter={StaticResource ColorToSolidColorBrushValueConverter}}" Stroke="Black"/>-->
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Trailer cells -->
        <userControls:TrailerLayout Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" DataContext="{Binding Trailer}" 
            AllowDrag="{StaticResource True}" AllowReorder="True"
            Drop="Trailer_OnDrop" Margin="5,5,10,5"/>
        
        <!-- New pallet -->
        <ItemsControl Grid.Row="2" Grid.Column="0" Margin="10,5,40,5" ItemsSource="{Binding AddPallets}" VerticalAlignment="Bottom" 
            Drop="freeList_Drop" AllowDrop="False" >
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel SnapsToDevicePixels="True"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="{Binding Data.Trailer.Width, Source={StaticResource proxy1}, Mode=OneWay}" 
                        Height="{Binding Data.Trailer.Height, Source={StaticResource proxy1}, Mode=OneWay}" 
                        Cursor="Hand" BorderBrush="Black" BorderThickness="1" Margin="2"
                        Background="{Binding Load.Background, Converter={StaticResource ColorToSolidColorBrushValueConverter}}" 
                        MouseLeftButtonDown="AddItem_MouseLeftButtonDown">
                        <TextBlock Text="+" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Recycle -->
        <Image Source="/AutoDispatch;component/Resources/trash.png" Grid.Row="2" Grid.Column="0" Margin="10" Stretch="None"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" AllowDrop="true" Drop="RemoveLoad_OnDrop" />

        <!--Error message-->
        <TextBlock x:Name="tbError" Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="0" TextWrapping="Wrap" Foreground="Red" HorizontalAlignment="Right" Visibility="Hidden" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar" Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="0" Margin="5" IsIndeterminate="True" Visibility="Hidden" />

        <Button x:Name="btnOk" Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="0" HorizontalAlignment="Left" Click="btnOk_Clicked" Width="100" Margin="5">OK</Button>
        <Button x:Name="btnClose" Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Right" Click="btnClose_Clicked" IsCancel="True" Width="100" Margin="5">Close</Button>
    </Grid>
</dialogs:BaseDispatchDialog>
