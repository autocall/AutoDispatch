<dialogs:SingleInstanceWindow x:Class="AutoCall.WPF.Dialogs.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:AutoCall.WPF.Helpers"
        xmlns:c="clr-namespace:AutoCall.WPF.Converters"
        xmlns:dialogs="clr-namespace:AutoCall.WPF.Dialogs"
        xmlns:autoCall="clr-namespace:AutoCall.WPF.Converters.AutoCall"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="Login" Width="300" SizeToContent="Height"
        Background="{x:Static SystemColors.ControlBrush}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        Icon="/AutoDispatch;component/Resources/icon.ico">
    <Window.Resources>
        <!--Converters-->
        <autoCall:LoginDialog_LoginStateToBooleanConverter x:Key="LoginStateToBooleanConverter" />
        <autoCall:LoginDialog_LoginStateToVisibilityConverter x:Key="LoginStateToVisibilityConverter" Inverted="False" />
        <autoCall:LoginDialog_LoginStateToVisibilityConverter x:Key="InvertedLoginStateToVisibilityConverter" Inverted="True" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" Name="errGridRow" MinHeight="30" MaxHeight="120"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Logotype -->
        <Image
            Grid.ColumnSpan="4"
            Margin="10" Source="/AutoDispatch;component/Resources/app_logo.png" />
        <!-- Forgot password -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="4"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5">
            <Hyperlink Click="ForgotPasswordOnClick">Forgot password</Hyperlink>
        </TextBlock>
        <!-- Text labels -->
        <TextBlock
            Grid.Row="1"
            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5">User name</TextBlock>
        <TextBlock
            Grid.Row="2"
            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5">Password</TextBlock>
        <!--User name-->
        <TextBox x:Name="tbUserName"
                 Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                 Margin="5" Padding="5" Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 IsEnabled="{Binding State, Converter={StaticResource LoginStateToBooleanConverter}}" />
        <!--User password-->
        <PasswordBox x:Name="tbPassword"
                     Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                     Margin="5" Padding="5" h:PasswordHelper.Attach="True" 
                     h:PasswordHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding State, Converter={StaticResource LoginStateToBooleanConverter}}" />

        <!--Error message-->
        <TextBlock x:Name="tbError"
                   Grid.Row="4" Grid.ColumnSpan="4" TextWrapping="Wrap"
                   Margin="5" Foreground="Red" HorizontalAlignment="Right" Text="{Binding ErrorMessage}"
                   Visibility="{Binding State, Converter={StaticResource InvertedLoginStateToVisibilityConverter}}" />
        <!--Progress bar-->
        <telerik:RadProgressBar x:Name="progressBar"
                     Grid.Row="4" Grid.ColumnSpan="4" Margin="5,10" IsIndeterminate="True" MinHeight="10"
                     Visibility="{Binding State, Converter={StaticResource LoginStateToVisibilityConverter}}" />


        <!--Dialog buttons-->
        <Button x:Name="btnOK"
                Grid.Row="5" Grid.ColumnSpan="2"
                IsDefault="True" Width="100" HorizontalAlignment="Left" Margin="5" Click="OnOKButtonClicked"
                IsEnabled="{Binding State, Converter={StaticResource LoginStateToBooleanConverter}}">OK</Button>
        <Button x:Name="btnCancel"
                Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2"
                IsCancel="True" Width="100" HorizontalAlignment="Right" Margin="5" Click="OnCancelButtonClicked"
                IsEnabled="{Binding State, Converter={StaticResource LoginStateToBooleanConverter}}">Cancel</Button>
    </Grid>
</dialogs:SingleInstanceWindow>
