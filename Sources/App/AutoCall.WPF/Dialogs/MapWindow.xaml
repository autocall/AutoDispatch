<Window x:Class="AutoCall.WPF.Dialogs.MapWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Background="{x:Static SystemColors.ControlBrush}"
    WindowStartupLocation="CenterScreen"
    Icon="/AutoDispatch;component/Resources/icon.ico"
    Title="Map" Width="1100" Height="750" MinWidth="600" MinHeight="400">
    <DockPanel>
        <!-- Кнопки в WPF, а не на странице: работают и когда страница не загрузилась -->
        <Grid DockPanel.Dock="Top" Margin="5,5,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="tbUrl" Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center" Padding="3" Margin="0,0,5,0"/>
            <TextBlock x:Name="tbStatus" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="Gray" Visibility="Collapsed"/>
            <Button Grid.Column="2" Click="CopyLink_Click" MinWidth="100" Padding="8,3" Margin="0,0,5,0" ToolTip="Copy the map link to the clipboard">Copy link</Button>
            <Button Grid.Column="3" Click="OpenInBrowser_Click" MinWidth="100" Padding="8,3" ToolTip="Open the map in the system browser (you must be logged in there)">Open in browser</Button>
        </Grid>
        <wv2:WebView2 x:Name="webView" Margin="5"/>
    </DockPanel>
</Window>
