<Window x:Class="AutoCall.WPF.Dialogs.NewVersionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="620" SizeToContent="Height"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
    Title="AutoCall V2 is available"
    Background="{x:Static SystemColors.ControlBrush}"
    Icon="/AutoDispatch;component/Resources/icon.ico">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- 0 заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- 1 ссылки -->
            <RowDefinition Height="Auto"/>
            <!-- 2 инструкция -->
            <RowDefinition Height="Auto"/>
            <!-- 3 кнопка -->
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                Text="A new version is available — AutoCall V2"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                <Bold>AutoCall V2 supports both the new DAT REST API and the current DAT Power (SOAP) connection.</Bold>
                <Run Text="You can install it today and keep working with your existing DAT credentials, then switch to the REST API once your Service Account is ready. Download it here:"/>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Margin="0,2">
                <Hyperlink NavigateUri="https://v3.myautocall.net/Download/setup.exe"
                    RequestNavigate="OnLinkNavigate">https://v3.myautocall.net/Download/setup.exe</Hyperlink>
                <Run Foreground="Gray" Text=" — installer"/>
            </TextBlock>
            <TextBlock Margin="0,2">
                <Hyperlink NavigateUri="https://v3.myautocall.net/Download/AutoCall.application"
                    RequestNavigate="OnLinkNavigate">https://v3.myautocall.net/Download/AutoCall.application</Hyperlink>
                <Run Foreground="Gray" Text=" — ClickOnce, updates itself"/>
            </TextBlock>
        </StackPanel>

        <!-- Инструкцию читают и пересылают, поэтому текст выделяется и копируется:
             TextBlock этого не умеет, а read-only документ умеет — вместе со ссылками -->
        <Border Grid.Row="2" Margin="0,15,0,0" Padding="10" Background="White"
            BorderBrush="#FFC0C0C0" BorderThickness="1">
            <FlowDocumentScrollViewer x:Name="docInstructions"
                IsSelectionEnabled="True" Padding="0" Background="Transparent"
                MaxHeight="440" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Hyperlink.RequestNavigate="OnLinkNavigate">
                <!-- Правым кликом пользуются чаще, чем Ctrl+C: пункты меню должны быть -->
                <FlowDocumentScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="ApplicationCommands.Copy"/>
                        <MenuItem Command="ApplicationCommands.SelectAll"/>
                    </ContextMenu>
                </FlowDocumentScrollViewer.ContextMenu>
                <!-- FlowDocument берёт свой шрифт, а не тот, которым нарисовано остальное окно,
                     поэтому задаём системный явно: иначе инструкция выглядит чужой -->
                <FlowDocument PagePadding="0" TextAlignment="Left"
                    FontFamily="{x:Static SystemFonts.MessageFontFamily}"
                    FontSize="{x:Static SystemFonts.MessageFontSize}">
                    <Paragraph Margin="0">
                        <Run Text="To connect your DAT account to AutoCall V2, DAT requires a dedicated Service Account with separate credentials. Please follow these steps:"/>
                    </Paragraph>

                    <Paragraph Margin="0,10,0,2" FontWeight="Bold">
                        <Run Text="1. Create a Service Account email address"/>
                    </Paragraph>
                    <Paragraph Margin="12,0,0,0">
                        <Run Text="Choose an email address that is not currently associated with an existing DAT user, for example datserviceaccount@yourcompany.com. A general or group email address also works, as long as it is not already registered as a DAT user."/>
                    </Paragraph>

                    <Paragraph Margin="0,10,0,2" FontWeight="Bold">
                        <Run Text="2. Request the Service Account from DAT"/>
                    </Paragraph>
                    <Paragraph Margin="12,0,0,0">
                        <Run Text="Email"/>
                        <Hyperlink NavigateUri="mailto:techsupportteamleads@dat.com">techsupportteamleads@dat.com</Hyperlink>
                        <Run Text="and request a Service Account for the REST API integration. Please include:"/>
                    </Paragraph>
                    <List Margin="30,4,0,0" Padding="0" MarkerStyle="Disc">
                        <ListItem><Paragraph Margin="0"><Run Text="Company name"/></Paragraph></ListItem>
                        <ListItem><Paragraph Margin="0"><Run Text="Main contact name and phone number"/></Paragraph></ListItem>
                        <ListItem><Paragraph Margin="0"><Run Text="MC/DOT number or company address"/></Paragraph></ListItem>
                        <ListItem><Paragraph Margin="0"><Run Text="Integration Service: REST API"/></Paragraph></ListItem>
                        <ListItem><Paragraph Margin="0"><Run Text="Service Account email address"/></Paragraph></ListItem>
                    </List>

                    <Paragraph Margin="0,10,0,2" FontWeight="Bold">
                        <Run Text="3. Receive your new credentials"/>
                    </Paragraph>
                    <Paragraph Margin="12,0,0,0">
                        <Run Text="DAT Support will create the Service Account under your existing DAT account and provide the credentials and setup instructions."/>
                    </Paragraph>

                    <Paragraph Margin="0,10,0,2" FontWeight="Bold">
                        <Run Text="4. Enter the new credentials in AutoCall V2"/>
                    </Paragraph>
                    <Paragraph Margin="12,0,0,0">
                        <Run Text="Once DAT has activated your Service Account, use those credentials in AutoCall V2 rather than your regular DAT username and password."/>
                    </Paragraph>

                    <Paragraph Margin="0,14,0,0">
                        <Run Text="If you do not currently have a DAT account, please contact"/>
                        <Hyperlink NavigateUri="mailto:inquiries@dat.com">inquiries@dat.com</Hyperlink>
                        <Run Text="first to establish an account. If you have any questions during the setup process, please let us know and we will be happy to assist."/>
                    </Paragraph>
                </FlowDocument>
            </FlowDocumentScrollViewer>
        </Border>

        <Button x:Name="btnClose" Grid.Row="3" Width="100" Height="26"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            IsDefault="True" IsCancel="True" Click="OnCloseClicked">Close</Button>
    </Grid>
</Window>
