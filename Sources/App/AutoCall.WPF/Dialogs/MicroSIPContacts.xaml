<Window x:Class="AutoCall.WPF.Dialogs.MicroSIPContacts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:c="clr-namespace:AutoCall.WPF.Converters"
        mc:Ignorable="d" 
        Background="{x:Static SystemColors.ControlBrush}"
        Height="300" Width="500" 
        d:DesignHeight="450" d:DesignWidth="800"
        Title="Contacts"
        Loaded="Window_Loaded">
    <Window.Resources>
        <c:EnumToKeyValuesConverter x:Key="EnumToKeyValuesConverter" />
        <c:BooleanToBrushConverter x:Key="BooleanToBrushConverter" FalseBrush="DarkGray"  TrueBrush="Red"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource titleTextBlock}" HorizontalAlignment="Left" />
            <TextBlock Grid.Column="2" Text="Number" Style="{StaticResource titleTextBlock}" HorizontalAlignment="Left" />
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Contacts}"  HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Index}" Style="{StaticResource fieldTextBlock}" Margin="5" />
                        <TextBox Grid.Column="1" Text="{Binding Name}" Style="{StaticResource fieldTextBox}" BorderBrush="{Binding HasErrorName, Converter={StaticResource BooleanToBrushConverter}}" />
                        <TextBox Grid.Column="2" Text="{Binding Number}" Style="{StaticResource fieldTextBox}" BorderBrush="{Binding HasErrorNumber, Converter={StaticResource BooleanToBrushConverter}}"  />
                        <Button Grid.Column="3" Margin="5" Padding="5" Click="btnRemove_Clicked">
                            <Image Source="/AutoDispatch;component/Resources/small_delete.png" Height="16" Width="16"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Width="70" Content="Add" Click="btnAdd_OnClicked"/>

        <Button x:Name="btnOk" Grid.Row="3" Style="{StaticResource OkButtonStyle}" Click="btnOk_Clicked">OK</Button>
        <Button x:Name="btnClose" Grid.Row="3" Style="{StaticResource CloseButtonStyle}" Click="btnClose_Clicked">Close</Button>
    </Grid>
</Window>
