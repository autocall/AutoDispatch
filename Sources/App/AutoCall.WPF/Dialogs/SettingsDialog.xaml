<Window x:Class="AutoCall.WPF.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AutoCall.WPF.Converters"
        xmlns:enums="clr-namespace:AutoCall.Logic.Enums;assembly=AutoDispatch.Logic.Contracts"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:toUri="clr-namespace:AutoCall.WPF.Converters.ToUri"
        xmlns:autoCall="clr-namespace:AutoCall.WPF.Converters.AutoCall"
        xmlns:h="clr-namespace:AutoCall.WPF.Helpers"
        Title="Settings" Icon="/AutoDispatch;component/Resources/icon.ico" 
        WindowStartupLocation="CenterScreen"
        Width="310" SizeToContent="Height"
        Background="{x:Static SystemColors.ControlBrush}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <converters:FullPathToFileNameConverter x:Key="FullPathToFileNameConverter"/>
        <converters:CompareConverter x:Key="InvertedCompareConverter" Inverted="True"/>
        <converters:CompareConverter x:Key="CompareConverter"/>
        <converters:CompareToVisibilityConverter x:Key="CompareToVisibilityConverter"/>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
        <toUri:CallServiceTypeToUriConverter x:Key="CallServiceTypeToUriConverter"/>
        <!-- вкладка Hotkeys — модуль AutoCall, не перенесена -->
        <!--        <converters:StringToGlobalHotKeyMultiConverter x:Key="StringToGlobalHotKeyMultiConverter"/>
        -->
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <TabControl Background="{x:Static SystemColors.ControlBrush}" SelectedIndex="0">
            <!-- Sound и Hotkeys — настройки модуля AutoCall (уведомления DAT, хоткеи звонков), не перенесены; только Call Services (AI/wiki/plan.md «Софтфоны в App») -->
            <!--            <TabItem Header="Sound" DataContext="{Binding SettingsSoundViewModel}">
                <ListBox Name="soundListBox" 
                    ItemsSource="{Binding Sounds}" 
                    SelectedItem="{Binding SelectedSound}"
                    Background="{x:Static SystemColors.ControlBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <Button Height="24" Width="24" Click="PlayClicked">
                                    <Image Source="../Resources/start.png"></Image>
                                </Button>
                                <RadioButton Content="{Binding Converter={StaticResource FullPathToFileNameConverter}}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" Margin="4,0,4,0" >
                                    <RadioButton.IsChecked>
                                        <Binding Path="IsSelected"
                                                 RelativeSource="{RelativeSource AncestorType=ListBoxItem}"
                                                 Mode="TwoWay" />
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            -->
            <TabItem Header="Call Services" DataContext="{Binding SettingsCallServiceViewModel}">
                <StackPanel>
                    <ListBox Name="callServicesListBox" 
                        ItemsSource="{Binding CallServices}" 
                        SelectedItem="{Binding SelectedCallService}"
                        Background="{x:Static SystemColors.ControlBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <RadioButton Focusable="False" IsHitTestVisible="False" VerticalContentAlignment="Center" Margin="4,0,4,0" >
                                        <RadioButton.IsChecked>
                                            <Binding Path="IsSelected"
                                                RelativeSource="{RelativeSource AncestorType=ListBoxItem}"
                                                Mode="TwoWay" />
                                        </RadioButton.IsChecked>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Converter={StaticResource CallServiceTypeToUriConverter}}" 
                                                Width="24" Height="24"/>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" 
                                                VerticalAlignment="Center" Margin="5"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Vodia (Chrome Extension) — устаревший тип V1, в перечне софтфонов V3 нет -->
                    <!--                    <TextBlock Style="{StaticResource fieldTextBlock}" Margin="5" Foreground="Black" Background="Yellow" TextWrapping="Wrap"
                        Visibility="{Binding SelectedCallService, Converter={StaticResource CompareToVisibilityConverter}, ConverterParameter={x:Static enums:CallServiceType.Vodia}, Mode=OneWay}">
                        !To show the telephony window on dialing, keep one open tab 'User Portal' in Chrome
                    </TextBlock>
                    -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid Visibility="{Binding SelectedCallService, Converter={StaticResource CompareToVisibilityConverter}, ConverterParameter={x:Static enums:CallServiceType.MicroSIP}, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="SIP User ID" Style="{StaticResource titleTextBlock}"/>
                            <TextBox Name="SipLoginTb" Grid.Row="0" Grid.Column="1" Text="{Binding MicroSIPLogin, Mode=TwoWay}" Style="{StaticResource fieldTextBox}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="SIP Password" Style="{StaticResource titleTextBlock}"/>
                            <PasswordBox Name="SipPasswordTb" Grid.Row="1" Grid.Column="1" h:PasswordHelper.Attach="True" h:PasswordHelper.Password="{Binding MicroSIPPassword, Mode=TwoWay}" Style="{StaticResource fieldPasswordBox}"/>
                            <Button Grid.Row="2" Grid.Column="1" Click="BtnShortcuts_OnClick" Margin="0,5,5,5" Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/AutoDispatch;component/Resources/link.png" Height="24" Width="24" Margin="0,0,3,0"/>
                                    <TextBlock VerticalAlignment="Center" Margin="3">Shortcuts</TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="3" Grid.Column="1" Click="BtnContacts_OnClick" Margin="0,5,5,5" Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/AutoDispatch;component/Resources/user_group.png" Height="24" Width="24" Margin="0,0,3,0"/>
                                    <TextBlock VerticalAlignment="Center" Margin="3">Contacts</TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Visibility="{Binding SelectedCallService, Converter={StaticResource CompareToVisibilityConverter}, ConverterParameter={x:Static enums:CallServiceType.AbtoPhone}, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="SIP User ID" Style="{StaticResource titleTextBlock}"/>
                            <TextBox IsEnabled="False" Grid.Row="0" Grid.Column="1" Text="{Binding MicroSIPLogin, Mode=TwoWay}" Style="{StaticResource fieldTextBox}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="SIP Password" Style="{StaticResource titleTextBlock}"/>
                            <PasswordBox IsEnabled="False" Grid.Row="1" Grid.Column="1" h:PasswordHelper.Attach="True" h:PasswordHelper.Password="{Binding MicroSIPPassword, Mode=TwoWay}" Style="{StaticResource fieldPasswordBox}"/>
                            <Button Grid.Row="3" Grid.Column="1" Click="BtnShortcuts_OnClick" Margin="0,5,5,5" Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/AutoDispatch;component/Resources/link.png" Height="24" Width="24" Margin="0,0,3,0"/>
                                    <TextBlock VerticalAlignment="Center" Margin="3">Shortcuts</TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="4" Grid.Column="1" Click="BtnContacts_OnClick" Margin="0,5,5,5" Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/AutoDispatch;component/Resources/user_group.png" Height="24" Width="24" Margin="0,0,3,0"/>
                                    <TextBlock VerticalAlignment="Center" Margin="3">Contacts</TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <TextBlock Text="Call Type:" Margin="5" VerticalAlignment="Center"/>
                            <Button Grid.Row="1" Margin="5" Padding="5" Width="70" Click="CallType_OnClick" HorizontalAlignment="Left"
                                Content="{Binding CallType, Converter={StaticResource EnumToDescriptionConverter}}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                            <TextBlock Text="Maximum telephone lines:" Margin="5" VerticalAlignment="Center"/>
                            <!-- V1: xctk:ByteUpDown (Extended WPF Toolkit) -->
                            <telerik:RadNumericUpDown Value="{Binding MaxPhoneLines}" IsInteger="True" Width="70" Minimum="2" Maximum="4"
                                IsEnabled="{Binding CallType, Converter={StaticResource InvertedCompareConverter}, ConverterParameter={x:Static enums:CallType.SingleCall}}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" Name="spDialCode">
                            <CheckBox IsChecked="{Binding DialCountryCode}" Margin="5" VerticalAlignment="Center" Content="Dial country code 1" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource ResourceKey=TextBlockValueStyle}" Margin="5">
                        <Run>Test call: </Run>
                        <Hyperlink Click="Call_Click">
                            <Run Text="{Binding TestPhoneNumber, Mode=OneTime}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </TabItem>
            <!--            <TabItem Header="Hotkeys" DataContext="{Binding SettingsHotKeyViewModel}">
                <ItemsControl Name="HotKeysListBox" ItemsSource="{Binding HotKeys}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Text="{Binding Action, Converter={StaticResource EnumToDescriptionConverter}, Mode=OneTime}"/>
                                <wpf4_hot_keys:HotKeyControl DataContext="{Binding HotKey}" Grid.Column="1" Height="26" Margin="5" Name="hotKeyControl" Width="156" ToolTip="HotKeyControl in .Net 4.0" >
                                    <wpf4_hot_keys:HotKeyControl.Text>
                                        <MultiBinding Converter="{StaticResource StringToGlobalHotKeyMultiConverter}" Mode="TwoWay">
                                            <Binding Path="Modifier"/>
                                            <Binding Path="Key"/>
                                        </MultiBinding>
                                    </wpf4_hot_keys:HotKeyControl.Text>
                                </wpf4_hot_keys:HotKeyControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </TabItem>
            -->
        </TabControl>
        <!--Dialog buttons-->
        <Button x:Name="btnOK" Grid.Row="20" Grid.ColumnSpan="4" Style="{StaticResource OkButtonStyle}" Click="BtnOk_OnClick">OK</Button>
        <Button x:Name="btnCancel" Grid.Row="20" Grid.ColumnSpan="4" Style="{StaticResource CancelButtonStyle}" Click="BtnCancel_OnClick">Cancel</Button>
    </Grid>
</Window>
