@model CallReportIndexViewModel
@{
    ViewData["Title"] = "Call Report";
    var filter = Model.Filter;
    var data = Model.Data;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    var day = filter.Day.ToString("yyyy-MM-dd", invariant);
}

@* hx-boost: фильтры меняют только #call-report, адрес обновляется; календарь и селекты отправляют форму *@
<div id="call-report" hx-boost="true" hx-select="#call-report" hx-target="#call-report" hx-swap="outerHTML">

<div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold">Call Report</h1>
    @* <span class="text-sm opacity-60">calls via trunk, PBX time</span> *@
</div>

<div class="card bg-base-100 shadow-sm p-3 mb-4">
    @* одна строка: день, Only out, Company *@
    <form method="get" action="/CallReport" class="flex flex-row flex-wrap items-end gap-2" data-controller="calendar">
        <input type="hidden" name="Date" value="@day" data-calendar-target="input" />
        @* календарь Cally как на Logs и Metrics; дата — день CDR-файла PBX *@
        <button type="button" popovertarget="call-report-calendar" class="input input-sm w-auto cursor-pointer"
                style="anchor-name: --call-report-calendar">
            <svg class="size-4 opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
            <span class="label">Day</span>
            <span class="whitespace-nowrap">@filter.Day.ToString("ddd MM/dd", invariant)</span>
            <svg class="size-3 opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
            </svg>
        </button>
        <div popover id="call-report-calendar" class="dropdown bg-base-100 rounded-box shadow-lg" style="position-anchor: --call-report-calendar"
             data-calendar-target="popover">
            <calendar-date class="cally" data-action="change->calendar#select"
                           max="@DateTime.Now.Date.ToString("yyyy-MM-dd", invariant)" value="@day">
                <svg aria-label="Previous" class="fill-current size-4" slot="previous" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M15.75 19.5 8.25 12l7.5-7.5"></path>
                </svg>
                <svg aria-label="Next" class="fill-current size-4" slot="next" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
                </svg>
                <calendar-month></calendar-month>
            </calendar-date>
        </div>
        <label class="form-control">
            <span class="label-text text-xs">Company</span>
            <select name="CompanyId" class="select select-bordered select-sm w-56" onchange="this.form.requestSubmit()">
                <option value="">All</option>
                @foreach (var company in data.Companies) {
                    <option value="@company.Id" selected="@(filter.CompanyId == company.Id)">@company.Name</option>
                }
            </select>
        </label>
        <label class="label h-8 cursor-pointer text-sm">
            <input type="checkbox" name="OnlyOut" value="true" class="checkbox checkbox-sm" checked="@filter.OnlyOut"
                   onchange="this.form.requestSubmit()" />
            Only out
        </label>
    </form>
</div>

@if (data.Error != null) {
    <div role="alert" class="alert alert-error alert-soft mb-4">Call log is not available: @data.Error</div>
}

<div class="table-box bg-base-100">
    <table class="table table-sm">
        <thead>
            <tr><th>User</th>@* <th>Extension</th> *@<th>Company</th><th class="text-right">Duration</th><th class="text-right">Calls</th></tr>
        </thead>
        <tbody>
        @foreach (var row in data.Rows) {
            <tr>
                <td>@row.UserName</td>
                @* <td class="text-base-content/70">@row.SipLogin</td> *@
                <td class="text-base-content/70">@row.CompanyName</td>
                <td class="text-right">@row.DurationText</td>
                <td class="text-right">@row.Calls</td>
            </tr>
        }
        @if (data.Rows.Count == 0) {
            <tr><td colspan="5" class="text-center opacity-60">Nothing here</td></tr>
        }
        </tbody>
    </table>
</div>

</div>
