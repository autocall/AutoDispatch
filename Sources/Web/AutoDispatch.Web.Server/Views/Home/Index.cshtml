@model AutoDispatch.Web.Logic.Dtos.Identity.IdentityDto
@{
    ViewData["Title"] = "Home";
}

<div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold">Home</h1>
</div>

@* Account — всем ролям *@
<div class="mt-4 grid items-start gap-4 lg:grid-cols-2">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-3">
            <h2 class="card-title">Account</h2>
            @* подписи — колонка по самой длинной, значения — остаток *@
            <div class="grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-2">
                <span class="opacity-60">User name</span>
                <span>@Model.UserName</span>
                <span class="opacity-60">Email</span>
                <span>@Model.Email</span>
                <span class="opacity-60">Password</span>
                <div class="flex items-center gap-3">
                    ••••••
                    <button class="btn btn-primary btn-xs" hx-get="/Account/ChangePassword" hx-target="#modal-content">Change password</button>
                </div>
            </div>
        </div>
    </div>
</div>
