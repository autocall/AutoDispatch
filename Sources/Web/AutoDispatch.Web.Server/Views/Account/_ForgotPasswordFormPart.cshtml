@model ForgotPasswordViewModel
@if (Model.Message != null) {
    <div class="flex flex-col gap-3">
        <div role="alert" class="alert alert-success text-sm">@Model.Message</div>
        <a class="link text-sm" href="/Account/LogIn">Back to log in</a>
    </div>
} else {
    <form method="post" asp-controller="Account" asp-action="ForgotPassword"
          hx-post="@Url.Action("ForgotPassword", "Account")" hx-target="this" hx-swap="outerHTML"
          data-controller="login" class="flex flex-col gap-3">
        @Html.AntiForgeryToken()
        @if (Model.Error != null) {
            <div role="alert" class="alert alert-error text-sm">@Model.Error</div>
        }
        <p class="text-sm opacity-70">Enter your email, we will send a link to reset the password.</p>
        <label class="form-control">
            <span class="label-text">Email</span>
            <input asp-for="Email" type="email" autocomplete="username" required class="input input-bordered w-full" autofocus />
            <span asp-validation-for="Email" class="text-error text-xs"></span>
        </label>
        <button type="submit" class="btn btn-primary" data-login-target="submit">Send link</button>
        <a class="link text-sm text-center" href="/Account/LogIn">Back to log in</a>
    </form>
}
