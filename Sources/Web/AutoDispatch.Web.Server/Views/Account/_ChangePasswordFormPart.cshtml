@model ChangePasswordViewModel
<form hx-post="@Url.Action("ChangePassword", "Account")" hx-target="this" hx-swap="outerHTML" hx-disabled-elt="find button[type=submit]"
      class="flex flex-col gap-3">
    @Html.AntiForgeryToken()
    <h3 class="text-lg font-semibold">Change password</h3>
    @if (Model.Message != null) {
        <div role="alert" class="alert alert-success alert-soft text-sm">@Model.Message</div>
        <div class="modal-action">
            <button type="button" class="btn" data-action="modal#close">Close</button>
        </div>
    } else {
        <label class="form-control">
            <span class="label-text">Current password</span>
            <input asp-for="CurrentPassword" type="password" autocomplete="current-password" class="input input-bordered w-full" autofocus />
            <span asp-validation-for="CurrentPassword" class="text-error text-xs"></span>
        </label>
        <label class="form-control">
            <span class="label-text">New password</span>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" class="input input-bordered w-full" />
            <span asp-validation-for="NewPassword" class="text-error text-xs"></span>
        </label>
        <label class="form-control">
            <span class="label-text">Confirm password</span>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="input input-bordered w-full" />
            <span asp-validation-for="ConfirmPassword" class="text-error text-xs"></span>
        </label>
        @if (Model.Error != null) {
            <div role="alert" class="alert alert-error alert-soft text-sm">@Model.Error</div>
        }
        <div class="modal-action">
            <button type="button" class="btn" data-action="modal#close">Cancel</button>
            <button type="submit" class="btn btn-primary">Change password</button>
        </div>
    }
</form>
