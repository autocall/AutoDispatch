@model DispatchCompanyFormViewModel
@{
    ViewData["Title"] = Model.EntityId == Guid.Empty ? "New dispatch company" : $"Dispatch company MC# {Model.McNumber}";
}
<div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold">@ViewData["Title"]</h1>
    <div class="flex gap-2">
        @if (Model.EntityId != Guid.Empty) {
            <form hx-post="/Admin/DispatchCompanies/Delete/@Model.EntityId" hx-confirm="Are you sure want to delete company?">
                @Html.AntiForgeryToken()
                <button class="btn btn-ghost btn-sm text-error">Delete</button>
            </form>
        }
        <a class="btn btn-ghost btn-sm" href="/Admin/DispatchCompanies">Back</a>
    </div>
</div>
<partial name="_DispatchCompanyFormPart" model="Model" />
