@using AutoDispatch.Web.Common.Extensions
@using AutoDispatch.Web.Logic.Dtos.App
@model MapSelectLocationViewModel
@{
    // Выбор места для App (V1 Dispatch/SelectLocation): как /Map — embedded для WebView2, _Layout для браузера
    Layout = Model.Embedded ? "_EmbeddedLayout" : "_Layout";
    ViewData["Title"] = "Select location";
    ViewData["Fullscreen"] = true;
    ViewData["Theme"] = Model.Settings.Theme switch { MapThemeEnum.Dark => "business", MapThemeEnum.Light => "corporate", _ => null };
}
<script>
    window.__mapReady = function () { document.dispatchEvent(new Event("map:ready")); };
</script>
<script src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapJsKey&language=en&loading=async&callback=__mapReady" async defer></script>

<div class="absolute inset-0"
     data-controller="select-location"
     data-select-location-token-value="@Model.Token"
     data-select-location-point-value="@JsonExtension.Serialize(Model.Point)"
     data-select-location-settings-value="@JsonExtension.Serialize(Model.Settings)"
     data-select-location-embedded-value="@Model.Embedded.ToString().ToLower()">
    <div class="absolute inset-0" data-select-location-target="map"></div>

    @* слева: выбранное место — то, что App читает из postMessage *@
    <div class="absolute top-3 left-3 z-10 card bg-base-100 shadow w-80">
        <div class="card-body p-3 gap-1 text-sm">
            <div class="flex items-center justify-between">
                <span class="font-semibold">Location</span>
                <span class="loading loading-spinner loading-xs hidden" data-select-location-target="busy"></span>
            </div>
            <div class="font-medium break-words" data-select-location-target="address">Not selected</div>
            <div class="opacity-70 text-xs" data-select-location-target="city"></div>
            <div class="opacity-70 text-xs" data-select-location-target="latlng"></div>
        </div>
    </div>

    @* сверху по центру: поиск адреса с подсказками, как на /Map *@
    <div class="absolute top-3 left-1/2 -translate-x-1/2 z-10 w-[420px] max-w-[calc(100vw-7rem)]">
        <label class="input input-sm w-full shadow flex items-center gap-2">
            <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g stroke-linejoin="round" stroke-linecap="round" stroke-width="2.5" fill="none" stroke="currentColor">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.3-4.3"></path>
                </g>
            </svg>
            <input type="text" class="grow" placeholder="Search address..." autocomplete="off" autofocus
                   data-select-location-target="search"
                   data-action="input->select-location#search keydown->select-location#searchKey blur->select-location#searchBlur" />
            <button type="button" class="btn btn-ghost btn-xs btn-circle hidden" title="Clear"
                    data-select-location-target="searchClear" data-action="select-location#searchClear">✕</button>
        </label>
        <ul class="menu menu-sm bg-base-100 rounded-box shadow mt-1 w-full hidden" data-select-location-target="suggestions"></ul>
    </div>

    <div class="absolute bottom-6 right-3 z-10 rounded-box bg-base-100 px-3 py-1.5 text-xs leading-snug shadow">
        click on the map to select a location
    </div>
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 alert alert-error py-2 text-sm hidden" data-select-location-target="error"></div>
</div>
