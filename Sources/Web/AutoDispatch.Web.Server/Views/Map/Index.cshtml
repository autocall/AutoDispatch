@using AutoDispatch.Web.Common.Extensions
@using AutoDispatch.Web.Logic.Dtos.App
@model MapIndexViewModel
@{
    // WebView2 App — своя страница без навигации (тема из настроек карты, не задана — системная); браузер — _Layout на всё окно, тема сайта
    Layout = Model.Embedded ? "_EmbeddedLayout" : "_Layout";
    ViewData["Title"] = "Map";
    ViewData["Fullscreen"] = true;
    ViewData["Theme"] = Model.Settings.Theme switch { MapThemeEnum.Dark => "business", MapThemeEnum.Light => "corporate", _ => null };
}
<script>
    window.__mapReady = function () { document.dispatchEvent(new Event("map:ready")); };
</script>
<script src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapJsKey&libraries=geometry&language=en&loading=async&callback=__mapReady" async defer></script>

<div class="absolute inset-0"
     data-controller="map"
     data-map-token-value="@Model.Token"
     data-map-points-value="@JsonExtension.Serialize(Model.Points)"
     data-map-stops-value="@JsonExtension.Serialize(Model.Stops)"
     data-map-settings-value="@JsonExtension.Serialize(Model.Settings)"
     data-map-aeris-id-value="@Model.AerisWeatherId"
     data-map-aeris-secret-value="@Model.AerisWeatherSecret"
     data-map-max-stops-value="@Model.MaxStops"
     data-map-embedded-value="@Model.Embedded.ToString().ToLower()">
    <div class="absolute inset-0" data-map-target="map"></div>

    @* слева: маршрут — расстояние, точки с адресами, остановки *@
    <div class="absolute top-3 left-3 z-10 flex flex-col items-start gap-2">
        <div class="flex gap-2">
            <button type="button" class="btn btn-sm btn-square bg-base-100 shadow" title="Route" data-action="map#togglePanel">
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z" /></svg>
            </button>
            <button type="button" class="btn btn-sm btn-square bg-base-100 shadow" title="Fit to map" data-action="map#fit">
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M3 3h6v2H5v4H3zm12 0h6v6h-2V5h-4zM3 15h2v4h4v2H3zm16 0h2v6h-6v-2h4z" /></svg>
            </button>
        </div>
        <div class="card bg-base-100 shadow w-80 max-h-[calc(100%-5rem)]" data-map-target="panel">
            <div class="card-body p-3 gap-2 text-sm overflow-y-auto">
                <div class="flex items-center justify-between">
                    <span class="font-semibold">Route</span>
                    <span class="flex items-center gap-2">
                        <span class="loading loading-spinner loading-xs hidden" data-map-target="busy"></span>
                        <span class="badge badge-info" data-map-target="distance">0 mi</span>
                    </span>
                </div>
                <ul class="flex flex-col" data-map-target="points"></ul>
            </div>
        </div>
    </div>

    @* сверху по центру: поиск адреса с подсказками *@
    <div class="absolute top-3 left-1/2 -translate-x-1/2 z-10 w-[420px] max-w-[calc(100vw-7rem)]">
        <label class="input input-sm w-full shadow flex items-center gap-2">
            @* иконка поиска из примера daisyUI "Text input with text label inside" *@
            <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g stroke-linejoin="round" stroke-linecap="round" stroke-width="2.5" fill="none" stroke="currentColor">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.3-4.3"></path>
                </g>
            </svg>
            <input type="text" class="grow" placeholder="Search address..." autocomplete="off"
                   data-map-target="search" data-action="input->map#search keydown->map#searchKey blur->map#searchBlur" />
            <button type="button" class="btn btn-ghost btn-xs btn-circle hidden" title="Clear" data-map-target="searchClear" data-action="map#searchClear">✕</button>
        </label>
        <ul class="menu menu-sm bg-base-100 rounded-box shadow mt-1 w-full hidden" data-map-target="suggestions"></ul>
    </div>

    @* справа сверху: слои и тема, как Map options в GpsV4 *@
    <div class="absolute top-3 right-3 z-10 flex flex-col items-end gap-2">
        <button type="button" class="btn btn-sm btn-square bg-base-100 shadow" title="Map options" data-action="map#toggleOptions">
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M12 2 1 8l11 6 11-6-11-6zm0 14.5L3.3 11.8 1 13l11 6 11-6-2.3-1.2L12 16.5z" /></svg>
        </button>
        <div class="card bg-base-100 shadow w-56 hidden" data-map-target="options">
            <div class="card-body p-3 gap-2 text-sm">
                <span class="font-semibold">Map type</span>
                <div class="flex justify-center gap-2">
                    <button type="button" class="flex flex-col items-center gap-1" data-action="map#setType" data-type="roadmap">
                        <img src="~/images/map/default.svg" class="w-24 rounded border-4 border-transparent" data-map-target="typeRoadmap" alt="" />
                        <span>Default</span>
                    </button>
                    <button type="button" class="flex flex-col items-center gap-1" data-action="map#setType" data-type="hybrid">
                        <img src="~/images/map/satellite.svg" class="w-24 rounded border-4 border-transparent" data-map-target="typeHybrid" alt="" />
                        <span>Satellite</span>
                    </button>
                </div>
                <div class="divider my-0 h-1"></div>
                <span class="font-semibold">Show on map</span>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" class="checkbox checkbox-sm" data-map-target="traffic" data-action="map#toggleTraffic" /> Traffic
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" class="checkbox checkbox-sm" data-map-target="weather" data-action="map#toggleWeather" /> Weather
                </label>
                @if (Model.Embedded) {
                    @* в браузере тема переключается в навигации сайта *@
                    <div class="divider my-0 h-1"></div>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" class="toggle toggle-sm" data-map-target="dark" data-action="map#toggleTheme" /> Dark theme
                    </label>
                }
            </div>
        </div>
    </div>

    <div class="absolute bottom-6 right-3 z-10 rounded-box bg-base-100 px-3 py-1.5 text-xs leading-snug shadow">
        click on the map to add a stop<br />click on the stop to remove it
    </div>
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 alert alert-error py-2 text-sm hidden" data-map-target="error"></div>
</div>
