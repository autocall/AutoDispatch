@using AutoDispatch.Web.Common.Extensions
@using AutoDispatch.Web.Logic.Dtos.App
@model MapOrderStopsViewModel
@{
    // Остановки трейлера для App (V1 Dispatch/OrderStops): как /Map — embedded для WebView2, _Layout для браузера
    Layout = Model.Embedded ? "_EmbeddedLayout" : "_Layout";
    ViewData["Title"] = "Order of stops";
    ViewData["Fullscreen"] = true;
    ViewData["Theme"] = Model.Settings.Theme switch { MapThemeEnum.Dark => "business", MapThemeEnum.Light => "corporate", _ => null };
}
<script>
    window.__mapReady = function () { document.dispatchEvent(new Event("map:ready")); };
</script>
<script src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapJsKey&libraries=geometry&language=en&loading=async&callback=__mapReady" async defer></script>

<div class="absolute inset-0"
     data-controller="order-stops"
     data-order-stops-token-value="@Model.Token"
     data-order-stops-stops-value="@JsonExtension.Serialize(Model.Stops)"
     data-order-stops-settings-value="@JsonExtension.Serialize(Model.Settings)"
     data-order-stops-max-stops-value="@Model.MaxStops"
     data-order-stops-embedded-value="@Model.Embedded.ToString().ToLower()">
    <div class="absolute inset-0" data-order-stops-target="map"></div>

    @* слева: остановки в текущем порядке и длина маршрута *@
    <div class="absolute top-3 left-3 z-10 flex flex-col items-start gap-2">
        <div class="flex gap-2">
            <button type="button" class="btn btn-sm btn-square bg-base-100 shadow" title="Stops" data-action="order-stops#togglePanel">
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z" /></svg>
            </button>
            <button type="button" class="btn btn-sm btn-square bg-base-100 shadow" title="Fit to map" data-action="order-stops#fit">
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M3 3h6v2H5v4H3zm12 0h6v6h-2V5h-4zM3 15h2v4h4v2H3zm16 0h2v6h-6v-2h4z" /></svg>
            </button>
        </div>
        <div class="card bg-base-100 shadow w-80 max-h-[calc(100%-5rem)]" data-order-stops-target="panel">
            <div class="card-body p-3 gap-2 text-sm overflow-y-auto">
                <div class="flex items-center justify-between">
                    <span class="font-semibold">Stops</span>
                    <span class="flex items-center gap-2">
                        <span class="loading loading-spinner loading-xs hidden" data-order-stops-target="busy"></span>
                        <span class="badge badge-info" data-order-stops-target="distance">0 mi</span>
                    </span>
                </div>
                <ul class="flex flex-col" data-order-stops-target="list"></ul>
            </div>
        </div>
    </div>

    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 alert alert-error py-2 text-sm hidden" data-order-stops-target="error"></div>
</div>
