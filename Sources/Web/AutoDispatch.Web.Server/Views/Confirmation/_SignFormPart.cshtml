@model ConfirmationViewModel
@* htmx-фрагмент: при ошибке сервер возвращает его же с текстом, при успехе — HX-Redirect на ту же страницу (уже Confirmed) *@
<form method="post" asp-controller="Confirmation" asp-action="Index"
      hx-post="/Confirmation" hx-target="this" hx-swap="outerHTML" hx-disabled-elt="find button"
      class="mx-auto flex w-full max-w-md flex-col gap-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="LoadId" />
    @if (Model.Error != null) {
        <div role="alert" class="alert alert-error text-sm">@Model.Error</div>
    }
    <input asp-for="Name" type="text" placeholder="Name" autocomplete="name" required minlength="4" maxlength="24"
           class="input input-bordered w-full text-center" autofocus />
    <span asp-validation-for="Name" class="text-error text-xs"></span>
    <button type="submit" class="btn btn-primary btn-lg">Sign Confirmation</button>
</form>
