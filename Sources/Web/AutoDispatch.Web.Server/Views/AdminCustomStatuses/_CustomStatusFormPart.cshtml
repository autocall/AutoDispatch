@model CustomStatusFormViewModel
@* форма V1 «Create a new Status / Edit Status»: Name *@
<form hx-post="/Admin/CustomStatuses/Save" hx-target="this" hx-swap="outerHTML" class="flex flex-col gap-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="EntityId" />
    <h3 class="text-lg font-semibold">@(Model.EntityId == Guid.Empty ? "Create a new Status" : "Edit Status")</h3>
    <label class="block">
        <span class="label-text block">Name</span>
        <input asp-for="Name" class="input input-bordered w-full" autofocus />
        <span asp-validation-for="Name" class="text-error text-xs"></span>
    </label>
    <div class="modal-action">
        <button type="button" class="btn" data-action="modal#close">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
